--  ตัวเฝ้าสวิตช์เล่น — หัวใจของการ AFK
--
--  หน้าที่สองอย่าง
--    1. สวิตช์ปิดอยู่แต่ตัวเล่นยังทำงาน → ไม่มี (stopPlaying จัดการแล้ว)
--    2. สวิตช์เปิดอยู่แต่ตัวเล่นหยุดไป → ลองเริ่มใหม่ให้เอง
--
--  ข้อ 2 คือสิ่งที่หายไปตลอด ตัวเล่นหยุดได้จากหลายสาเหตุที่แก้เองได้ในไม่กี่วินาที
--  เช่นยังไม่ได้เลือกมาโคร (รายชื่อยังโหลดไม่เสร็จ) หรือหลุดออกมาห้องเลือกด่าน
--  ของเดิมเจอแบบนี้แล้วปิดสวิตช์ทิ้ง แล้ว AFK ก็จบลงเงียบๆ ตรงนั้น
--
--  ลองใหม่ทุก 3 วินาที ไม่ถี่กว่านี้เพราะ startPlaying มีการเช็คโหลดเอาต์อยู่ข้างใน
task.spawn(function()
    while true do
        task.wait(3)

        if wantPlay and not playing then
            --  ต้องมีมาโครก่อน ไม่งั้นเรียกไปก็ได้แค่ข้อความเตือนเดิมซ้ำๆ
            if macro and #macro.actions > 0 then
                if startPlaying() then
                    vlog("เปิดตัวเล่นให้อัตโนมัติ (สวิตช์เปิดค้างไว้อยู่)")
                end
            else
                status = T("NEED_CMDS")
            end
        end

        --  สวิตช์แสดงผลให้ตรงกับความตั้งใจเสมอ
        --  ไม่ปิดตามตัวเล่นอีกแล้ว เพราะตัวเล่นหยุดชั่วคราวเป็นเรื่องปกติ
        if not wantPlay and playing then
            playing = false
        end
    end
end)

--  ป้ายบอกรุ่น — พิมพ์ทันทีที่โหลดเสร็จ ไม่ต้องกดอะไร
--
--  มีไว้ตอบคำถามเดียว: "ไฟล์ที่กำลังรันอยู่ มีโค้ดชุดใหม่หรือยัง"
--  ที่ผ่านมาเราเสียเวลาไล่บั๊กที่อาจไม่มีอยู่จริง เพราะแยกไม่ออกระหว่าง
--  "โค้ดผิด" กับ "โค้ดถูกแต่ยังไม่ได้เอาไปใช้" ซึ่งอาการเหมือนกันเป๊ะ
vlog("โหลดสคริปต์เสร็จ · รุ่นนี้มีระบบโหวตแมพและตัวเช็คชื่อด่านแล้ว")

status = inGame() and T("READY_IN") or T("READY_WAIT")
