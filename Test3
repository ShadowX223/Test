--  อ่านข้อมูลทาวเวอร์
-- ═══════════════════════════════════════════════════
local function rep(m) return m and m:FindFirstChild("TowerReplicator") end

local function isMine(m)
    local r = rep(m)
    return r ~= nil and r:GetAttribute("OwnerId") == LocalPlayer.UserId
end

--  ชื่อทาวเวอร์จริง เช่น Farm — ต่างจาก m.Name ที่เป็นชื่อสกิน (Xmas, Masquerade)
--  เคยมีแล้วแต่ถูกลบทิ้งตอนเขียนใหม่ ทั้งที่ยังมีที่เรียกใช้อยู่
local function tName(m)
    local r = rep(m)
    return r and r:GetAttribute("Name")
end

local function tPos(m)
    local r = rep(m)
    return r and r:GetAttribute("Position")
end

local function tSpent(m)
    local r = rep(m)
    return (r and r:GetAttribute("TotalSpent")) or 0
end

local function tLevel(m)
    local r = rep(m)
    return (r and r:GetAttribute("Upgrade")) or 0
end

local function tTargetMode(m)
    local r = rep(m)
    return r and r:GetAttribute("TargetingMode")
end

--  ระยะโจมตีจริงของทาวเวอร์ตัวนี้ ณ ตอนนี้
--
--  @Range เป็นแอตทริบิวต์สดบน TowerReplicator ที่เซิร์ฟเวอร์อัปเดตให้เอง
--  ตรงกับระดับปัจจุบันอยู่แล้ว ไม่ต้องไปคำนวณจากโมดูลเอง
--  (ยืนยันแล้ว: DJ Booth ขั้น 2 ได้ 15 · ขั้น 5 ได้ 18 ตรงกับตารางในโมดูลเป๊ะ)
--
--  @RangeBuff เป็นเปอร์เซ็นต์ ไม่ใช่จำนวนสตัด
--  หลักฐาน: Scout มี @Range 17.5 กับ @RangeBuff 12.5 ตอนมี DJ แทร็ก Purple อยู่ใกล้
--  และในโมดูลของ DJ เขียนไว้ว่า PurpleTrackBuffs.Range = 12.5
--  ถ้าเป็นสตัดจริง Scout จะยิงไกล 30 ซึ่งไกลเกินจริงไปมาก
local function tRange(m)
    local r = rep(m)
    if not r then return nil end
    local base = tonumber(r:GetAttribute("Range"))
    if not base or base <= 0 then return nil end
    local buff = tonumber(r:GetAttribute("RangeBuff")) or 0
    return base * (1 + buff / 100)
end

--  บอสที่ใกล้ทาวเวอร์ตัวนี้ที่สุด ห่างเท่าไหร่ (คืน nil ถ้าไม่มีบอสหรืออ่านไม่ได้)
--
--  วัดแบบราบ ตัดแกน Y ทิ้ง เพราะระยะของทาวเวอร์เป็นวงกลมบนพื้น ไม่ใช่ทรงกลม
--  บอสตัวสูงหรือตัวที่เดินบนสะพานจะได้ไม่ถูกนับว่าไกลกว่าความจริง
local function bossDistance(m)
    local r = rep(m)
    local tp = r and r:GetAttribute("Position")
    if typeof(tp) ~= "Vector3" then
        local ok, pv = pcall(function() return m:GetPivot().Position end)
        tp = ok and pv or nil
    end
    if typeof(tp) ~= "Vector3" then return nil end

    local best
    for _, bp in ipairs(bossPositions()) do
        local dx, dz = bp.X - tp.X, bp.Z - tp.Z
        local d = math.sqrt(dx * dx + dz * dz)
        if not best or d < best then best = d end
    end
    return best
end

--  บอสเข้าระยะของทาวเวอร์ตัวนี้แล้วหรือยัง
--  คืน nil = อ่านไม่ได้ (ไม่ใช่ "ยังไม่เข้า") ตัวเรียกจะได้แยกสองกรณีนี้ออกจากกัน
local function bossInRange(m)
    local rng = tRange(m)
    if not rng then return nil end
    local d = bossDistance(m)
    if not d then return nil end
    return d <= rng, d, rng
end

--  ราคาอัปเกรดขั้นถัดไปของทาวเวอร์ตัวนี้ อ่านสดจากโมดูลเกม
--
--  ดีกว่าราคาที่อัดไว้ทุกทาง เพราะราคาที่อัดวัดจากยอดเงินที่เปลี่ยน
--  ซึ่งเพี้ยนได้ง่ายเวลารัวอัปเกรดหลายครั้งติด (เคยจด 2500 ทั้งที่จ่ายจริง 1300)
--  ส่วนตัวเลขในโมดูลคือของที่เกมใช้จริง ไม่มีทางเพี้ยน
--
--  @GoldenPerks บอกว่าทาวเวอร์ตัวนี้เป็นสกิน Golden หรือเปล่า ซึ่งใช้คนละตารางราคา
local function upgradeCost(m)
    local r = rep(m)
    if not r then return nil end
    local costs = upgradeCosts(tName(m), r:GetAttribute("GoldenPerks") == true)
    if not costs then return nil end
    return costs[tLevel(m) + 1]
end

--  หน้าสรุปผลตอนจบเกม
--
--  ตอนแรกผมเดาว่าเป็น workspace.Triumph ซึ่งผิด — log จริงบอกว่าไม่มีตัวนั้นอยู่เลย
--  ทั้งตอนเริ่มและตอนจบ ตัวจับจบเกมเดิมจึงไม่เคยทำงาน
--
--  ของจริงคือกล่อง gameOver ใน ReactGameNewRewards ซึ่งโผล่ทั้งตอนชนะและแพ้
--  ป้ายข้างในเขียน "TRIUMPH!" ตอนชนะ จึงใช้แยกผลได้ด้วย
--  คืน nil = ยังไม่จบ, คืนข้อความ = จบแล้ว
local function endBanner()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    local rw  = gui and gui:FindFirstChild("ReactGameNewRewards")
    local fr  = rw and rw:FindFirstChild("Frame")
    local go  = fr and fr:FindFirstChild("gameOver")
    if not go then return nil end
    if go:IsA("GuiObject") and not go.Visible then return nil end

    for _, d in ipairs(go:GetDescendants()) do
        if d:IsA("TextLabel") and d.Text ~= "" then return d.Text end
    end
    return ""      -- กล่องโผล่แล้วแต่ยังไม่มีข้อความ ถือว่าจบแล้วเหมือนกัน
end

--  นับแยกตามชนิด เช่น "Scout=6 Farm=8"
--  ถ้าการปฏิเสธมาจากลิมิตของทาวเวอร์ชนิดใดชนิดหนึ่ง ตัวเลขนี้จะฟ้องทันที
local function towerBreakdown()
    local f = towersFolder()
    if not f then return "-" end

    local by, total = {}, 0
    for _, m in ipairs(f:GetChildren()) do
        if isMine(m) then
            total = total + 1
            local n = tName(m) or "?"
            by[n] = (by[n] or 0) + 1
        end
    end

    local parts = {}
    for n, c in pairs(by) do table.insert(parts, ("%s=%d"):format(n, c)) end
    table.sort(parts)
    return ("%d ตัว (%s)"):format(total, table.concat(parts, " "))
end

local function countOfType(name)
    local f = towersFolder()
    if not (f and name) then return 0 end
    local n = 0
    for _, m in ipairs(f:GetChildren()) do
        if isMine(m) and tName(m) == name then n = n + 1 end
    end
    return n
end

local function myTowerCount()
    local f = towersFolder()
    if not f then return 0 end
    local n = 0
    for _, m in ipairs(f:GetChildren()) do
        if isMine(m) then n = n + 1 end
    end
    return n
end

--  หาทาวเวอร์ที่เพิ่งโผล่จากคำสั่งวางของเรา
--
--  exclude คือรายชื่อทาวเวอร์ที่มีอยู่ "ก่อน" ส่งคำสั่ง — จำเป็นมาก
--  ถ้าไม่กันไว้ แล้วผู้ใช้กดเล่นมาโครตอนที่ในสนามมีทาวเวอร์อยู่แล้ว
--  ตัวเก่าที่ยืนอยู่จุดเดียวกันจะถูกนับว่า "วางสำเร็จ" ทันที
--  ทั้งที่คำสั่งจริงถูกปฏิเสธ แล้วคำสั่งอัปเกรดที่ตามมาจะไปลงผิดตัว
--
--  เดิมบังคับให้ตำแหน่งตรงกันในรัศมี 1 สตัด ซึ่งเข้มเกินไปและเป็นบั๊ก:
--  ถ้าเซิร์ฟเวอร์วางให้จริงแต่ขยับตำแหน่งเล็กน้อย หรือ attribute มาช้ากว่าที่รอ
--  เราจะสรุปว่าพลาดแล้วยิงซ้ำ คราวนี้จุดนั้นมีของอยู่แล้วจึงถูกปฏิเสธจริง
--  สุดท้ายมาโครมองว่าวางไม่ขึ้น แล้วข้ามการอัปเกรดของทาวเวอร์ตัวนั้นทั้งหมด
--
--  คำสั่งวางหนึ่งครั้งสร้างทาวเวอร์ได้ตัวเดียว ดังนั้นทาวเวอร์ "ใหม่" ที่เป็น
--  ของเราและชนิดตรงกัน ย่อมเป็นผลจากคำสั่งนี้แน่นอน ไม่ต้องยึดตำแหน่งเป็นเงื่อนไข
--  ใช้ระยะเป็นแค่ตัวตัดสินเวลามีหลายตัวเข้าข่าย
local function findNewTower(before, pos, wantName)
    local f = towersFolder()
    if not f then return nil end

    local best, bestDist
    for _, m in ipairs(f:GetChildren()) do
        if isMine(m) and not modelRef[m] and not (before and before[m]) then
            if (not wantName) or tName(m) == wantName then
                local p = tPos(m)
                local d = (p and pos) and (p - pos).Magnitude or math.huge

                --  กันตัวที่อยู่คนละมุมแมพ เผื่อมีทาวเวอร์โผล่จากทางอื่น
                if d < 12 and (not bestDist or d < bestDist) then
                    best, bestDist = m, d
                end
            end
        end
    end
    return best
end

--  ตามหาทาวเวอร์ของ ref ที่ยังจับคู่ไม่ได้ โดยดูจากตำแหน่งที่อัดไว้
--
--  จำเป็นเพราะบางครั้งเซิร์ฟเวอร์วางให้จริงแต่เราสรุปว่าพลาด (เช่นตอบกลับแปลกๆ
--  หรือจังหวะไม่ลงตัว) ถ้าตัดการอัปเกรดทิ้งไปเลย ทาวเวอร์ตัวนั้นจะอยู่ระดับ 0
--  ทั้งเกม ซึ่งกระทบแรงกว่าการวางพลาดเองเสียอีก
--
--  รัศมี 3 สตัดและต้องเป็นทาวเวอร์ชนิดเดียวกัน — ตำแหน่งที่ส่งกับที่เซิร์ฟเวอร์
--  บันทึกต่างกันแค่ระดับทศนิยม ถ้ากว้างกว่านี้เสี่ยงไปคว้าทาวเวอร์ตัวข้างๆ
--  แล้วอัปเกรดผิดตัว ซึ่งแย่กว่าไม่อัปเกรดเลย
local function recoverRef(ref)
    local want = refPos[ref]
    if not want then return nil end

    local f = towersFolder()
    if not f then return nil end

    local best, bestDist
    for _, m in ipairs(f:GetChildren()) do
        if isMine(m) and not modelRef[m]
            and ((not want.name) or tName(m) == want.name) then
            local p = tPos(m)
            local d = p and (p - want.pos).Magnitude or math.huge
            if d <= 3 and (not bestDist or d < bestDist) then
                best, bestDist = m, d
            end
        end
    end

    if best then
        refModel[ref]  = best
        modelRef[best] = ref
        deadRef[ref]   = nil
    end
    return best
end

--  Data ของสกิลบางตัวไม่ว่าง — สกิลที่ต้องเล็งเป้า (มี AbilityIndicator)
--  จะแนบตำแหน่งหรือค่าอื่นมาด้วย เดิมตอนเล่นผมส่ง Data = {} ตายตัว
--  สกิลพวกนั้นจึงส่งไปแล้วเซิร์ฟเวอร์ไม่รู้จะทำอะไร กลายเป็นไม่ทำงาน
--
--  JSON เก็บ Vector3/CFrame ตรงๆ ไม่ได้ ต้องแปลงเป็นตารางแล้วแปลงกลับ
local function packValue(v, depth)
    depth = depth or 0
    if depth > 5 then return nil end

    local ty = typeof(v)
    if ty == "number" or ty == "string" or ty == "boolean" then
        return v
    elseif ty == "Vector3" then
        return { __t = "v3", v = { v.X, v.Y, v.Z } }
    elseif ty == "Vector2" then
        return { __t = "v2", v = { v.X, v.Y } }
    elseif ty == "CFrame" then
        return { __t = "cf", v = { v:GetComponents() } }
    elseif ty == "Color3" then
        return { __t = "c3", v = { v.R, v.G, v.B } }
    elseif ty == "table" then
        local out = {}
        for k, val in pairs(v) do
            if type(k) == "string" or type(k) == "number" then
                local packed = packValue(val, depth + 1)
                if packed ~= nil then out[tostring(k)] = packed end
            end
        end
        return out
    end

    --  Instance ชี้ไปที่ของในเกมรอบนั้น รอบใหม่ไม่มีทางหาตัวเดิมเจอ เก็บไม่ได้
    return nil
end

local function unpackValue(v)
    if type(v) ~= "table" then return v end

    local t = v.__t
    if t == "v3" then return Vector3.new(v.v[1], v.v[2], v.v[3])
    elseif t == "v2" then return Vector2.new(v.v[1], v.v[2])
    elseif t == "c3" then return Color3.new(v.v[1], v.v[2], v.v[3])
    elseif t == "cf" then return CFrame.new(table.unpack(v.v))
    end

    local out = {}
    for k, val in pairs(v) do
        --  JSON เปลี่ยนคีย์ตัวเลขเป็นข้อความ ต้องแปลงกลับ ไม่งั้นตารางลำดับจะเสีย
        out[tonumber(k) or k] = unpackValue(val)
    end
    return out
end

