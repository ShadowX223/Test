--  กันลูปซ้อน แบบเดียวกับหมุนบัฟ
--  กดปิดแล้วเปิดใหม่เร็วๆ ลูปเก่าอาจยังค้างอยู่ในช่วง task.wait
local voteGen = 0

local function autoVoteLoop()
    voteGen = voteGen + 1
    local myGen = voteGen

    task.spawn(function()
        vlog("ลูปเริ่มทำงานแล้ว (แมพที่เลือก: %s)",
            wantMap ~= "" and wantMap or "ยังไม่ได้เลือก")

        --  ทำไปแล้วในรอบนี้หรือยัง
        --
        --  เปิดค้างไว้เพื่อ AFK แปลว่าลูปจะวนอยู่ตลอดเวลา ต้องแยกให้ออกว่า
        --  "ยังไม่ได้ทำ" กับ "ทำไปแล้วและกำลังอยู่ในด่าน" ไม่งั้นมันจะโหวตซ้ำ
        --  และกด Ready ซ้ำไปเรื่อยๆ ทั้งที่เข้าด่านเรียบร้อยแล้ว
        --
        --  ล้างธงเมื่อกลับมาที่ห้องเลือกด่านรอบใหม่ — จบเกมแล้วมันจะทำให้เองอีกครั้ง
        --  ไม่ต้องปิดสวิตช์แล้วเปิดใหม่ ซึ่งเป็นสิ่งที่ AFK ทำไม่ได้อยู่แล้ว
        local votedThisRound = false

        while autoVote and voteGen == myGen do
            if inGame() then
                votedThisRound = false
                vlog("อยู่ในด่านแล้ว — พักไว้ รอบหน้าที่กลับมาห้องเลือกด่านค่อยทำใหม่")
                task.wait(2)

            elseif not inLobby() then
                votedThisRound = false
                vlog("ยังไม่อยู่ในห้องเลือกด่าน (ไม่เจอ workspace.IntermissionLobby)")
                task.wait(2)

            elseif votedThisRound then
                --  โหวตและกด Ready ไปแล้วในรอบนี้ รอเข้าด่านอย่างเดียว
                --  กดซ้ำไม่ได้ทำให้เริ่มเร็วขึ้น เพราะยังต้องรอผู้เล่นคนอื่นอยู่ดี
                task.wait(2)

            elseif wantMap == "" then
                status = "Auto Vote: เลือกแมพในช่อง Select Map ก่อน"
                vlog("ยังไม่ได้เลือกแมพในช่อง Select Map")
                task.wait(2)

            else
                local board = findMapBoard(wantMap)

                --  ยังไม่มีแมพนี้บนกระดาน — บังคับด้วย VIP
                --
                --  ไม่ต้องเดินไปแท่นแล้วเปิดหน้าต่างเลือกอีกต่อไป
                --  หน้าต่างนั้นทำอย่างเดียวคือยิงคำสั่งนี้ เรียกตรงๆ จบเร็วกว่าและไม่มีทางพลาดจังหวะ
                if not board and hasVIP then
                    status = ("Auto Vote: บังคับแมพเป็น %s"):format(wantMap)
                    local ok, err = pcall(cmdOverrideMap, wantMap)
                    vlog(ok and ("ส่งคำสั่งบังคับแมพเป็น %s แล้ว"):format(wantMap)
                            or  ("ส่งคำสั่งบังคับแมพไม่สำเร็จ: " .. tostring(err)))

                    local until_ = os.clock() + 8
                    while autoVote and os.clock() < until_ do
                        board = findMapBoard(wantMap)
                        if board then break end
                        task.wait(0.3)
                    end
                end

                if not board then
                    --  บอกด้วยว่าตอนนี้กระดานทั้งสี่เป็นแมพอะไรบ้าง
                    --  ถ้าชื่อในช่องเลือกสะกดไม่ตรงกับบนกระดาน จะเห็นทันทีตรงนี้
                    local names = {}
                    local lb = lobbyFolder()
                    local bs = lb and lb:FindFirstChild("Boards")
                    for _, b in ipairs(bs and bs:GetChildren() or {}) do
                        table.insert(names, ("%s=%s"):format(b.Name, tostring(boardMapTitle(b))))
                    end

                    status = hasVIP
                        and ("Auto Vote: บังคับ %s ไม่สำเร็จ — กระดานไม่เปลี่ยน"):format(wantMap)
                        or  ("Auto Vote: ไม่มี %s บนกระดาน และไม่มี VIP ให้บังคับ"):format(wantMap)
                    vlog("หา %q บนกระดานไม่เจอ | ตอนนี้: %s",
                        wantMap, table.concat(names, "  "))
                    task.wait(5)

                else
                    local prompt, att = boardVotePrompt(board)
                    local pos = att and (att:IsA("Attachment") and att.WorldPosition or att.Position)
                    local before = boardVoteCount(board) or 0

                    vlog("%s อยู่ที่ %s (โหวตตอนนี้ %d) แท่นโหวต %s",
                        wantMap, board.Name, before,
                        pos and "เจอแล้ว" or "ไม่เจอ")

                    --  เดินไปยืนบนแท่นก่อน
                    --  เซิร์ฟเวอร์อาจตรวจระยะซ้ำ และการยืนอยู่จริงก็ไม่ได้เสียอะไร
                    if pos then
                        status = ("Auto Vote: เดินไปโหวต %s ที่ %s"):format(wantMap, board.Name)
                        walkTo(pos, 20)
                    end

                    --  กด prompt ตามทางของเกมก่อน แล้วค่อยยิงคำสั่งตรงถ้าไม่ติด
                    --  ทางของเกมสร้างคำสั่งได้ถูกต้องเสมอ ส่วนคำสั่งตรงเป็นตัวสำรอง
                    --  เผื่อ executer ไม่มี fireproximityprompt หรือกดแล้วไม่เข้า
                    if firePrompt and prompt then
                        pcall(firePrompt, prompt)
                    else
                        vlog("executer ไม่มี fireproximityprompt — จะยิงคำสั่งตรงแทน")
                    end
                    task.wait(1.5)

                    if (boardVoteCount(board) or 0) <= before and pos then
                        vlog("กดแท่นแล้วตัวนับไม่ขึ้น ยิงคำสั่งโหวตตรงแทน")
                        pcall(cmdVoteMap, wantMap, pos)
                        task.wait(1.5)
                    end
                    vlog("โหวตแล้ว ตัวนับ %d → %d", before, boardVoteCount(board) or -1)

                    --  กด Ready แล้วรอโหลดแมพ
                    status = ("Auto Vote: โหวต %s แล้ว — กด Ready"):format(wantMap)
                    local okR, errR = pcall(cmdLobbyReady)
                    vlog(okR and "กด Ready แล้ว — รอโหลดแมพ"
                             or ("กด Ready ไม่สำเร็จ: " .. tostring(errR)))

                    --  ทำครบแล้ว ปักธงไว้ รอบนี้ไม่ต้องทำอะไรอีก
                    votedThisRound = true
                end
            end
        end
    end)
end

