--  ไม่ล็อกสวิตช์อีกแล้ว
--
--  เดิมล็อกไว้จนกว่าจะเช็คว่ามี VIP แล้วค่อยปลดล็อก ซึ่งเป็นทางตันที่เงียบสนิท:
--  ถ้าปลดล็อกไม่สำเร็จด้วยเหตุใดก็ตาม สวิตช์จะกดไม่ติดโดยไม่มีอะไรบอกเลย
--  ผู้ใช้เห็นแค่ "กดแล้วไม่มีอะไรเกิดขึ้น" ซึ่งหน้าตาเหมือนบั๊กอีกสิบแบบ
--
--  และการล็อกก็ไม่จำเป็นด้วย — คนไม่มี VIP ยังใช้ประโยชน์ได้:
--  บังคับแมพไม่ได้ก็จริง แต่ถ้าแมพที่เลือกบังเอิญขึ้นกระดานเอง มันจะโหวตให้แล้วกด Ready
--  ตอนนี้จึงเปิดให้กดได้เสมอ แล้วไปบอกสถานะ VIP ที่คำอธิบายแทน
task.spawn(function()
    --  ลองซ้ำได้ การเช็คเกมพาสเป็นการเรียกผ่านเน็ต พลาดชั่วคราวได้เสมอ
    local owns, err
    for i = 1, 3 do
        local ok, res = pcall(function()
            return MarketplaceService:UserOwnsGamePassAsync(LocalPlayer.UserId, VIP_GAMEPASS)
        end)
        if ok then owns = res break end
        err = res
        vlog("เช็คเกมพาส VIP ไม่สำเร็จ (ครั้งที่ %d): %s", i, tostring(res))
        task.wait(2)
    end

    hasVIP = owns and true or false
    vlog(hasVIP and "มีเกมพาส VIP — บังคับแมพเองได้"
                or  ("ไม่มีเกมพาส VIP (%s) — โหวตได้เฉพาะแมพที่ขึ้นกระดานเอง")
                    :format(tostring(err)))

    --  ไม่มี VIP ก็ยังใช้ได้ แค่บังคับด่านไม่ได้ — บอกให้ชัดจะได้ไม่เข้าใจผิดว่าพัง
    if not hasVIP then
        pcall(function()
            MapToggle:SetDesc("No VIP — can only vote for maps already on the boards")
        end)
    end
end)

