--  ตัวอัด
--
--  ดัก __namecall แบบเบาที่สุด — ในตัว hook แค่โยนของใส่คิวแล้วปล่อยผ่าน
--  งานหนักไปทำในลูปแยก ถ้าทำงานหนักในนี้ InvokeServer จะรอคำตอบ
--  เซิร์ฟเวอร์ไม่ทัน แล้วปุ่มในเกมจะพัง (เจอมาแล้วตอนเขียน debug)
--
--  คำสั่งที่สคริปต์นี้ส่งเองจะไม่ถูกอัดซ้ำ เพราะ checkcaller() เป็น true
-- ═══════════════════════════════════════════════════
local queue, qHead, qTail = {}, 1, 0

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    if recording and (self == RE or self == RF) then
        local method = getnamecallmethod()
        if (method == "FireServer" or method == "InvokeServer") and not checkcaller() then
            qTail = qTail + 1
            queue[qTail] = table.pack(...)
        end
    end
    return oldNamecall(self, ...)
end)

--  คิววัดราคาอัปเกรด แยกตามทาวเวอร์
--
--  เดิมใช้ task.delay(1.2) แล้วค่อยอ่าน @TotalSpent ซึ่งพังทันทีถ้าผู้เล่นรัว
--  อัปเกรดตัวเดียวกันหลายครั้งรวด เพราะทุกครั้งจะไปอ่านตอนที่อัปครบหมดแล้ว
--  ครั้งแรกจึงได้ราคาเท่ากับยอดรวมของทั้งชุด สูงเกินจริงหลายเท่า
--  แล้วตอนเล่นมาโครก็จะนั่งรอเงินที่ไม่เคยต้องใช้จนหมดเวลาแล้วข้ามคำสั่งนั้นทิ้ง
--
--  คราวนี้ผูกกับสัญญาณ @TotalSpent เปลี่ยนแทน ทุกครั้งที่ยอดขยับ
--  จะจับคู่ส่วนต่างเข้ากับคำสั่งที่รออยู่ตัวแรกสุด เรียงตามลำดับที่กดจริง
local upgradeQueue = {}
local upgradeConns = {}

local function trackUpgradeCost(m, action)
    local q = upgradeQueue[m]

    if not q then
        q = { spent = tSpent(m), waiting = {} }
        upgradeQueue[m] = q

        local r = rep(m)
        if r then
            local conn = r:GetAttributeChangedSignal("TotalSpent"):Connect(function()
                local now  = tSpent(m)
                local diff = now - q.spent
                q.spent = now
                local a = table.remove(q.waiting, 1)
                if a and diff > 0 then a.cost = diff end
            end)
            table.insert(upgradeConns, conn)
        end
    end

    table.insert(q.waiting, action)
end

local function clearUpgradeTracking()
    for _, c in ipairs(upgradeConns) do pcall(function() c:Disconnect() end) end
    upgradeConns = {}
    upgradeQueue = {}
end

local dropped = 0      -- คำสั่งที่อัดไว้แล้วถูกถอดออกเพราะเกมไม่รับ

--  เวลาที่แต่ละเวฟเริ่ม (วินาทีนับจากเริ่มอัด)
--
--  จำเป็นเพราะ "กดสกิลตอนบอสออก" ไม่ได้ผูกกับเวลาตั้งแต่เริ่มเกม
--  แต่ผูกกับ "วินาทีที่เท่าไหร่ของเวฟนั้น" ตอนเล่นซ้ำเวลารวมจะเลื่อนเสมอ
--  (รอเงิน รอโหวต ฯลฯ) ถ้ายึดเวลารวมก็จะกดผิดจังหวะไปทั้งชุด
local waveAt = {}

local function addAction(a)
    local now = os.clock() - macro.t0
    a.t    = now
    a.wave = getWave()
    a.tw   = now - (waveAt[a.wave] or 0)      -- วินาทีที่เท่าไหร่ของเวฟนั้น
    table.insert(macro.actions, a)
    return a
end

--  เฝ้าว่าเวฟเปลี่ยนตอนไหน ระหว่างอัดเท่านั้น
local function watchWavesWhileRecording()
    task.spawn(function()
        local last = getWave()
        waveAt[last] = os.clock() - macro.t0
        while recording do
            local w = getWave()
            if w ~= last then
                last = w
                waveAt[w] = os.clock() - macro.t0
            end
            task.wait(0.2)
        end
    end)
end

--  ตรวจย้อนหลังว่าคำสั่งที่เพิ่งอัดไปนั้นเกมรับจริงไหม ถ้าไม่รับก็ถอดออก
--
--  จำเป็นเพราะตัวดักเห็นแค่คำสั่งขาออก ไม่เห็นคำตอบของเซิร์ฟเวอร์
--  (จะไปดักคำตอบก็ไม่ได้ เพราะการรอผลข้างใน hook เป็นการ yield ข้ามขอบเขต
--  metamethod ซึ่ง Roblox ไม่ยอม แล้วคำสั่งในเกมจะพังทั้งหมด)
--
--  ผู้เล่นกดพลาดเป็นเรื่องปกติ เช่นวางทาวเวอร์เกินลิมิต หรือวางในจุดที่วางไม่ได้
--  ถ้าปล่อยให้ติดเข้ามาโคร ตอนเล่นซ้ำมันจะไปยิงคำสั่งที่ไม่มีวันสำเร็จ
--  เสียเวลาลองซ้ำ แล้วไปกินจังหวะของคำสั่งข้างหลังที่มีหน้าต่างเวลาจำกัด
--
--  ดูจากผลที่เกิดขึ้นในเกมจริง ไม่ใช่จากคำสั่งที่ส่งไป
local function verifyLater(owner, action, label, check, wait)
    task.delay(wait or 2.5, function()
        --  อัดรอบใหม่ไปแล้ว ของเก่าไม่เกี่ยวกันแล้ว
        if macro ~= owner then return end

        local ok, effective = pcall(check)
        if ok and effective then return end

        for i = #owner.actions, 1, -1 do
            if owner.actions[i] == action then
                table.remove(owner.actions, i)
                dropped = dropped + 1
                dlog("ถอดคำสั่งที่เกมไม่รับออก: %s", label)
                break
            end
        end
    end)
end

local function handleCommand(a)
    if not (recording and macro) then return end

    local ns, act = a[1], a[2]

    --  จำช่องกับสกินที่กดล่าสุด เอาไว้เติมให้คำสั่งวางที่ตามมา
    if ns == "Hotbar" and act == "Click" then lastSlot = a[3] return end
    if ns == "Streaming" and act == "SelectTower" then lastSkin = a[4] return end

    if ns == "Voting" and act == "Skip" then
        --  หนึ่งเวฟโหวตข้ามได้ครั้งเดียว การกดซ้ำคือการยกเลิกโหวตของตัวเอง
        --  ถ้าอัดไว้ทั้งคู่ ตอนเล่นมาโครจะเปิดแล้วปิดโหวตทันที เกมไม่เริ่มสักที
        --
        --  log จริงเจอ skip ที่เวฟ 0 ถึงสามครั้ง ทำให้มาโครค้างอยู่ 130 วินาที
        --  กว่าครั้งที่สามจะบังเอิญเปิดโหวตกลับ
        local w = getWave()
        for _, prev in ipairs(macro.actions) do
            if prev.type == "skip" and prev.wave == w then return end
        end

        --  เก็บอาร์กิวเมนต์ที่เหลือด้วย ห้ามทิ้ง
        --  ซอร์สของ VoteWave มีปุ่ม Yes กับ No ที่เรียก Voted(true) / Voted(false)
        --  แปลว่าโหวตข้ามเวฟน่าจะแนบค่ามาด้วย ต่างจากปุ่ม Ready ตอนก่อนเริ่มเกม
        --  ที่ดักได้ว่าไม่มีอาร์กิวเมนต์เลย ถ้าทิ้งไปก็เท่ากับส่งคำสั่งไม่ครบ
        local extra, n = {}, 0
        for i = 3, a.n do
            n = n + 1
            extra[tostring(n)] = packValue(a[i])
        end
        addAction({ type = "skip", extra = extra, extraN = n })
        return
    end
    if ns ~= "Troops" then return end

    if act == "Place" then
        local d, name = a[3], a[4]
        if type(d) ~= "table" or not d.Position then return end

        refCount = refCount + 1
        local action = addAction({
            type  = "place",
            ref   = refCount,
            tower = name,
            skin  = lastSkin,
            slot  = lastSlot,
            pos   = { d.Position.X, d.Position.Y, d.Position.Z },
            rot   = { (d.Rotation or CFrame.new()):GetComponents() },
            cost  = 0,
        })

        if lastSlot and name then macro.slots[tostring(lastSlot)] = name end

        --  ราคาจริงต้องรอทาวเวอร์โผล่ก่อนถึงจะอ่าน @TotalSpent ได้
        table.insert(pendingPlaces,
            { action = action, pos = d.Position, at = os.clock() })

        --  ไม่มีทาวเวอร์โผล่ = เกมปฏิเสธ (เช่นวางเกินลิมิต หรือจุดนั้นวางไม่ได้)
        local ref = action.ref
        verifyLater(macro, action, ("วาง %s"):format(tostring(name)), function()
            return refModel[ref] ~= nil
        end, 3)

    elseif act == "Upgrade" then
        local m = type(a[4]) == "table" and a[4].Troop
        local r = m and modelRef[m]
        if not r then return end    -- ไม่ใช่ทาวเวอร์ที่มาโครนี้วางไว้ ข้าม

        --  ราคาอัปเกรดวัดจาก @TotalSpent ที่เพิ่มขึ้น แม่นกว่าอ่านเงินบนจอ
        --  เพราะเงินอาจขยับจากรายได้ของ Farm พร้อมกันพอดี
        local spent0, lv0 = tSpent(m), tLevel(m)
        local up = addAction({ type = "upgrade", ref = r, cost = 0 })
        trackUpgradeCost(m, up)

        --  ไม่มีอะไรขยับ = เงินไม่พอ หรืออัปจนสุดทางแล้ว
        verifyLater(macro, up, "อัปเกรด", function()
            return tSpent(m) > spent0 or tLevel(m) > lv0
        end)

    elseif act == "Option" then
        local d = type(a[4]) == "table" and a[4]
        local m = d and d.Troop
        local r = m and modelRef[m]
        if not r or not d.Name then return end

        local rep0 = rep(m)
        local before = rep0 and rep0:GetAttribute("Options")
        local opt = addAction({
            type  = "option",
            ref   = r,
            name  = tostring(d.Name),
            value = packValue(d.Value),
        })

        verifyLater(macro, opt, ("ตัวเลือก %s"):format(tostring(d.Name)), function()
            local r2 = rep(m)
            return r2 ~= nil and r2:GetAttribute("Options") ~= before
        end)

    elseif act == "Target" then
        local d = type(a[4]) == "table" and a[4]
        local m = d and d.Troop
        local r = m and modelRef[m]
        if not r or not d.Target then return end

        local before = tTargetMode(m)
        local tg = addAction({ type = "target", ref = r, mode = tostring(d.Target) })

        verifyLater(macro, tg, ("โหมดเล็ง %s"):format(tostring(d.Target)), function()
            return tTargetMode(m) ~= before
        end)

    elseif act == "Sell" then
        local m = type(a[3]) == "table" and a[3].Troop
        local r = m and modelRef[m]
        if not r then return end
        local sell = addAction({ type = "sell", ref = r })

        verifyLater(macro, sell, "ขาย", function()
            return m.Parent == nil
        end)

    elseif act == "Abilities" then
        local d = type(a[4]) == "table" and a[4]
        local m = d and d.Troop
        local r = m and modelRef[m]
        if not r or not d.Name then return end
        --  จดตัวเลือกที่ตั้งไว้ตอนกด
        --
        --  สกิลของบางทาวเวอร์ให้ผลต่างกันตามตัวเลือก เช่น Drop The Beat ของ DJ Booth
        --    Purple  ผลักและชะลอศัตรู
        --    Green   ได้เงินตามจำนวนทาวเวอร์ในระยะ
        --    Red     ทำดาเมจและลดเกราะ
        --  กดถูกจังหวะแต่ Track ผิด = ได้เอฟเฟกต์คนละอย่างกับที่ตั้งใจ
        local rep0 = rep(m)
        local opts = rep0 and rep0:GetAttribute("Options")
        if type(opts) ~= "string" or opts == "" or opts == "[]" then opts = nil end

        --  จดว่าตอนกดมีบอสอยู่ในสนามไหม
        --  ถ้ามี แปลว่าผู้เล่นตั้งใจกดตอนบอสออก ซึ่งเป็นจังหวะที่แม่นกว่าการนับวินาที
        --  เพราะรอบหน้าบอสอาจออกช้าหรือเร็วกว่าเดิมตามความเร็วที่เคลียร์เวฟ
        addAction({
            type = "ability",
            ref  = r,
            name = d.Name,
            data = packValue(d.Data) or {},
            boss = bossOnField() or nil,
            opts = opts,
        })
    end
end

