task.spawn(function()
    task.wait(0)
    pcall(function() DelaySlider:Set(0.50) end)
    pcall(function() TimeoutSlider:Set(45) end)

    --  เติมรายชื่อก่อนโหลดค่าที่บันทึกไว้
    --  ถ้ารายการยังว่าง ค่าที่โหลดมาจะไม่มีตัวเลือกให้ตรง แล้วมันจะทิ้งค่านั้นไป
    pcall(function() MacroDropdown:Refresh(listMacros()) end)

    pcall(function() myConfig:Load() end)

    if not cmdDelay      or cmdDelay      <= 0 then cmdDelay      = 0.5 end
    if not actionTimeout or actionTimeout <  5 then actionTimeout = 45  end

    --  โหลดไฟล์มาโครตามชื่อที่เพิ่งกู้คืนมา
    --
    --  บาง element ของ WindUI ตั้งค่าให้เฉยๆ โดยไม่เรียก Callback
    --  ถ้าพึ่ง Callback อย่างเดียว ช่องจะโชว์ชื่อมาโครแต่ข้างในยังว่าง
    --  ซึ่งเป็นอาการที่หลอกที่สุด เพราะดูเหมือนเลือกไว้แล้วแต่กดเล่นไม่ได้
    task.delay(1, function()
        local pick = currentName
        if pick == "" then
            local ok, v = pcall(function() return MacroDropdown.Value end)
            if ok and type(v) == "string" then pick = v end
        end
        if pick ~= "" and pick ~= EMPTY_LIST and currentName ~= pick then
            pcall(loadMacro, pick)
        end
    end)
end)

