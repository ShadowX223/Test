local function ensureFolder()
    pcall(function()
        if not isfolder("ShadowXHub") then makefolder("ShadowXHub") end
        if not isfolder(MACRO_DIR)    then makefolder(MACRO_DIR)    end
    end)
end

local function saveLog()
    if #logLines == 0 then return false end
    ensureFolder()
    return (pcall(function()
        writefile(MACRO_DIR .. "/playlog.txt", table.concat(logLines, "\n"))
    end))
end

--  ชื่อไฟล์ต้องไม่มีอักขระที่ระบบไฟล์ไม่รับ ไม่งั้น writefile จะเงียบๆ ไม่เขียน
local function safeName(n)
    n = tostring(n or ""):gsub('[<>:"/\\|%?%*]', "")
    n = n:gsub("^%s+", ""):gsub("%s+$", "")
    return n ~= "" and n or "Macro"
end

local function macroPath(n) return MACRO_DIR .. "/" .. safeName(n) .. ".json" end

local EMPTY_LIST = T("EMPTY_LIST")

local function listMacros()
    ensureFolder()
    local out = {}
    pcall(function()
        for _, f in ipairs(listfiles(MACRO_DIR)) do
            local n = tostring(f):match("([^/\\]+)%.json$")
            if n then table.insert(out, n) end
        end
    end)
    table.sort(out)
    if #out == 0 then out = { EMPTY_LIST } end
    return out
end

local function writeMacro(m)
    ensureFolder()
    local ok, err = pcall(function()
        writefile(macroPath(m.name), HttpService:JSONEncode({
            version   = 1,
            name      = m.name,
            map       = m.map,
            mode      = m.mode,
            startWave = m.startWave,
            towers    = m.towers,
            slots     = m.slots,
            autoBuff  = m.autoBuff,
            loadout   = m.loadout,
            actions   = m.actions,
        }))
    end)
    if not ok then lastError = tostring(err) end
    return ok
end

local function newMacro(name)
    local m = {
        name      = safeName(name),
        map       = getMapName(),
        mode      = getDifficulty(),
        startWave = getWave(),
        towers    = {},
        slots     = {},
        loadout   = nil,
        actions   = {},
        t0        = os.clock(),
    }
    return m
end

local function loadMacro(n)
    local path = macroPath(n)
    if not isfile(path) then
        status = T("NO_FILE")
        return false
    end

    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok or type(data) ~= "table" or type(data.actions) ~= "table" then
        status = T("BAD_FILE")
        return false
    end

    data.t0     = os.clock()
    data.towers = data.towers or {}
    data.slots  = data.slots or {}
    macro       = data
    currentName = safeName(n)

    --  เด้งช่องเลือกด่านให้ตรงกับด่านของมาโครนี้
    --
    --  ถ้าปล่อยให้ตั้งสองที่เอง พลาดง่ายมากและอาการที่ได้คือค้างตลอดกาล:
    --  โหวตไปด่านหนึ่ง แล้วมาโครนั่งรออีกด่านหนึ่งที่ไม่มีวันมาถึง
    --  มาโครรู้ด่านของตัวเองอยู่แล้ว ให้มันตั้งให้เลยดีกว่าให้คนจำ
    if type(data.map) == "string" and data.map ~= "" and data.map ~= "?" then
        wantMap = data.map
        pcall(function()
            if MapDropdown.Select then MapDropdown:Select(data.map)
            else MapDropdown:Set(data.map) end
        end)
    end

    local towers = table.concat(data.towers, ", ")
    status = T("SELECTED", currentName, #data.actions, data.map or "?",
        towers ~= "" and T("USES", towers) or "")
    return true
end

local function deleteMacro(n)
    local path = macroPath(n)
    if not isfile(path) then
        status = T("NO_FILE")
        return false
    end
    local ok = pcall(function() delfile(path) end)
    if ok then
        if currentName == safeName(n) then
            macro, currentName = nil, ""
        end
        status = T("DELETED", safeName(n))
    else
        status = T("DEL_FAIL")
    end
    return ok
end

