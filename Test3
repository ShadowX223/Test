--  ตรวจโหลดเอาต์
--
--  เทียบราคาของแต่ละช่อง hotbar กับตอนที่อัด ราคาต่างกัน = คนละทาวเวอร์
--  ถ้าไม่ตรงแล้วปล่อยให้เล่นไป มาโครจะวางผิดตัวทั้งชุดตั้งแต่คำสั่งแรก
-- ═══════════════════════════════════════════════════
local function checkLoadout()
    if not macro then return true, T("NO_MACRO") end
    if not macro.loadout then
        return true, T("NO_LOADOUT")
    end

    local now = hotbarCosts()
    if not now then return true, T("CANT_READ_LO") end

    local bad = {}
    for slot, cost in pairs(macro.loadout) do
        local cur = now[slot]
        if cur ~= cost then
            local who = macro.slots and macro.slots[slot]
            table.insert(bad, T("SLOT_DIFF", slot, tostring(cost),
                who and (" (" .. who .. ")") or "",
                cur and ("$" .. cur) or T("EMPTY_SLOT")))
        end
    end

    table.sort(bad)
    if #bad == 0 then return true, T("LO_OK") end
    return false, T("LO_BAD") .. "\n" .. table.concat(bad, "\n")
end

