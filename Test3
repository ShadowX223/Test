--  โหวตแมพเองใน IntermissionLobby
--
--  ลำดับที่ต้องทำ (ตามที่ผู้ใช้อธิบายจากการเล่นจริง)
--    1. เดินไป IntermissionLobby.MapVote.ProximityPrompt แล้วสั่งกด → เปิดหน้าต่างเลือกแมพ
--    2. เลือกแมพที่ตั้งไว้ในช่อง Select Map
--    3. แมพที่เลือกจะไปโผล่บนกระดานใดกระดานหนึ่งใน Boards.Board1..4
--    4. เดินไปกระดานนั้น กด ProximityPrompt บน Hitboxes.VotePlatform เพื่อโหวต
--    5. กด Ready แล้วรอโหลดแมพ
--
--  ข้อ 1 กับ 4 ทำได้เลยเพราะรู้ที่อยู่แน่นอนแล้ว
--  ข้อ 2 กับ 5 ยังไม่รู้ว่าเกมส่งอะไรไปหาเซิร์ฟเวอร์ ต้องดักของจริงก่อน
--  จึงยังไม่เขียนส่วนนั้น — เดาแล้วพลาดเคยทำให้ทั้งสคริปต์ใช้ไม่ได้มาแล้ว
-- ═══════════════════════════════════════════════════
local firePrompt = rawget(getfenv(), "fireproximityprompt")

local function myHumanoid()
    local ch = LocalPlayer.Character
    if not ch then return nil, nil end
    return ch:FindFirstChildOfClass("Humanoid"), ch
end

--  เดินไปให้ใกล้พอที่ ProximityPrompt จะยอมรับ
--
--  ยิง fireproximityprompt จากที่ไกลๆ ได้ในบาง executer แต่ไม่ใช่ทุกตัว
--  และฝั่งเซิร์ฟเวอร์ก็ตรวจระยะซ้ำอีกชั้น เดินไปจริงจึงชัวร์กว่า
--  ตอนอยู่ในห้องเลือกด่านไม่มีอะไรให้เสีย เดินได้เต็มที่
local function walkTo(where, timeout)
    local pos
    if typeof(where) == "Vector3" then
        pos = where
    elseif typeof(where) == "Instance" then
        if where:IsA("BasePart") then
            pos = where.Position
        elseif where:IsA("Attachment") then
            pos = where.WorldPosition
        elseif where:IsA("Model") then
            local ok, pv = pcall(function() return where:GetPivot().Position end)
            pos = ok and pv or nil
        end
    end
    if not pos then return false end

    local until_ = os.clock() + (timeout or 20)
    while os.clock() < until_ do
        local hum, ch = myHumanoid()
        local root = ch and ch:FindFirstChild("HumanoidRootPart")
        if not (hum and root) then task.wait(0.5)
        else
            if (root.Position - pos).Magnitude <= 6 then return true end
            hum:MoveTo(pos)
            task.wait(0.3)
        end
    end
    return false
end

--  กระดานไหนกำลังแสดงแมพชื่อนี้อยู่
--
--  ชื่อแมพอยู่ที่  Board<N>.Hitboxes.Bottom.MapDisplay.Title  (ยืนยันจากการดักจริง)
--  จำนวนโหวตอยู่ที่ Board<N>.Hitboxes.Count.Counter.Value    ใช้ตรวจว่าโหวตติดจริงไหม
--  อ่านตรงจุดแบบนี้เร็วกว่าและแม่นกว่ากวาดหาข้อความทั้งกระดาน
--  (ของเดิมกวาดแล้วจะไปเจอ "Created by ..." หรือชื่อคนโหวตด้วย)
local function boardMapTitle(b)
    local hb = b and b:FindFirstChild("Hitboxes")
    local bt = hb and hb:FindFirstChild("Bottom")
    local md = bt and bt:FindFirstChild("MapDisplay")
    local ti = md and md:FindFirstChild("Title")
    return (ti and ti:IsA("TextLabel")) and ti.Text or nil
end

local function boardVoteCount(b)
    local hb = b and b:FindFirstChild("Hitboxes")
    local ct = hb and hb:FindFirstChild("Count")
    local cn = ct and ct:FindFirstChild("Counter")
    local va = cn and cn:FindFirstChild("Value")
    return (va and va:IsA("TextLabel")) and (tonumber(va.Text) or 0) or nil
end

local function findMapBoard(name)
    local lb = lobbyFolder()
    local boards = lb and lb:FindFirstChild("Boards")
    if not (boards and type(name) == "string" and name ~= "") then return nil end

    for _, b in ipairs(boards:GetChildren()) do
        if boardMapTitle(b) == name then return b end
    end
    return nil
end

--  แท่นโหวตของกระดานนั้น
--  ผู้ใช้บอกว่าเป็นลูกตัวที่สอง แต่ค้นหาเอาปลอดภัยกว่านับตำแหน่ง
--  ลำดับลูกใน Roblox ไม่รับประกันว่าคงที่
local function boardVotePrompt(board)
    local hb = board and board:FindFirstChild("Hitboxes")
    local vp = hb and hb:FindFirstChild("VotePlatform")
    if not vp then return nil end

    for _, c in ipairs(vp:GetDescendants()) do
        if c:IsA("ProximityPrompt") then return c, c.Parent end
    end
    return nil
end

