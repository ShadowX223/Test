            --  ปิดสวิตช์กลับทันที ไม่ให้ค้างเป็นเปิดระหว่างรอคำตอบ
            task.defer(function() pcall(function() RecordToggle:Set(false) end) end)

            WindUI:Popup({
                Title   = T("RE_TITLE"),
                Icon    = "circle-alert",
                Content = T("RE_BODY", macro.name or currentName, #macro.actions),
                Buttons = {
                    {
                        Title    = T("BTN_CANCEL"),
                        Variant  = "Tertiary",
                        Callback = function() end,   -- สวิตช์ถูกปิดไปแล้ว
                    },
                    {
                        Title    = T("BTN_REC"),
                        Icon     = "circle-dot",
                        Variant  = "Primary",
                        Callback = function()
                            --  ธงกันวน: การเปิดสวิตช์ใหม่จะวิ่งเข้า callback นี้อีกรอบ
                            --  ถ้าไม่มีธง popup จะเด้งซ้ำไม่จบ
                            confirmRec = true
                            pcall(function() RecordToggle:Set(true) end)
                        end,
                    },
                },
            })
            return
        end

        confirmRec = false
        begin()
    end,
})

