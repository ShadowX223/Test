--  อ่านของที่ได้จากรอบนี้ คืนรายการ { text, rare } กับข้อความอธิบายว่าเกิดอะไรขึ้น
--
--  ต้องบอกได้ว่าล้มที่ขั้นไหน ไม่ใช่คืนรายการว่างเฉยๆ
--  รอบที่แล้วขึ้น "could not read rewards" ซึ่งบอกแค่ว่าไม่ได้ของ
--  แต่แยกไม่ออกว่าหาตัวเก็บสถานะไม่เจอ หรือเจอแล้วแต่ยังไม่มีรางวัลมาถึง
local function matchRewards()
    local rep, why = playerReplicator()
    if not rep then return nil, why or "player state store not found" end

    --  ตัวมันเองคือตารางสถานะอยู่แล้ว
    --
    --  ผมคิดว่าต้องเรียก GetAllStates() เพราะโมดูล NewRewards ของเกมเรียกแบบนั้น
    --  แต่ของจริงที่ได้มาไม่มีเมธอดนั้น — คีย์ของสถานะวางอยู่บนตัวตารางตรงๆ เลย
    --  (log ยืนยัน: ExperienceReward, EquippedTowers, LoginStreak อยู่ในคีย์ชั้นบน)
    --  ตัวที่เกมเรียกน่าจะเป็นคนละชั้นกับที่ GetLocalPlayer() คืนมา
    --
    --  รองรับทั้งสองแบบ ใครมี GetAllStates ก็ใช้ ไม่มีก็อ่านจากตัวมันเอง
    --  เกมอัปเดตแล้วสลับไปอีกแบบก็ยังทำงานได้ ไม่ต้องมาแก้ใหม่
    local states = rep
    if type(rep.GetAllStates) == "function" then
        local ok, got = pcall(function() return rep:GetAllStates() end)
        if ok and type(got) == "table" then states = got end
    end

    local out, total, sample = {}, 0, {}
    for key, val in pairs(states) do
        total = total + 1
        if #sample < 14 then table.insert(sample, tostring(key)) end

        local raw = tostring(key):match("^(.+)Reward$")
        if raw then
            local name = raw:gsub("_", " ")
            local amount, label, rare

            if type(val) == "table" then
                label  = val.Label or val.Tower or val.Skin or name
                --  ค่าที่มากับตารางก็มีขีดล่างได้เหมือนกัน (TowerExp_Scout)
                label  = tostring(label):gsub("_", " ")
                amount = tonumber(val.Value)
                rare   = (val.Tower ~= nil) or (val.Skin ~= nil) or isDrop(raw, label)
            else
                label  = name
                --  ต้องมีวงเล็บครอบ gsub
                --
                --  gsub คืนค่าสองตัว: ข้อความใหม่ กับ "จำนวนครั้งที่แทนที่"
                --  เขียน tonumber(s:gsub(...)) จำนวนครั้งจะไหลไปเป็นอาร์กิวเมนต์ตัวที่สอง
                --  ซึ่งของ tonumber คือ "ฐานเลข" — พอเกิน 36 ก็เด้ง base out of range ทันที
                --  ที่อื่นในไฟล์นี้ครอบวงเล็บไว้หมดแล้ว ตกหล่นแค่บรรทัดนี้บรรทัดเดียว
                amount = tonumber((tostring(val):gsub("[^%d]", "")))
                rare   = isDrop(raw, label)
            end

            table.insert(out, {
                text = amount and ("+%s %s"):format(amount, label) or ("+1 " .. label),
                rare = rare and true or false,
            })
        end
    end

    if #out == 0 then
        return nil, ("%d states but none end in Reward - sample: %s")
            :format(total, table.concat(sample, ", "))
    end

    table.sort(out, function(x, y)
        if x.rare ~= y.rare then return y.rare end   -- ของดรอปไว้ท้ายสุด ให้เด่น
        return x.text < y.text
    end)
    return out, ("read %d of %d states"):format(#out, total)
end

