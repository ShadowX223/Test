--  จดลงมาโครว่า "รอบนี้ใช้หมุนบัฟของชนิดไหน"
--
--  ต้องเรียกได้จากหลายที่ เพราะจังหวะที่ผู้ใช้เปิดหมุนบัฟไม่แน่นอน
--  และเกือบทุกครั้งจะเป็น "หลังกดอัดไปแล้ว" ไม่ใช่ก่อน
--
--  เหตุผลที่หลีกเลี่ยงไม่ได้: สวิตช์หมุนบัฟหาชนิดจากทาวเวอร์ที่อยู่ในสนามจริง
--  ตอนกดเริ่มอัด สนามยังว่าง ยังไม่มี Commander สักตัว กดเปิดตอนนั้นจะไม่ผ่าน
--  ผู้ใช้จึงต้องวาง Commander ก่อนแล้วค่อยเปิด ซึ่งเลยจุดที่โค้ดเดิมจดไว้ไปแล้ว
--  ผลคือมาโครไม่เคยมี autoBuff ติดไปเลยสักไฟล์ แล้วตอนเล่นก็ไม่มีใครกดบัฟให้
local function stampAutoBuff()
    if not (macro and autoBuff) then return end
    if buffKind == "" then return end
    macro.autoBuff = { kind = buffKind }
end

local function startRecording()
    if playing then status = T("PLAYING_STOP") return false end
    if not inGame() then status = T("NOT_IN_GAME") return false end
    if not macro then status = T("PICK_FIRST") return false end

    refModel, modelRef = {}, {}
    refCount = 0
    pendingPlaces = {}
    lastSlot, lastSkin = nil, nil
    queue, qHead, qTail = {}, 1, 0
    clearUpgradeTracking()

    --  อัดใหม่ = เขียนทับของเดิมทั้งหมด ไม่ใช่ต่อท้าย
    macro.actions   = {}
    macro.towers    = {}
    macro.slots     = {}
    macro.map       = getMapName()
    macro.mode      = getDifficulty()
    macro.startWave = getWave()
    macro.t0        = os.clock()

    --  เก็บโหลดเอาต์ไว้ตั้งแต่ตอนนี้ ตอนจบอาจออกจากแมพไปแล้วอ่านไม่ได้
    macro.loadout = hotbarCosts()

    --  จดไว้ว่าตอนอัดเปิดหมุนบัฟไว้หรือเปล่า
    --
    --  การกดของระบบหมุนบัฟเป็นการเรียกจากสคริปต์เอง จึงถูก checkcaller() กรองออก
    --  ไม่มี action สกิลติดเข้ามาโครเลย ถ้าไม่จดไว้ ตอนเล่นซ้ำจะไม่มีใครกดบัฟให้
    --  พอจดไว้ ตอนเล่นก็เปิดหมุนบัฟให้เองอัตโนมัติ — และรู้ด้วยว่าไม่ต้องกดซ้ำ
    --
    --  ล้างของเก่าก่อน แล้วค่อยจดใหม่ ไม่งั้นค่าจากมาโครที่โหลดไว้จะติดมาด้วย
    --  ทั้งที่รอบนี้ไม่ได้เปิดหมุนบัฟเลย
    macro.autoBuff = nil
    stampAutoBuff()

    dropped = 0
    waveAt = {}
    recording = true
    status = T("RECORDING")
    watchWavesWhileRecording()
    watchGameOver()
    return true
end

--  ปิดการอัดถูกเรียกได้จากสองทาง — ผู้ใช้กดสวิตช์เอง กับตัวเฝ้าจบเกม
--  ถ้าปล่อยให้ทำงานซ้อนกัน macro.towers จะมีชื่อซ้ำและไฟล์จะถูกเขียนสองรอบ
local stopping = false

local function stopRecording(reason)
    --  ปุ่มยกเลิกใน popup สั่งปิดสวิตช์ ซึ่งไปกระตุ้น callback นี้ทั้งที่ยังไม่เคยอัด
    --  ถ้าไม่กันไว้ มันจะเขียนไฟล์ทับและขึ้นข้อความว่า "อัดเสร็จแล้ว" ทั้งที่ไม่ได้ทำอะไร
    if stopping or not recording then return end
    stopping = true
    recording = false

    task.wait(0.4)      -- ปล่อยให้คิวที่ค้างอยู่ประมวลผลจบก่อน
    task.wait(1.0)      -- และให้สัญญาณราคาอัปเกรดตัวสุดท้ายมาถึง
    clearUpgradeTracking()

    if not macro then stopping = false return end

    macro.towers = {}
    local seen = {}
    for _, a in ipairs(macro.actions) do
        if a.type == "place" and a.tower and not seen[a.tower] then
            seen[a.tower] = true
            table.insert(macro.towers, a.tower)
        end
    end

    --  ถ้าหยุดตอนออกจากแมพไปแล้ว hotbar จะอ่านไม่ได้
    --  ค่าที่เก็บไว้ตั้งแต่ตอนเริ่มอัดจึงต้องไม่ถูกทับด้วย nil
    local lo = hotbarCosts()
    if lo then macro.loadout = lo end

    --  จดหมุนบัฟอีกรอบก่อนบันทึก เผื่อเปิดกลางทางแล้วยังไม่ได้จด
    --  เก็บซ้ำหลายจุดดีกว่าพลาดจุดเดียวแล้วมาโครใช้ไม่ได้ทั้งไฟล์
    stampAutoBuff()

    local saved = writeMacro(macro)
    if not saved then
        status = T("REC_NOSAVE")
    elseif reason then
        status = T(reason, #macro.actions)
    else
        status = T("REC_DONE", #macro.actions, macro.name)
             .. (dropped > 0 and T("REC_DROPPED", dropped) or "")
    end

    stopping = false
end

--  เฝ้าว่าเกมจบหรือยัง แล้วปิดการอัดให้เอง
--
--  ถ้าไม่ปิด คำสั่งที่ยิงหลังจบเกม (กด Rematch, กลับ lobby, กดใน UI สรุปผล)
--  จะถูกอัดติดเข้าไปด้วย แล้วตอนเล่นซ้ำมาโครจะไปกดของพวกนั้นกลางเกม
--
--  สัญญาณที่ใช้ เรียงตามความมั่นใจ
--    หน้าสรุปผล — ReactGameNewRewards.Frame.gameOver โผล่ (ยืนยันจาก log จริง)
--    ออกจากแมพ  — State หรือ workspace.Towers หายไป
--    เลือดหมด    — State.Health.Current ถึง 0 (สำรอง เผื่อหน้าสรุปยังไม่ทันขึ้น)
function watchGameOver()
    task.spawn(function()
        --  ตอนเพิ่งเข้าแมพ ค่าเลือดอาจยังอ่านได้ 0 อยู่ชั่วครู่
        --  ต้องเห็นเลือดเกิน 0 สักครั้งก่อน ถึงจะเชื่อว่า 0 แปลว่าแพ้จริง
        local sawHealth = false

        while recording do
            local hp = getHealth()
            if hp > 0 then sawHealth = true end

            local banner = endBanner()
            local reason
            if banner then
                reason = banner:upper():find("TRIUMPH") and "AUTO_WON" or "AUTO_LOST"
            elseif not inGame() then
                reason = "AUTO_LEFT"
            elseif sawHealth and hp <= 0 then
                reason = "AUTO_LOST"
            end

            if reason then
                --  ปิดสวิตช์บน UI ด้วย ไม่งั้นผู้ใช้เห็นว่ายังอัดอยู่
                --  เรียก stopRecording ตรงๆ ไม่พึ่งว่า :Set จะยิง callback ให้
                task.spawn(function()
                    stopRecording(reason)
                    --  รอให้บันทึกเสร็จก่อนค่อยแจ้ง จะได้บอกจำนวนคำสั่งที่ถูกต้อง
                    pcall(function()
                        Notify(T("AUTO_TITLE"), status, "Success",
                            "solar/record-circle-bold", 8)
                    end)
                end)
                uiSet(RecordToggle, false)
                break
            end

            task.wait(0.5)
        end
    end)
end

-- ═══════════════════════════════════════════════════
--  ตัวเล่น
-- ═══════════════════════════════════════════════════
local function waitUntil(fn, timeout)
    local t = os.clock()
    while os.clock() - t < timeout do
        if fn() then return true end
        task.wait(0.1)
    end
    return false
end

--  ราคาจริงที่เพิ่งจ่ายไป แยกเก็บนอกตัว action
--
--  ไม่เขียนลงในตัว action ตรงๆ เพราะ action ถูกแปลงเป็น JSON ตอนบันทึก
--  ฟิลด์ชั่วคราวจะติดไปในไฟล์มาโครด้วย แล้วไฟล์จะโตขึ้นเรื่อยๆ ด้วยขยะ
--  จำไว้ว่าหยุดกลางคันที่คำสั่งไหน เอาไว้เล่นต่อ
--
--  ปิดสวิตช์แล้วเปิดใหม่ระหว่างเกม ของเดิมจะเริ่มนับหนึ่งใหม่หมด
--  แล้วไล่วางทาวเวอร์ที่วางไปแล้วซ้ำทั้งชุด ซึ่งไม่มีทางสำเร็จสักตัว
--  (ชนลิมิต / จุดนั้นมีของอยู่แล้ว) เสียเวลาหลายนาทีกว่าจะไล่ถึงจุดเดิม
local resume = nil   -- { name, index, count, map, wave }

local paidOf   = {}      -- action → เงินที่จ่ายจริงครั้งล่าสุด
local costFixed = 0      -- แก้ราคาไปกี่รายการในรอบนี้ (ใช้ตัดสินใจว่าจะบันทึกทับไหม)

--  ส่งหนึ่งครั้งแล้วยืนยันว่าเกิดผลจริง
--  การยืนยันสำคัญกว่าการเดาราคา — ถึงคำนวณเงินพลาด ก็ยังรู้ว่าสำเร็จหรือไม่
local function tryOnce(a, before, attempt)
    --  ครั้งแรกให้เวลายืนยันเต็มที่ เผื่อเซิร์ฟเวอร์ตอบช้า
    --  ครั้งหลังสั้นลง เพราะถ้าเซิร์ฟเวอร์รับคำสั่งจริง ผลจะมาภายในเสี้ยววินาที
    --  การรอ 3.5 วินาทีทุกครั้งที่พลาดคือการเสียเวลาเปล่าล้วนๆ
    local confirmWait = (attempt or 1) <= 1 and 3.5 or 1.2

    if a.type == "place" then
        local pos = Vector3.new(a.pos[1], a.pos[2], a.pos[3])
        local rot = CFrame.new(table.unpack(a.rot))

        --  Walk Around — เดินไปยืนตรงจุดที่วาง
        --
        --  ⚠ ห้ามรอให้เดินถึงเด็ดขาด ต้องแยกไปวิ่งคนละสาย
        --  มาโครต้องทำงานด้วยความเร็วเดิมทุกประการ การเดินเป็นแค่ภาพประกอบ
        --  ถ้ารอเดินก่อนวาง ทุกคำสั่งจะช้าลงหลายวินาที แล้วการรอเงินที่คำนวณไว้จะเพี้ยนหมด
        --
        --  เดินเฉพาะตอนเปลี่ยนชนิดทาวเวอร์ วางชนิดเดิมซ้ำก็ยืนอยู่ที่เดิม
        --  เพราะทาวเวอร์ชนิดเดียวกันมักวางเป็นกลุ่มใกล้ๆ กัน เดินทุกใบก็แค่ขยับไปมา
        --
        --  สวิตช์นี้ไม่เกี่ยวกับ Auto Vote map — ฝั่งนั้นมีการเดินของตัวเองเป็นทางสำรอง
        if walkAround and a.tower and a.tower ~= lastWalkTower then
            lastWalkTower = a.tower
            task.spawn(function() pcall(walkTo, pos, 15) end)
        end

        if a.slot  then pcall(cmdSelectSlot, a.slot) end
        if a.tower then pcall(cmdStream, a.tower, a.skin) end

        --  ซอร์สของเกม (NewPlacementController บรรทัด 574) เรียก
        --    Troops:InvokeServer("Place", {Position=..., Rotation=...}, Name)
        --  แล้วบรรทัดถัดมาเช็ค u44:IsA("Model")
        --  แปลว่า remote คืน "โมเดลทาวเวอร์ที่เพิ่งวาง" กลับมาให้เลย
        --
        --  ใช้ค่านี้ยืนยันตรงๆ แม่นกว่าการไปไล่หาในโฟลเดอร์แล้วเดาว่าตัวไหนของเรา
        --  ไม่มีปัญหาจับคู่ผิดตัว ไม่ต้องรอ attribute มาช้า และรู้ผลทันทีไม่ต้องหน่วง
        local sent, result = pcall(cmdPlace, rot, pos, a.tower)

        --  จดสิ่งที่เซิร์ฟเวอร์ตอบกลับมา นี่คือข้อมูลที่บอกได้ตรงที่สุดว่าทำไมวางไม่ขึ้น
        --
        --  ไม่ต้องมีสคริปต์ debug แยกไปดัก __namecall เพื่ออ่านค่านี้
        --  (ซึ่งทำแล้วพังด้วย เพราะการรอคำตอบข้างใน hook เป็นการ yield
        --  ข้ามขอบเขต metamethod ที่ Roblox ไม่ยอม แล้วคำสั่งวางจะใช้ไม่ได้เลย)
        --  มาโครเรียกเองอยู่แล้ว ได้ค่ามาตรงๆ ไม่ต้องแตะของเกม
        local desc
        if not sent then
            desc = "call failed: " .. tostring(result)
        elseif result == nil then
            desc = "nil (no value)"
        elseif typeof(result) == "Instance" then
            desc = ("<%s %q>"):format(result.ClassName, result.Name)
        elseif type(result) == "table" then
            local parts = {}
            for k, v in pairs(result) do
                table.insert(parts, ("%s=%s"):format(tostring(k), tostring(v)))
                if #parts > 8 then break end
            end
            desc = "{ " .. table.concat(parts, ", ") .. " }"
        else
            desc = ("%s %s"):format(typeof(result), tostring(result))
        end

        lastReply = desc

        --  เซิร์ฟเวอร์บอกลิมิตมาเอง จำไว้แล้วครั้งหน้าไม่ต้องยิงให้เสียเวลา
        if type(result) == "string" then
            local n, who = result:match("only place%s+(%d+)%s+(.-)%(s%)")
            if n and who then
                towerLimit[who] = tonumber(n)
            end
        end

        if sent and typeof(result) == "Instance" and result:IsA("Model") then
            refModel[a.ref]  = result
            modelRef[result] = a.ref
            return true
        end

        --  ได้ค่ากลับมาแต่ไม่ใช่โมเดล = เซิร์ฟเวอร์ปฏิเสธชัดเจน
        --  คืนธง "ปฏิเสธแน่นอน" ไปด้วย เพื่อให้เลิกยิงซ้ำเร็วขึ้น
        --  การยิงคำสั่งที่ถูกปฏิเสธซ้ำๆ รัวๆ ไม่ได้ประโยชน์และดูผิดปกติด้วย
        --  เซิร์ฟเวอร์บอกลิมิตมา = คำสั่งนี้ไม่มีวันสำเร็จในมาโครนี้
        --  ทำเครื่องหมายไว้ให้ตัดออกตอนจบรอบ จะได้ไม่ต้องมาลองใหม่ทุกครั้งที่เล่น
        if type(result) == "string" and result:find("only place") then
            a.impossible = true
        end

        --  "You need $118 more to place!" คือเรื่องเงินไม่พอ ไม่ใช่การปฏิเสธถาวร
        --
        --  เดิมนับรวมกับการปฏิเสธทุกแบบ พอโดนสองครั้งติดก็เลิกลองทั้งที่แค่รอเงินอีกนิดเดียว
        --  แล้วคำสั่งที่อ้างถึงทาวเวอร์ตัวนั้นก็พังตามกันเป็นแถบ
        --  (log จริง: วาง Scout พลาดสองครั้งเพราะเงินขาด 118 แล้วอัปเกรดตัวถัดไปไม่มีทาวเวอร์ให้ทำ)
        if type(result) == "string" and result:find("You need") then
            return false
        end

        if sent and result ~= nil then return false, true end

        --  คืน nil มา อาจเป็นเวอร์ชันที่ไม่ส่งโมเดลกลับ ใช้ทางเดิมเป็นตัวสำรอง
        local got
        if waitUntil(function()
            got = findNewTower(before, pos, a.tower)
            return got ~= nil
        end, confirmWait) then
            refModel[a.ref] = got
            modelRef[got]   = a.ref
            return true
        end
        return false

    elseif a.type == "upgrade" then
        local m = refModel[a.ref]
        if not (m and m.Parent) then return false end
        --  ดูทั้งยอดเงินที่จ่ายและระดับ — ทาวเวอร์บางตัวอัปฟรีจากบัฟส่วนลด
        --  ถ้าดูแค่ TotalSpent จะเข้าใจผิดว่าอัปไม่ขึ้นแล้ววนซ้ำจนหมดเวลา
        local spent0, lv0 = tSpent(m), tLevel(m)

        --  เก็บคำตอบของเซิร์ฟเวอร์ไว้ด้วย
        --  เดิมเก็บเฉพาะตอนวาง ตอนอัปเกรดจึงไม่มีทางรู้ว่าพลาดเพราะอะไร
        --  แล้วการพลาดเพราะเงินไม่พอก็ถูกนับรวมกับการพลาดถาวร จนหมดโควตาการลอง
        local sent, reply = pcall(cmdUpgrade, m, a.path)
        lastReply = (sent and type(reply) == "string") and reply or ""

        local ok = waitUntil(function()
            return tSpent(m) > spent0 or tLevel(m) > lv0
        end, 2.5)

        --  วัดราคาจริงจาก @TotalSpent ของทาวเวอร์ตัวนั้นเอง
        --
        --  นี่คือตัวเลขจากเซิร์ฟเวอร์ ไม่ใช่การอ่านยอดเงินจากป้าย UI
        --  ยอดเงินบนป้ายมาช้ากว่าความจริงหลายเฟรม และเปลี่ยนตลอดจากรายได้ฟาร์ม
        --  ลบกันแล้วจึงได้เลขมั่วเสมอ ส่วน @TotalSpent ขยับเฉพาะตอนเราจ่ายจริง
        --
        --  ต้องรอต่ออีกนิดเพราะเงื่อนไขข้างบนผ่านได้ด้วย @Upgrade อย่างเดียว
        --  ซึ่งบางทีมาถึงก่อน @TotalSpent เสี้ยววินาที ถ้าอ่านทันทีจะได้ 0
        if ok then
            waitUntil(function() return tSpent(m) > spent0 end, 1.5)
            local paid = tSpent(m) - spent0
            if paid > 0 then paidOf[a] = paid end
        end
        return ok

    elseif a.type == "option" then
        local m = refModel[a.ref]
        if not (m and m.Parent) then return false end

        local want = unpackValue(a.value)
        pcall(cmdOption, m, a.name, want)

        --  @Options เป็นข้อความ JSON เช่น {"Track":"Green"}
        --  เทียบแบบถอดรหัสก่อน ถ้าถอดไม่ได้ค่อยเทียบเป็นข้อความตรงๆ
        return waitUntil(function()
            local rep0 = rep(m)
            local raw  = rep0 and rep0:GetAttribute("Options")
            if type(raw) ~= "string" then return false end

            local ok, tbl = pcall(function() return HttpService:JSONDecode(raw) end)
            if ok and type(tbl) == "table" then
                return tbl[a.name] == want
            end
            return raw:find(tostring(want), 1, true) ~= nil
        end, 2.5)

    elseif a.type == "target" then
        local m = refModel[a.ref]
        if not (m and m.Parent) then return false end
        pcall(cmdTarget, m, a.mode)

        local want = TARGET_NUM[a.mode]
        if not want then return true end   -- โหมดที่ไม่รู้จัก ส่งแล้วผ่านเลย
        return waitUntil(function()
            return tonumber(tTargetMode(m)) == want
        end, 2)

    elseif a.type == "sell" then
        local m = refModel[a.ref]
        if not (m and m.Parent) then return true end   -- ไม่มีอยู่แล้ว = ขายไปแล้ว
        pcall(cmdSell, m)
        if waitUntil(function() return m.Parent == nil end, 2.5) then
            refModel[a.ref] = nil
            modelRef[m] = nil
            return true
        end
        return false

    elseif a.type == "ability" then
        local m = refModel[a.ref]
        if not (m and m.Parent) then return false end
        pcall(cmdAbility, m, a.name, unpackValue(a.data))
        --  สกิลไม่มีสัญญาณยืนยันที่อ่านได้ชัด ส่งครั้งเดียวแล้วผ่านไป
        --  ส่งซ้ำเสี่ยงเปลืองคูลดาวน์มากกว่าได้ประโยชน์
        return true

    elseif a.type == "skip" then
        --  ส่งซ้ำได้หลายครั้ง
        --
        --  เดิมผมคิดว่าโหวตเป็นปุ่มสลับ ส่งซ้ำแล้วจะยกเลิกโหวตตัวเอง จึงส่งครั้งเดียว
        --  แต่ซอร์สของ VoteWave เขียนไว้ว่า "โหวตไปแล้วกดอีกไม่ได้"
        --  (if u11 then return end) ส่งซ้ำจึงปลอดภัย ไม่ยกเลิกอะไรทั้งนั้น
        --
        --  ที่ต้องส่งซ้ำเพราะครั้งแรกอาจยิงตอนเวฟเพิ่งเริ่ม ยังไม่มีเมนูโหวตให้กด
        --
        --  เดิมส่งได้ 3 ครั้ง (15 วิ) เพราะตอนนั้นการโหวตยังขวางคิวหลักอยู่
        --  รอนานกว่านั้นเท่ากับหยุดวาง/อัปเกรดทั้งมาโครไปด้วย จึงต้องรีบเลิก
        --  ตอนนี้การโหวตแยกไปวิ่งสายของตัวเองแล้ว รอนานขึ้นไม่กระทบใคร
        --  จากบันทึกจริง: เวฟ 14 ติดที่ครั้งที่ 3 พอดี ส่วนเวฟ 12 หมดโควตาก่อน
        --  ทั้งที่เมนูเปิดอยู่ 0/1 — คือเซิร์ฟเวอร์ยังไม่เปิดรับ ไม่ใช่คำสั่งผิด
        local w0 = getWave()

        --  เวฟที่จะข้ามผ่านไปแล้ว โหวตตอนนี้จะไปตกในรอบของเวฟอื่น ซึ่งไม่ใช่สิ่งที่อัดไว้
        --  เกิดได้เมื่อคำสั่งก่อนหน้าใช้เวลานานกว่าตอนอัด เช่นวางไม่สำเร็จแล้วลองซ้ำ
        if w0 > (a.wave or 0) then
            return true
        end

        --  ต้องรอให้เป็น "รอบโหวตใหม่" ก่อนค่อยส่ง ดูจากตัวนับที่กลับไปเป็น 0
        --
        --  ตอนเวฟ 1 เพิ่งเริ่ม เมนูยังค้างผลโหวต Ready ของเวฟ 0 อยู่ที่ 1/1
        --  ส่งตอนนั้นเท่ากับโหวตซ้ำในรอบที่ปิดไปแล้ว เซิร์ฟเวอร์ไม่รับ
        --  แล้วพอรอบจริงเปิด มาโครก็เดินหน้าไปคำสั่งอื่นแล้ว
        --
        --  รอได้ยาว เพราะรอบโหวตจะเปิดก็ต่อเมื่อถึงช่วงพัก ซึ่งกินเวลาเป็นนาที
        --  ไม่ได้เสียเวลาเปล่า คำสั่งถัดไปถูกล็อกที่เวฟถัดไปอยู่แล้ว
        local c0 = voteCount()
        if c0 ~= 0 then
            waitUntil(function()
                return voteCount() == 0 or getWave() > w0
            end, 180)

            if getWave() > w0 then
                return true
            end
        end

        --  ส่งซ้ำจน "เวฟเดิน" ไม่ใช่จนครบจำนวนครั้งที่ตั้งไว้
        --
        --  ตัวเลขจากบันทึกจริงชี้ชัดว่าเซิร์ฟเวอร์ยังไม่เปิดรับในช่วงต้นเวฟ
        --  ทั้งที่เมนูขึ้นแล้วและตัวนับเป็น 0/1:
        --      เวฟ 12  ส่งที่วินาทีที่ 1 / 6 / 12 ของเวฟ แล้วเลิก → ไม่ติด
        --      เวฟ 14  ส่งที่วินาทีที่ 11 / 16 / 21 ของเวฟ → ติดที่ครั้งสุดท้ายพอดี
        --  ต่างกันแค่ "ส่งช้ากว่ากันสิบวินาที" คำสั่งเหมือนกันทุกตัวอักษร
        --
        --  การนับจำนวนครั้งจึงเป็นเกณฑ์ที่ผิดตั้งแต่แรก เพราะสิ่งที่รออยู่คือ
        --  จังหวะที่เซิร์ฟเวอร์เปิดรับ ไม่ใช่จำนวนครั้งที่เรายิงไป
        --  เลิกก็ต่อเมื่อเวฟเดินไปแล้ว (ซึ่งแปลว่าไม่มีอะไรให้ข้ามอีก)
        --
        --  รอยาวแบบนี้ได้เพราะการโหวตแยกไปวิ่งสายของตัวเองแล้ว ไม่มีใครรออยู่
        local deadline = os.clock() + 150
        local sends = 0

        while playing and os.clock() < deadline do
            if getWave() > w0 then
                return true
            end

            local c0, need = voteCount()
            sends = sends + 1

            pcall(cmdSkip, a)

            --  สำเร็จได้สามแบบ: โหวตของเราขึ้น, เมนูปิดไปเลย, หรือเวฟเดินต่อเอง
            local hit = waitUntil(function()
                local c = voteCount()
                if c == nil then return true end          -- เมนูปิด = จบช่วงโหวตแล้ว
                if c0 and c > c0 then return true end     -- โหวตเราขึ้นแล้ว
                return getWave() > w0
            end, 5)

            if hit then
                local c, n2 = voteCount()
                return true
            end
        end

        --  หมดเวลาแล้วเวฟยังไม่ขยับ = เซิร์ฟเวอร์ไม่รับคำสั่งนี้จริงๆ
        --  ไม่ใช่แค่เรื่องจังหวะ ต้องไปดักดูว่าปุ่มจริงส่งอะไรต่างจากเรา
        local c, n2 = voteCount()

        --  เก็บเข้ารายงานด้วย ไม่งั้นมันหายไปกับ log 800 บรรทัด
        --  แล้วเราจะไม่มีทางรู้ว่าโหวตพลาดที่เวฟไหนบ้าง
        table.insert(failLog,
            ("#? Skip wave (recorded at wave %s)\n      Vote never landed: sent %d time(s) until timeout, counter still %s/%s"
             .. "\n      At the time: wave %d, vote menu %s"
             .. "\n      The main queue never stalled; placing and upgrading kept running")
            :format(tostring(a.wave), sends, tostring(c), tostring(n2),
                    getWave(), c and "open" or "closed"))

        lastError = T("SKIP_NOMOVE", w0)
        return true
    end

    return false
end

--  คำสั่งที่ต้องมีทาวเวอร์อยู่จริงถึงจะทำได้
local NEEDS_REF = { upgrade = true, target = true, sell = true, ability = true, option = true }

--  ยังไม่พร้อมยิงเพราะอะไร — คืน nil แปลว่าพร้อม
--
--  แยกออกมาจากการ "ลองแล้วไม่สำเร็จ" เพราะสองอย่างนี้ต่างกันโดยสิ้นเชิง
--  การรอคือสถานการณ์ปกติที่เดี๋ยวก็ผ่าน ส่วนการลองแล้วพลาดคือสัญญาณว่ามีปัญหา
--  ถ้านับเวลารวมกัน คำสั่งที่แค่รอเงินนานหน่อยจะถูกข้ามทั้งที่ไม่เคยได้ลองเลย
local function holdReason(a, idx, total, tries)
    if a.type == "place" then
        local info = slotInfo(a.slot)

        --  รอคูลดาวน์เฉพาะตอนที่ยิงไปแล้วพลาดมาก่อน
        --
        --  เดิมเช็คตั้งแต่ครั้งแรก ทำให้ทุกการวางเสียเวลารอโดยไม่จำเป็น
        --  และผมยังไม่ได้ยืนยันด้วยซ้ำว่า Timeleft ของช่องทาวเวอร์คือคูลดาวน์วางจริง
        --  ถ้าอ่านผิดก็จะรอเก้อทั้งที่วางได้ตั้งนานแล้ว
        --
        --  ยิงก่อนแล้วค่อยรอเมื่อพลาด จึงเร็วในกรณีปกติและยังฉลาดตอนติดคูลดาวน์
        --  เพดาน 120 กันกรณีที่ค่านั้นไม่ใช่คูลดาวน์ แล้วเราจะรอไม่จบ
        if tries > 0 and info and info.cooldown > 0 and info.cooldown < 120 then
            return T("WAIT_CD", idx, total, info.cooldown)
        end
        --  รอเงินเป็นพฤติกรรมพื้นฐานเสมอ ไม่มีสวิตช์ปิด
        --  ยิงตอนเงินไม่พอคือส่งของที่เซิร์ฟเวอร์ปฏิเสธแน่นอน ไม่มีข้อดีเลย
        --
        --  ราคาสดจากช่องทาวเวอร์มาก่อนเสมอ ราคาที่อัดไว้เป็นแค่ตัวสำรอง
        --
        --  เดิมเลือก "ตัวที่น้อยกว่า" ระหว่างสองค่า ด้วยเหตุผลว่าถ้าเลขช่องเพี้ยน
        --  มาโครจะได้ไม่รอเงินที่ไม่มีวันถึง แต่กลายเป็นเปิดช่องให้ราคาที่อัดเพี้ยนต่ำ
        --  มาลากทุกอย่างพังแทน — log จริง: จดไว้ 81 ทั้งที่ Scout ราคา 250
        --  มาโครเลยรอแค่ $81 แล้วยิงตอนมี $132 โดนปฏิเสธสองครั้งติดจนเลิกลอง
        --
        --  ราคาสดอ่านจากช่องในเกมตอนนั้นจริงๆ สะท้อนทั้งสกินและบัฟส่วนลด
        --  ไม่มีทางเพี้ยนแบบราคาที่อัดไว้ ซึ่งมาจากการคำนวณย้อนหลังของสคริปต์เอง
        local live = (info and info.cost and info.cost > 0) and info.cost or nil
        local need = live or a.cost or 0
        local c = getCash()
        if c and need > 0 and c < need then
            return T("WAIT_CASH", idx, total, need, c)
        end
        return nil
    end

    --  อัปเกรด: ใช้ราคาสดจากโมดูลเกมก่อนเสมอ ถ้าอ่านได้
    --
    --  ราคาที่อัดไว้เป็นตัวสำรอง ไม่ใช่ตัวหลักอีกต่อไป
    --  มันเพี้ยนสูงเกินจริงได้ง่ายมาก แล้วมาโครจะนั่งรอเงินที่ไม่เคยต้องใช้
    --  บันทึกรอบล่าสุดเสียเวลาแบบนี้ไปเจ็ดครั้ง รวมราวร้อยวินาที
    local need = a.cost or 0
    if a.type == "upgrade" then
        local m = refModel[a.ref]
        local live = (m and m.Parent) and upgradeCost(m) or nil
        if live then
            --  ราคาในโมดูลเป็น "ราคาป้าย" ยังไม่หักส่วนลด
            --  ส่วน a.cost มาจาก @TotalSpent = เงินที่จ่ายจริงรอบก่อน ซึ่งหักแล้ว
            --  (log จริง: ป้าย 2400 จ่ายจริง 2040 ต่างกัน 15% ทุกครั้ง)
            --  เอาตัวที่ต่ำกว่า จะได้ไม่รอเงินส่วนที่ไม่ต้องจ่าย
            --  ถ้าส่วนลดหายไปแล้วยิงพลาด ตัวรอเงินจะพากลับมาลองใหม่เอง ไม่เสียหาย
            need = (need > 0) and math.min(need, live) or live
        end
    end

    if need > 0 then
        local c = getCash()
        if c and c < need then
            return T("WAIT_CASH", idx, total, need, c)
        end
    end
    return nil
end

--  ลองซ้ำจนกว่าจะสำเร็จ หรือหมดงบเวลา "ที่ใช้ลองจริง" แล้วข้าม
local function runAction(a, idx, total)
    --  ชนกฎจำนวนสูงสุดของทาวเวอร์ชนิดนั้นแล้ว ยิงไปก็โดนปฏิเสธแน่นอน
    --  ข้ามทันทีดีกว่าเสียเวลาลองสี่ครั้ง แล้วไปกินจังหวะของคำสั่งข้างหลัง
    --  ลิมิตอ่านจากโมดูลของเกมได้เลย (Stats.Default.Defaults.Limit)
    --  ไม่ต้องรอให้ถูกปฏิเสธหนึ่งครั้งก่อนถึงจะรู้เหมือนเมื่อก่อน
    if a.type == "place" and a.tower and towerLimit[a.tower] == nil then
        local d = towerDefaults(a.tower)
        local lim = d and tonumber(d.Limit)
        if lim and lim > 0 then
            towerLimit[a.tower] = lim
        end
    end

    if a.type == "place" and a.tower and towerLimit[a.tower] then
        local have = countOfType(a.tower)
        if have >= towerLimit[a.tower] then
            lastReply = ("hit the %s limit of %d")
                :format(a.tower, towerLimit[a.tower])
            a.impossible = true
            return false
        end
    end

    --  ทาวเวอร์ที่วางไม่ขึ้นตั้งแต่แรก คำสั่งที่อ้างถึงมันไม่มีวันสำเร็จ
    --  ต้องข้ามทันที ไม่ใช่วนลองอีก 45 วินาทีแล้วค่อยยอมแพ้
    --  จุดนี้แหละที่ทำให้มาโครช้าและอัปเกรดหายเป็นแถบ
    if NEEDS_REF[a.type] then
        local m = refModel[a.ref]
        if not (m and m.Parent) then
            --  ยังไม่ยอมแพ้ทันที ลองตามหาจากตำแหน่งที่อัดไว้ก่อน
            --  ทาวเวอร์อาจถูกวางสำเร็จจริงแต่เราจับคู่ไม่ได้ตอนนั้น
            m = recoverRef(a.ref)
            if not m then
                --  ขายของที่ไม่มีอยู่ = ผลลัพธ์ตรงกับที่ต้องการอยู่แล้ว
                return a.type == "sell", true
            end
        end
    end

    --  ซ่อมราคาที่อัดไว้ให้ตรงกับความจริง แล้วบันทึกทับตอนจบ
    --
    --  ไฟล์ที่เล่นด้วยรุ่นก่อนหน้ามีราคาเพี้ยนติดอยู่ (เช่น Scout 81 ทั้งที่ราคา 250)
    --  ต่อให้ตอนนี้เราไม่ใช้เลขนั้นแล้ว ก็ควรล้างให้หมด ไม่ปล่อยข้อมูลผิดค้างในไฟล์
    --  อัปเกรดไม่เขียนทับ a.cost ด้วยราคาจากโมดูล
    --
    --  เคยเขียนทับแล้วเกิดสงคราม: ตอนเริ่มคำสั่งเขียน 2400 ทับ 2040
    --  พอจ่ายเสร็จตัววัด @TotalSpent ก็เขียน 2040 ทับกลับ วนแบบนี้ทุกคำสั่ง
    --  รอบเดียวแก้ไป 97 รายการแล้วบันทึกไฟล์ใหม่ทุกครั้งที่เล่น ทั้งที่ไม่มีอะไรผิด
    --  สองค่านี้ไม่ได้ขัดกัน — อันหนึ่งคือราคาป้าย อีกอันคือเงินที่จ่ายจริงหลังหักส่วนลด
    --  เก็บ "เงินที่จ่ายจริง" ไว้ในไฟล์อย่างเดียว ส่วนราคาป้ายอ่านสดตอนใช้งานพอ
    if a.type == "upgrade" then

    elseif a.type == "place" then
        local info = slotInfo(a.slot)
        local live = (info and info.cost and info.cost > 0) and info.cost or nil
        if live and live ~= (a.cost or 0) then
            a.cost = live
            costFixed = costFixed + 1
        end
    end

    --  เก็บรายชื่อทาวเวอร์ก่อนเริ่ม ครั้งเดียวต่อคำสั่ง ไม่ใช่ต่อครั้งที่ลอง
    --  ถ้าเก็บใหม่ทุกครั้ง ตัวที่ครั้งก่อนวางสำเร็จแต่เราตรวจไม่ทันเวลา
    --  จะถูกมองว่าเป็นของเก่า แล้วเราจะสั่งวางซ้ำอีกใบ เปลืองเงินและชนลิมิต
    local before
    if a.type == "place" then
        before = {}
        local f = towersFolder()
        if f then
            for _, m in ipairs(f:GetChildren()) do before[m] = true end
        end
    end

    --  จำกัดจำนวน "ครั้งที่ลองจริง" ด้วย ไม่ใช่จำกัดแค่เวลา
    --
    --  การรอเงินหรือรอคูลดาวน์ไม่นับเป็นการลอง ดังนั้นถ้าลองจริงไปหลายครั้ง
    --  ในสภาพที่เงินพอและไม่ติดคูลดาวน์แล้วยังไม่สำเร็จ แปลว่าติดเหตุผลถาวร
    --  เช่นจุดนั้นมีของวางอยู่แล้ว หรือชนลิมิตจำนวนทาวเวอร์ชนิดนั้น
    --  ลองต่อไปจนครบ 45 วินาทีก็ไม่มีทางสำเร็จ มีแต่ทำให้คำสั่งข้างหลังพลาดจังหวะ
    --  โดยเฉพาะโหวตข้ามเวฟที่มีหน้าต่างเวลาจำกัด
    --  อัปเกรดต้องใจเย็นกว่าคำสั่งอื่น
    --
    --  การวางล้มเหลวมักเป็นเหตุผลถาวร (จุดมีของ ชนลิมิต) ลองมากก็เสียเวลาเปล่า
    --  แต่อัปเกรดล้มเหลวเกือบทั้งหมดคือ "เงินยังไม่พอ" ซึ่งเดี๋ยวก็พอ
    --  ให้โควตาเท่ากันจึงไม่ยุติธรรมกับอัปเกรด และเป็นเหตุที่มันหลุดบ่อย
    local MAX_TRIES = (a.type == "upgrade") and 8 or 4

    --  ราคาที่อัดไว้เชื่อไม่ได้ 100%
    --
    --  มาโครที่อัดไว้ก่อนหน้านี้วัดราคาอัปเกรดด้วยการอ่านยอดหลังหน่วงเวลา
    --  ถ้าตอนอัดรัวอัปเกรดตัวเดียวกันหลายครั้ง ราคาครั้งแรกจะกลายเป็น
    --  ยอดรวมของทั้งชุด สูงเกินจริงหลายเท่า แล้วมาโครจะนั่งรอเงินที่ไม่เคยต้องใช้
    --  จนกว่าจะบังเอิญมีเงินถึงยอดนั้นจริงๆ ซึ่งมักเป็นช่วงท้ายเกม
    --
    --  ทางแก้: รอเงินได้ แต่รอนานเกินนี้แล้วให้ลองยิงดูสักครั้ง
    --  ถ้าราคาที่จดไว้ผิดจริง คำสั่งจะผ่าน แล้วเราจะแก้ตัวเลขให้เองด้านล่าง
    --  ถ้าเงินไม่พอจริง เซิร์ฟเวอร์ก็แค่ปฏิเสธ ไม่มีอะไรเสียหาย
    --  อัปเกรดขั้นท้ายๆ ราคาหลักพัน กว่าฟาร์มจะปั๊มถึงใช้เวลานาน
    --  รอ 12 วินาทีแล้วยิงทิ้งคือการรบกวนเปล่าๆ ในกรณีที่ราคาที่จดไว้ถูกอยู่แล้ว
    local CASH_PATIENCE = (a.type == "upgrade") and 20 or 12

    local tries    = 0
    local tried    = 0                              -- เวลาที่ใช้ลองจริงเท่านั้น
    local refusals = 0                              -- โดนปฏิเสธแบบชัดเจนกี่ครั้ง
    local waited   = 0                              -- รอเงินมานานแค่ไหนแล้ว
    local lastHold = nil
    local hardStop = os.clock() + actionTimeout * 4 -- กันค้างถาวรถ้าเงื่อนไขไม่มาสักที

    while playing and tries < MAX_TRIES
        and tried < actionTimeout and os.clock() < hardStop do
        local hold = holdReason(a, idx, total, tries)

        --  รอเงินมานานเกินไปแล้ว ให้โอกาสยิงหนึ่งครั้งเพื่อพิสูจน์ว่าราคาที่จดไว้ถูกไหม
        if hold and waited >= CASH_PATIENCE then
            waited = 0
            hold = nil
        end

        if hold then
            --  จดเฉพาะตอนเหตุผลเปลี่ยน ไม่งั้นบันทึกจะท่วมด้วยบรรทัดเดิมซ้ำๆ
            if hold ~= lastHold then
                lastHold = hold
            end
            status = hold
            waited = waited + 0.3
            task.wait(0.3)
        else
            lastHold = nil
            tries = tries + 1
            status = T("DOING", idx, total, actionLabel(a),
                tries > 1 and T("ATTEMPT", tries) or "")

            local t0 = os.clock()
            lastReply = ""
            local ok, refused = tryOnce(a, before, tries)
            local spent = os.clock() - t0
            tried = tried + spent

            --  ⚠ พลาดเพราะเงินไม่พอ ห้ามกินโควตาการลอง
            --
            --  นี่คือสาเหตุที่อัปเกรดหลุดบ่อย
            --  รอเงินครบ 12 วินาทีทีไร ระบบจะบังคับยิงหนึ่งครั้งเพื่อพิสูจน์ราคา
            --  ถ้าเงินไม่พอจริง มันก็แค่พลาด แต่โควตาถูกหักไปหนึ่ง
            --  ครบสี่ครั้ง (ราวหนึ่งนาที) ก็ยอมแพ้ ทั้งที่แค่ยังเก็บเงินไม่พอ
            --  ทาวเวอร์ตัวนั้นเลยค้างอยู่ระดับเดิมไปตลอดทั้งเกม
            --
            --  เงินไม่พอคือ "ยังไม่ถึงเวลา" ไม่ใช่ "ทำไม่ได้" คืนโควตาให้
            if not ok and type(lastReply) == "string" and lastReply ~= "" then
                local low = lastReply:lower()
                if low:find("need", 1, true) or low:find("more", 1, true)
                    or low:find("afford", 1, true) or low:find("cash", 1, true)
                    or low:find("money", 1, true) then
                    tries    = tries - 1
                    tried    = math.max(tried - spent, 0)
                    refusals = 0
                    waited   = 0        -- กลับไปรอเงินต่อ อย่าเพิ่งยิงซ้ำทันที
                end
            end

            --  ได้ราคาจริงจากเซิร์ฟเวอร์มาแล้ว ใช้ตัวนี้ก่อนเสมอ
            --
            --  ราคาอัปเกรดที่อัดไว้เพี้ยนได้ง่ายมาก ตอนอัดถ้ารัวอัปเกรดตัวเดียวกัน
            --  หลายครั้งติดกัน ราคาครั้งแรกจะกลายเป็นยอดรวมของทั้งชุด
            --  จากบันทึกรอบที่แล้ว: จด 2500 แต่จ่ายจริงราว 1300, จด 3240 จ่ายจริงราว 2500
            --  ส่วนต่างนั้นแปลว่ามาโครนั่งรอเงินที่ไม่เคยต้องใช้ ครั้งละ 12-20 วินาที
            --  รอบที่แล้วเสียไปแบบนี้ 7 ครั้ง รวมราวร้อยวินาที
            --
            --  แก้ตรงนี้แล้วบันทึกทับตอนจบ รอบหน้าจะไม่เจอชุดนี้อีกเลย
            local paid = paidOf[a]
            paidOf[a] = nil
            if ok and paid and paid ~= (a.cost or 0) then
                a.cost = paid
                costFixed = costFixed + 1
            end

            --  เคยมีทางที่สามอยู่ตรงนี้: เดาราคาจากยอดเงินก่อน-หลัง
            --
            --  ถอดออกแล้วเพราะมันเป็นตัวที่ทำไฟล์มาโครพัง ป้ายเงินมาช้ากว่าความจริง
            --  และฟาร์มก็จ่ายเงินเข้ามาตลอดเวลา ลบกันแล้วได้ 81 ทั้งที่ Scout ราคา 250
            --  แล้วเลขผิดนั้นถูกบันทึกทับลงไฟล์ กลายเป็นความเสียหายถาวร
            --
            --  ตอนนี้ราคาทุกชนิดมาจากแหล่งที่เชื่อได้แล้ว ไม่ต้องเดาอีก:
            --    อัปเกรด  @TotalSpent ของทาวเวอร์ + ตารางราคาในโมดูลเกม
            --    วาง      ราคาสดจากช่องทาวเวอร์ในเกม

            --  ถูกปฏิเสธแบบชัดเจนสองครั้งติด = เหตุผลถาวร (จุดนั้นมีของ / ชนลิมิต)
            --  ยิงต่อไม่มีทางสำเร็จ
            if refused then
                refusals = refusals + 1
                if refusals >= 2 then
                    break
                end
            end
            if ok then return true end

            task.wait(cmdDelay)
            tried = tried + cmdDelay
        end
    end

    return false
end

--  ── สายสกิล ───────────────────────────────────────────────
--
--  สกิลถูกแยกออกมาจากคิวหลัก เพราะสองอย่างนี้ต้องการคนละอย่าง
--    คำสั่งอื่น  สำคัญที่ "ลำดับ" — ต้องวางก่อนถึงจะอัปเกรดได้
--    สกิล        สำคัญที่ "จังหวะ" — กดตอนบอสออก ไม่ใช่กดเมื่อถึงคิว
--
--  ถ้าอยู่คิวเดียวกัน การรอจังหวะกดสกิลจะไปหน่วงการอัปเกรดที่ควรทำได้เลย
--  และการรีบทำตามคิวก็จะทำให้สกิลถูกกดก่อนบอสออก ซึ่งเสียเปล่าทั้งคู่
--
--  จังหวะยึดจาก "วินาทีที่เท่าไหร่ของเวฟนั้น" ไม่ใช่เวลารวมตั้งแต่เริ่มเกม
--  เพราะตอนเล่นซ้ำเวลารวมเลื่อนเสมอจากการรอเงินและรอโหวต
local waveStart = {}       -- เวฟ → os.clock ตอนที่เวฟนั้นเริ่ม (ระหว่างเล่น)

local function watchWavesWhilePlaying()
    task.spawn(function()
        local last = getWave()
        waveStart[last] = os.clock()
        while playing do
            local w = getWave()
            if w ~= last then
                last = w
                waveStart[w] = os.clock()
            end
            task.wait(0.2)
        end
    end)
end

--  บัฟที่ยังทำงานอยู่จะนับถอยหลังใน @Ammo (เห็นชัดใน log ของ Commander: 10 → 0)
--  ทาวเวอร์ที่ไม่ได้ใช้ระบบนี้จะมี @MaxAmmo = 0 เช่น DJ Booth
local function buffRunning(m)
    local r = rep(m)
    if not r then return false end
    local maxA = tonumber(r:GetAttribute("MaxAmmo")) or 0
    local now  = tonumber(r:GetAttribute("Ammo")) or 0
    return maxA > 0 and now > 0
end

--  บัฟของทาวเวอร์ชนิดเดียวกัน "ตัวไหนก็ได้" ยังทำงานอยู่ไหม
--
--  เดิมผมเช็คแค่ตัวที่กำลังจะกด ซึ่งผิดโจทย์ — ปัญหาไม่ใช่กดตัวเดิมซ้ำ
--  แต่คือกด Commander ตัวที่ 2 ตอนบัฟของตัวที่ 1 ยังอยู่ เกมนี้บัฟทับกันไม่ได้
--  ตัวที่กดทีหลังจึงเสียเปล่า ต้องรอให้ของทุกตัวหมดก่อนถึงจะกดตัวถัดไป
--
--  ดูจากค่าจริงในเกม ไม่ใช่นับเวลาเอง คูลดาวน์จะเร็วหรือช้ากว่าปกติก็ยังถูก
local function anyBuffRunning(name)
    local f = towersFolder()
    if not (f and name) then return false end
    for _, m in ipairs(f:GetChildren()) do
        if isMine(m) and tName(m) == name and buffRunning(m) then
            return true
        end
    end
    return false
end

local function runAbilityTrack(list)
    for _, a in ipairs(list) do
        if not playing then break end

        --  รอให้ถึงเวฟของสกิลนี้ก่อน
        while playing and getWave() < (a.wave or 0) do task.wait(0.3) end
        if not playing then break end

        --  ต้องหาทาวเวอร์ให้เจอก่อน เพราะการรอ "บอสเข้าระยะ" ต้องรู้ว่าวัดจากตรงไหน
        --  ทาวเวอร์อาจยังไม่ถูกวางโดยสายหลัก รอสักพักแล้วลองตามหา
        local m = refModel[a.ref]
        if not (m and m.Parent) then
            local until_ = os.clock() + 10
            repeat
                task.wait(0.3)
                m = refModel[a.ref] or recoverRef(a.ref)
            until (m and m.Parent) or not playing or os.clock() > until_
        end

        --  ตอนอัดกดตอนบอสอยู่ในสนาม → รอ "บอสเข้าระยะ" ก่อน
        --
        --  แค่บอสโผล่ยังไม่พอ ตอนบอสเพิ่งเกิดมันอยู่ท้ายทางเดิน ห่างเป็นสิบสตัด
        --  ยิงคลื่นเสียงตอนนั้นคือทิ้งคูลดาวน์เปล่าๆ กว่าบอสจะเดินมาถึงก็หมดฤทธิ์แล้ว
        --
        --  ระยะอ่านจาก @Range ซึ่งเป็นค่าสดตามระดับปัจจุบัน (รวมบัฟระยะด้วย)
        --  ตำแหน่งบอสอ่านจากโมเดลจริงในโลก ทั้งสองอย่างเปลี่ยนตามเวลาได้อิสระ
        --  จึงเช็คใหม่ทุกรอบ ไม่ได้คำนวณครั้งเดียวแล้วจำไว้
        --
        --  ถ้าอ่านระยะไม่ได้ (เกมเปลี่ยนโครงสร้าง) ถอยไปใช้เกณฑ์เดิมคือ "บอสโผล่"
        --  ดีกว่าไม่ยิงเลยเพราะรอเงื่อนไขที่ไม่มีวันอ่านได้
        if abilityTiming and a.boss and getWave() == a.wave then
            --  "อ่านระยะได้ไหม" ต้องดูที่ @Range ของทาวเวอร์อย่างเดียว
            --
            --  รอบที่แล้วผมเช็คด้วย bossInRange(m) ~= nil ซึ่งผิด
            --  ฟังก์ชันนั้นคืน nil ทั้งตอน "อ่านระยะไม่ได้" และตอน "ยังไม่มีบอสในสนาม"
            --  พอเช็คตอนเวฟเพิ่งเริ่มซึ่งบอสยังไม่เกิด มันเลยสรุปว่าอ่านระยะไม่ได้ทุกครั้ง
            --  แล้วถอยไปใช้เกณฑ์เดิมตลอด — ฟีเจอร์ระยะจึงไม่เคยได้ทำงานเลยสักครั้ง
            local canRange = (m and m.Parent) and tRange(m) ~= nil

            if canRange then
                local inR, d, rng = bossInRange(m)
                if not inR then

                    local until_ = os.clock() + 150
                    while playing and getWave() == a.wave and os.clock() < until_ do
                        if bossInRange(m) then break end
                        task.wait(0.15)
                    end

                end

            elseif not bossOnField() then
                local until_ = os.clock() + 120
                while playing and not bossOnField() and getWave() == a.wave
                    and os.clock() < until_ do
                    task.wait(0.2)
                end
            end
        end

        --  รอให้ถึงวินาทีเดียวกับตอนอัด นับจากต้นเวฟนั้น
        --  เวฟผ่านไปแล้วก็ไม่ต้องรอ ยิงเลยดีกว่าไม่ได้ยิง
        if abilityTiming and a.tw and not a.boss and getWave() == a.wave then
            local st = waveStart[a.wave]
            if st then
                while playing do
                    local into = os.clock() - st
                    if into >= a.tw or getWave() > a.wave then break end
                    task.wait(0.15)
                end
            end
        end
        if not playing then break end

        --  ตั้งตัวเลือกให้ตรงกับตอนอัดก่อนยิง
        --
        --  คำสั่งเลือกตัวเลือกอยู่ในคิวหลัก ส่วนสกิลอยู่คนละสาย
        --  ไม่มีอะไรรับประกันว่าคิวหลักจะตั้งทันก่อนสกิลถึงเวลายิง
        --  ถ้าไม่ตรงก็ตั้งเองตรงนี้เลย ดีกว่ายิงไปแล้วได้เอฟเฟกต์ผิดตัว
        --  ทาวเวอร์ยังอัปเกรดไม่ถึงระดับที่สกิลนี้ต้องการ กดไปก็ไม่มีอะไรเกิด
        --  โมดูลเกมบอกระดับไว้ (เช่น Red Track ต้อง Level 2) ใช้ข้อมูลนั้นเลย
        if m and m.Parent then
            local need
            local d = towerDefaults(tName(m))
            for _, ab in ipairs((d and d.Abilities) or {}) do
                if ab.Name == a.name then need = tonumber(ab.Level) end
            end
            if need and need > 0 and tLevel(m) < need then
                m = nil
            end
        end

        if m and m.Parent and a.opts then
            local okDecode, want = pcall(function()
                return HttpService:JSONDecode(a.opts)
            end)

            if okDecode and type(want) == "table" then
                for k, v in pairs(want) do
                    if not playing then break end

                    local r0 = rep(m)
                    local raw = r0 and r0:GetAttribute("Options")
                    local cur
                    if type(raw) == "string" and raw ~= "" then
                        local ok2, t = pcall(function() return HttpService:JSONDecode(raw) end)
                        cur = (ok2 and type(t) == "table") and t[k] or nil
                    end

                    if cur ~= v then
                        pcall(cmdOption, m, k, v)

                        --  รอให้ผลมาถึงก่อน ไม่งั้นยิงตอนตัวเลือกยังไม่เปลี่ยน
                        local until_ = os.clock() + 3
                        while playing and os.clock() < until_ do
                            local r1 = rep(m)
                            local raw1 = r1 and r1:GetAttribute("Options")
                            if type(raw1) == "string" and raw1:find(tostring(v), 1, true) then
                                break
                            end
                            task.wait(0.1)
                        end
                    end
                end
            end
        end

        if m and m.Parent then
            --  รอให้บัฟของทาวเวอร์ชนิดเดียวกัน "ทุกตัว" หมดก่อน
            --  นี่คือการหมุนบัฟของ Commander — กดตัวที่ 2 ตอนบัฟตัวที่ 1 ยังอยู่
            --  ไม่ได้ทำให้บัฟแรงขึ้น แต่ทำให้ตัวที่ 2 เสียเปล่าไปเลย
            local kind = tName(m)
            local waitBuff = os.clock() + 60
            while playing and anyBuffRunning(kind) and os.clock() < waitBuff do
                task.wait(0.3)
            end

            pcall(cmdAbility, m, a.name, unpackValue(a.data))
        end
    end
end

--  โหวตข้ามเวฟแยกไปวิ่งสายของตัวเอง
--
--  เดิมการโหวตอยู่ในคิวหลัก พอเซิร์ฟเวอร์ไม่รับ มาโครจะยืนส่งซ้ำอยู่ 15 วินาที
--  โดยที่การวางและอัปเกรดทั้งหมดหยุดรออยู่ข้างหลัง เงินกองอยู่แต่ไม่ได้ใช้
--  ทั้งที่การข้ามเวฟไม่ได้เป็นเงื่อนไขของคำสั่งไหนเลย — คำสั่งถัดไปดูที่เลขเวฟ
--  ซึ่งเดินเองอยู่แล้วไม่ว่าจะโหวตติดหรือไม่
--
--  ผลคือรอบที่โหวตพลาด อัปเกรดที่ควรได้ในเวฟนั้นถูกเบียดไปเวฟถัดไป
--  บางตัวจึงค้างอยู่ระดับต่ำกว่าที่อัดไว้จนจบเกม
--
--  แยกออกมาแล้วสองอย่างนี้ไม่แย่งเวลากัน และยังส่งซ้ำได้นานขึ้นด้วย
local function runSkipTrack(list)
    for _, a in ipairs(list) do
        if not playing then break end

        --  รอให้ถึงเวฟที่อัดไว้ก่อน — รอเสมอ ไม่ว่าจะปิด "รอถึงเวฟ" ไว้หรือไม่
        --
        --  ปิด "รอถึงเวฟ" คือบอกว่า "มีเงินแล้ววางเลย ไม่ต้องรอเวฟ" ซึ่งเร่งเกมได้จริง
        --  แต่การโหวตไม่มีอะไรให้เร่ง โหวตข้ามเวฟ 12 ตอนเกมอยู่เวฟ 10
        --  ไม่ได้ทำให้เร็วขึ้น มันไปตกในรอบของเวฟ 10 แทน = เสียโหวตทิ้งเปล่า
        --
        --  และการรอตรงนี้ไม่ได้ถ่วงใคร เพราะอยู่คนละสายกับคิวหลักแล้ว
        while playing and getWave() < (a.wave or 0) do task.wait(0.3) end
        if not playing then break end

        --  เรียก tryOnce ตรงๆ ไม่ผ่าน runAction เพราะ runAction เป็นตัวจัดการ
        --  งบเวลา/การรอเงิน/การลองซ้ำของ "คิวหลัก" ซึ่งการโหวตไม่ต้องใช้เลย
        --  ตัวการส่งซ้ำอยู่ในบล็อก skip ของ tryOnce อยู่แล้ว
        pcall(tryOnce, a, nil, 1)
    end
end

-- ── หมุนบัฟอัตโนมัติ ──────────────────────────────────────
--
--  ต่างจากมาโครตรงที่ไม่ได้เล่นตามที่อัดไว้ แต่วนกดเองไม่รู้จบ
--  เหมาะกับทาวเวอร์บัฟอย่าง Commander ที่วางหลายตัวแล้วต้องหมุนกันไปเรื่อยๆ
--
--  ชื่อสกิลไม่ได้ฝังไว้ในโค้ด — ดึงจากมาโครที่โหลดอยู่
--  มาโครบอกอยู่แล้วว่าทาวเวอร์ชนิดไหนใช้สกิลชื่ออะไร ไม่ต้องให้ผู้ใช้มากรอกเอง
--  และถ้าเกมเปลี่ยนชื่อสกิล อัดใหม่ครั้งเดียวก็ตามทัน
--  ทาวเวอร์ชนิดไหนมีสกิลอะไรบ้าง — ดึงจากมาโครที่โหลดอยู่
--  ไม่ฝังชื่อไว้ในโค้ด เกมเปลี่ยนชื่อสกิลเมื่อไหร่ อัดใหม่ครั้งเดียวก็ตามทัน
--  ทาวเวอร์ชนิดไหนมีสกิลชื่ออะไรบ้าง — เก็บ "ทุกชื่อ" ไม่ใช่ชื่อเดียว
--
--  Commander มีสองสกิล: Call Of Arms (บัฟ) กับ Support Caravan (เรียกรถถัง 2000฿)
--  ถ้าเก็บชื่อเดียวแล้วบังเอิญได้ Support Caravan ระบบหมุนจะเผาเงินรอบละ 2000
local function abilityNamesOf(kind)
    local out, seen = {}, {}
    if not (macro and kind) then return out end

    local placeName = {}
    for _, a in ipairs(macro.actions) do
        if a.type == "place" and a.ref then placeName[a.ref] = a.tower end
    end
    for _, a in ipairs(macro.actions) do
        if a.type == "ability" and a.name and placeName[a.ref] == kind
            and not seen[a.name] then
            seen[a.name] = true
            table.insert(out, a.name)
        end
    end

    --  มาโครที่อัดตอนเปิดหมุนบัฟไว้จะไม่มี action สกิลเลย
    --  เพราะการกดของเราเองถูกกรองออกด้วย checkcaller() ต้องอ่านจากที่จดไว้แทน
    --
    --  ต้องกันสตริงว่างด้วย มาโครรุ่นเก่าจด ability = "" ติดไปทุกไฟล์
    --  (ตัวแปรต้นทางไม่เคยถูกกำหนดค่าเลย) ถ้าปล่อยผ่าน ระบบหมุนบัฟจะได้ชื่อสกิลว่าง
    --  ไปไว้หัวรายการ แล้วเสียรอบไปหนึ่งครั้งกับการยิงสกิลที่ไม่มีอยู่จริง
    local saved = macro.autoBuff and macro.autoBuff.kind == kind
        and macro.autoBuff.ability
    if type(saved) == "string" and saved ~= "" and not seen[saved] then
        table.insert(out, 1, saved)
    end
    return out
end

--  ชนิดทาวเวอร์ที่มีสกิลอัดไว้ เอาไว้เดาว่าจะหมุนของอะไร
local function kindsWithAbility()
    local out, seen = {}, {}
    if not macro then return out end

    local placeName = {}
    for _, a in ipairs(macro.actions) do
        if a.type == "place" and a.ref then placeName[a.ref] = a.tower end
    end
    for _, a in ipairs(macro.actions) do
        local kind = a.type == "ability" and placeName[a.ref]
        if kind and not seen[kind] then
            seen[kind] = true
            table.insert(out, kind)
        end
    end
    if macro.autoBuff and macro.autoBuff.kind and not seen[macro.autoBuff.kind] then
        table.insert(out, macro.autoBuff.kind)
    end
    return out
end


--  เรียงตามลำดับที่วาง (@CreatedAt) ไม่ใช่ลำดับใน workspace
--  ลำดับใน workspace เปลี่ยนได้เมื่อมีตัวถูกขายหรือถูกทำลาย
--  ถ้ายึดตามนั้น การหมุนจะสลับมั่วแล้วบางตัวไม่เคยได้กดเลย
local function towersOfType(kind)
    local f = towersFolder()
    local out = {}
    if not (f and kind) then return out end

    for _, m in ipairs(f:GetChildren()) do
        if isMine(m) and tName(m) == kind then table.insert(out, m) end
    end
    table.sort(out, function(x, y)
        local rx, ry = rep(x), rep(y)
        local ax = rx and tonumber(rx:GetAttribute("CreatedAt")) or 0
        local ay = ry and tonumber(ry:GetAttribute("CreatedAt")) or 0
        return ax < ay
    end)
    return out
end

--  หมุนบัฟของ "ชนิดเดียว" ที่ผู้ใช้เลือกไว้เท่านั้น
--
--  เดิมผมให้มันหมุนทุกชนิดที่มีสกิลในมาโคร ซึ่งผิด — สกิลของบางทาวเวอร์
--  ไม่ใช่บัฟ เช่น Drop The Beat ของ DJ Booth เป็นคลื่นดาเมจ
--  วนกดรัวไปเรื่อยๆ นอกจากไม่ได้ประโยชน์ยังทิ้งคูลดาวน์ทุกครั้งที่บอสยังไม่มา
--
--  และบัฟที่ให้สถานะเดียวกันจะไม่ทับกัน ตัวที่กดก่อนชนะเสมอ
--  ในเกมไม่มีข้อมูลบอกว่าบัฟไหนเป็นสถานะเดียวกัน จึงเดาไม่ได้
--  ให้ผู้ใช้เลือกชนิดเดียวชัดๆ ปลอดภัยกว่าให้สคริปต์เดาแล้วกดชนกันเอง
--  สกิลไหนของชนิดนี้เป็น "บัฟ" จริง — เรียนรู้จากการลองจริง
--
--  Commander มีสองสกิล แต่มีตัวเดียวที่ทำให้ @Ammo ขึ้น
--  อีกตัว (Support Caravan) เรียกรถถังและเสียเงิน 2000 ทุกครั้ง
--  ทดสอบครั้งเดียวแล้วจำไว้ ไม่ต้องให้ผู้ใช้มาบอกและไม่ฝังชื่อไว้ในโค้ด
--  ต้องมีหลักฐานหลายครั้งก่อนตัดสิน ไม่ใช่ครั้งเดียวจบ
--
--  รอบที่แล้ว "Call Of Arms" (ซึ่งเป็นบัฟตัวจริงของ Commander) ถูกตัดออกทันที
--  ตั้งแต่ครั้งแรกที่ยิงไม่ขึ้น แล้วระบบหมุนบัฟก็ตายไปทั้งเกมเพราะไม่เหลือสกิลให้กด
--  สาเหตุที่ยิงไม่ขึ้นไม่ใช่ว่ามันไม่ใช่บัฟ แต่เป็นเพราะมีลูปซ้อนกันสองตัวยิงพร้อมกัน
--  บัฟสถานะเดียวกันทับกันไม่ได้ ตัวที่ยิงทีหลังจึงไม่เกิดผล แล้วถูกตีความว่า "ไม่ใช่บัฟ"
--
--  การตัดสินผิดครั้งเดียวมีราคาสูงมาก (เสียบัฟทั้งเกม) ส่วนการลองเกินไปสองสามครั้ง
--  แทบไม่เสียอะไรเลย เกณฑ์จึงต้องเอียงไปทาง "ให้โอกาส"
local notBuff  = {}      -- ชื่อสกิล → true เมื่อพิสูจน์แล้วว่าไม่ใช่บัฟ
local buffMiss = {}      -- ชื่อสกิล → ยิงแล้วไม่ขึ้นมากี่ครั้ง
local BUFF_STRIKES = 3

--  กันลูปหมุนบัฟซ้อนกัน
--
--  ปิดแล้วเปิดใหม่เร็วๆ ทำให้ลูปเก่ายังไม่ทันเห็นว่า autoBuff เป็น false
--  (มันติดอยู่ในช่วงรอบัฟหมด ซึ่งรอได้ถึง 90 วินาที) พอเปิดใหม่ก็มีลูปที่สอง
--  แล้วสองตัวจะยิงชนกันเอง — ซึ่งเป็นต้นเหตุที่ Call Of Arms ถูกตัดออก
--  เลขรุ่นทำให้ลูปเก่ารู้ตัวและออกทันทีในรอบถัดไป ไม่ว่าจะค้างอยู่ตรงไหน
local buffGen = 0

--  รวมรายชื่อสกิลที่จะลอง: เอาจากโมดูลเกมก่อน ไม่มีค่อยใช้ของที่อัดไว้
local function buffCandidates(kind)
    local out, seen = {}, {}
    for _, ab in ipairs(freeAbilities(kind)) do
        if not seen[ab.name] then
            seen[ab.name] = true
            table.insert(out, ab)
        end
    end
    for _, n in ipairs(abilityNamesOf(kind)) do
        if not seen[n] then
            seen[n] = true
            table.insert(out, { name = n, level = 0 })
        end
    end
    return out
end

--  เลือกชนิดที่จะหมุนจากสภาพสนาม "ตอนนี้"
--
--  ต้องเลือกใหม่ทุกรอบ ไม่ใช่เลือกครั้งเดียวตอนกดสวิตช์
--
--  อาการที่เจอ: เปิดสวิตช์ค้างไว้ก่อนแล้วค่อยวาง Commander → ระบบไม่หมุนให้เลย
--  ต้องปิดแล้วเปิดใหม่ถึงจะทำงาน สาเหตุคือตอนกดเปิด สนามยังไม่มี Commander
--  มันเลยถอยไปหยิบชนิดจากมาโครที่โหลดไว้ ซึ่งได้ DJ Booth มา (มาโครมีสกิล DJ อยู่)
--  แล้วค่านั้นค้างอยู่ตลอด ต่อให้วาง Commander ทีหลังก็ไม่มีใครไปแก้ให้
--
--  เลือกใหม่ทุกรอบแก้ได้หมดและไม่มีทางสลับไปมา เพราะกติกาตายตัว:
--  ของในสนามมาก่อนของในมาโคร และ Commander มาก่อนชนิดอื่นเสมอ
local function resolveBuffKind()
    --  มาโครจดไว้ว่าจะหมุนของชนิดไหน ให้ยึดตามนั้นเสมอ ห้ามเปลี่ยนใจเอง
    --
    --  log จริงรอบที่แล้ว: เวฟ 10 วาง DJ Booth ลงไปตอนที่ยังไม่มี Commander สักตัว
    --  ตัวเลือกอัตโนมัติเลยสลับไปหมุน DJ Booth แล้วรัวกด Drop The Beat สามครั้ง
    --  ซึ่งเป็นคลื่นดาเมจ ไม่ใช่บัฟ — ทิ้งคูลดาวน์ฟรีสามรอบตอนที่บอสยังไม่มา
    --  แล้วยังไปตัดชื่อสกิลนั้นทิ้งอีก ทั้งที่มันไม่เคยควรถูกหมุนตั้งแต่แรก
    --
    --  ผู้ใช้เลือกไว้แล้วตอนอัดว่าจะหมุน Commander การไปเดาใหม่ระหว่างเล่นมีแต่เสีย
    local want = macro and macro.autoBuff and macro.autoBuff.kind
    if type(want) == "string" and want ~= "" then return want end

    local pick = ""
    local f = towersFolder()
    local seen = {}
    if f then
        for _, m in ipairs(f:GetChildren()) do
            local k = isMine(m) and tName(m)
            if k and not seen[k] then
                seen[k] = true
                if #freeAbilities(k) > 0 then
                    if k == "Commander" then return k end
                    if pick == "" then pick = k end
                end
            end
        end
    end
    if pick ~= "" then return pick end

    --  ไม่เจอในสนาม ลองจากมาโครที่โหลดไว้
    for _, kind in ipairs(kindsWithAbility()) do
        if kind == "Commander" then return kind end
        if pick == "" then pick = kind end
    end
    return pick
end

local function autoBuffLoop()
    buffGen = buffGen + 1
    local myGen = buffGen

    task.spawn(function()
        while autoBuff and buffGen == myGen do
            --  เลือกชนิดใหม่ทุกรอบ เผื่อ Commander เพิ่งถูกวางลงสนาม
            local fresh = resolveBuffKind()
            if fresh ~= "" and fresh ~= buffKind then
                buffKind = fresh
                status = T("AUTOBUFF_ON", buffKind)
            end

            local kind = buffKind
            local list = (kind ~= "") and towersOfType(kind) or {}

            --  เลือกสกิลที่ยังไม่ถูกตัดออกว่าไม่ใช่บัฟ
            local ability, needLevel
            for _, ab in ipairs(buffCandidates(kind)) do
                if not notBuff[ab.name] then
                    ability, needLevel = ab.name, ab.level
                    break
                end
            end

            if #list == 0 or not ability then
                task.wait(2)
            else
                for _, m in ipairs(list) do
                    if not autoBuff or buffGen ~= myGen then break end

                    --  ยังอัปเกรดไม่ถึงระดับที่สกิลต้องการ กดไปก็ไม่มีอะไรเกิด
                    --  ข้ามไปเลย ไม่ต้องเสียเวลารอ 5 วินาทีเพื่อพบว่าบัฟไม่ขึ้น
                    if needLevel and needLevel > 0 and tLevel(m) < needLevel then
                        m = nil
                    end

                    if m and m.Parent then
                        --  1. รอให้บัฟของชนิดนี้หมดทุกตัวก่อน เกมนี้บัฟทับกันไม่ได้
                        --     กดซ้อนตอนตัวก่อนยังทำงาน ตัวที่กดทีหลังเสียเปล่า
                        local until_ = os.clock() + 90
                        while autoBuff and buffGen == myGen and anyBuffRunning(kind)
                            and os.clock() < until_ do
                            task.wait(0.2)
                        end
                        if not autoBuff or buffGen ~= myGen then break end

                        --  ยังมีบัฟค้างอยู่ทั้งที่รอจนหมดเวลา = ยิงตอนนี้เสียเปล่าแน่นอน
                        --  และถ้ายิงไป ผลที่ไม่ขึ้นจะถูกนับเป็นหลักฐานว่า "ไม่ใช่บัฟ" ทั้งที่ไม่ใช่
                        local blocked = anyBuffRunning(kind)

                        pcall(cmdAbility, m, ability, {})

                        --  2. รอให้บัฟ "ขึ้นจริง" ก่อนไปตัวถัดไป
                        --
                        --     จุดนี้คือที่พลาดมาตลอด: จากการจับเวลาจริง ค่า @Ammo
                        --     ใช้เวลา ~2 วินาทีกว่าจะเดินทางมาถึงฝั่งเรา
                        --     ถ้าเช็คเร็วกว่านั้นจะเห็น 0 แล้วเข้าใจว่าบัฟจบแล้ว
                        --     ทั้งที่ยังไม่เริ่มด้วยซ้ำ จึงยิงตัวถัดไปทันทีแล้วบัฟทับกัน
                        local wait5 = os.clock() + 5
                        while autoBuff and not buffRunning(m)
                            and os.clock() < wait5 do
                            task.wait(0.1)
                        end

                        --  3. ยิงแล้วบัฟไม่ขึ้น — อาจไม่ใช่สกิลบัฟ แต่ยังไม่ฟันธง
                        --
                        --     เหตุที่บัฟไม่ขึ้นมีได้หลายอย่างที่ไม่เกี่ยวกับตัวสกิลเลย
                        --     เช่นมีบัฟตัวอื่นค้างอยู่ หรือคูลดาวน์ยังไม่หมด
                        --     ต้องพลาดติดกันครบโควตาถึงจะตัดออก และไม่นับครั้งที่มีบัฟค้าง
                        if autoBuff and buffGen == myGen and not buffRunning(m) then
                            if not blocked then
                                buffMiss[ability] = (buffMiss[ability] or 0) + 1

                                if buffMiss[ability] >= BUFF_STRIKES then
                                    notBuff[ability] = true
                                    break
                                end
                            end
                        else
                            --  ขึ้นแล้ว = สกิลนี้ใช้ได้จริง ล้างประวัติพลาดทิ้ง
                            --  ไม่งั้นความพลาดที่กระจายอยู่คนละช่วงเกมจะสะสมจนตัดออกเอง
                            buffMiss[ability] = nil
                        end
                    end
                end
                task.wait(0.3)
            end
        end
    end)
end

local function playOnce()
    if not macro or #macro.actions == 0 then
        status = T("EMPTY_MACRO")
        return
    end

    refModel, modelRef, deadRef, refPos = {}, {}, {}, {}

    --  จดตำแหน่งของทุกคำสั่งวางไว้ก่อน เพื่อให้คำสั่งที่อ้างถึง ref นั้น
    --  ตามหาทาวเวอร์เองได้ทีหลัง แม้ตอนวางจะรายงานว่าพลาด
    for _, act in ipairs(macro.actions) do
        if act.type == "place" and act.ref and act.pos then
            refPos[act.ref] = {
                pos  = Vector3.new(act.pos[1], act.pos[2], act.pos[3]),
                name = act.tower,
            }
        end
    end

    --  แยกสกิลออกจากคิวหลัก แล้วปล่อยให้วิ่งขนานกันไป
    --  มาโครนี้อัดตอนเปิดหมุนบัฟไว้ → เปิดให้เองด้วยชนิดเดิม
    --  ผู้ใช้ไม่ต้องจำว่าตอนอัดเปิดอะไรไว้บ้าง
    --  บอกให้ชัดว่าไฟล์มาโครจดหมุนบัฟไว้จริงไหม
    --  ไม่งั้นแยกไม่ออกระหว่าง "ไฟล์ไม่ได้จด" กับ "จดแล้วแต่ผู้ใช้เปิดสวิตช์ไว้เองอยู่แล้ว"
    --  สองกรณีนี้ log หน้าตาเหมือนกันเป๊ะ แต่ต้องแก้คนละที่

    if macro.autoBuff and macro.autoBuff.kind then
        buffKind = macro.autoBuff.kind
        if not autoBuff then
            autoBuff = true
            autoBuffLoop()

            --  ติ๊กช่องใน UI ตามด้วย ไม่งั้นผู้ใช้เห็นช่องว่างทั้งที่มันกำลังหมุนอยู่
            --  แล้วจะกดปิดไม่ได้ เพราะกดครั้งแรกคือ "เปิด" ในสายตาของสวิตช์
            task.defer(function()
                uiSet(AutoBuffToggle, true)
            end)
        end
    end

    local mainList, abilityList, skipList = {}, {}, {}

    --  ชนิดที่ระบบหมุนบัฟดูแลอยู่ มาโครต้องไม่ไปกดซ้ำ ไม่งั้นจะแย่งกันเอง
    --  แล้วบัฟจะชนกันจนได้ผลแค่ตัวที่กดก่อน ซึ่งแย่กว่าไม่กดเลย
    local placeName = {}
    for _, a in ipairs(macro.actions) do
        if a.type == "place" and a.ref then placeName[a.ref] = a.tower end
    end

    for _, act in ipairs(macro.actions) do
        local handledByAuto = autoBuff and act.type == "ability"
            and placeName[act.ref] == buffKind

        if handledByAuto then
            --  ปล่อยให้ระบบหมุนบัฟจัดการ
        elseif act.type == "ability" and abilityTiming then
            table.insert(abilityList, act)
        elseif act.type == "skip" then
            --  การโหวตไม่ใช่เงื่อนไขของคำสั่งไหน ปล่อยให้วิ่งขนานไป
            --  จะได้ไม่ลากคิวหลักหยุดตามตอนเซิร์ฟเวอร์ยังไม่เปิดรับโหวต
            table.insert(skipList, act)
        else
            table.insert(mainList, act)
        end
    end

    --  FocusFarm — ขายฟาร์มที่เวฟสุดท้ายต้องรอเวฟนั้นจริงๆ
    --
    --  ปิด "รอถึงเวฟ" คือบอกว่า "มีเงินแล้วทำเลย" ซึ่งดีกับการวางและอัปเกรด
    --  แต่กับการขายฟาร์มทิ้งท้ายเกมมันตรงกันข้าม — ขายเร็วไปหนึ่งเวฟ
    --  เท่ากับทิ้งรายได้ทั้งเวฟนั้นไปฟรีๆ ในเวฟที่ฟาร์มทำเงินได้มากที่สุด
    --  (log จริง: อัดไว้ขายเวฟ 20 แต่ขายจริงตอนเวฟ 19 ทั้ง 10 ตัว)
    --
    --  เฉพาะฟาร์มและเฉพาะเวฟสุดท้ายเท่านั้น การขายอย่างอื่นหรือขายกลางเกม
    --  มักเป็นการขายเพื่อเอาเงินไปทำอย่างอื่นต่อ ซึ่งยิ่งเร็วยิ่งดี ไม่ควรไปหน่วง
    local focusSell = {}
    do
        local macroLast = 0
        for _, act in ipairs(macro.actions) do
            if (act.wave or 0) > macroLast then macroLast = act.wave end
        end
        local last = getWaveMax() or macroLast

        if last and last > 0 then
            for _, act in ipairs(macro.actions) do
                if act.type == "sell" and (act.wave or 0) >= last
                    and placeName[act.ref] == "Farm" then
                    focusSell[act] = true
                end
            end
        end

    end

    local playStart = os.clock()
    waveStart = {}
    failLog = {}
    costFixed, paidOf = 0, {}
    lastWalkTower = nil      -- รอบใหม่ เดินไปที่แรกอีกครั้ง
    --  เล่นต่อจากที่ค้างไว้ไหม
    --  เงื่อนไขต้องครบทุกข้อ: มาโครตัวเดิม จำนวนคำสั่งเท่าเดิม ด่านเดิม เวฟไม่ถอยหลัง
    --  ขาดข้อเดียวก็เริ่มใหม่ ปลอดภัยกว่าเล่นต่อผิดที่
    local startFrom = 1
    if resume and resume.name == macro.name
        and resume.count == #mainList
        and resume.map == getMapName()
        and getWave() >= (resume.wave or 0)
        and resume.index > 1 then

        startFrom = resume.index

        --  สกิลกับโหวตของเวฟที่ผ่านไปแล้วต้องตัดทิ้ง
        --  ไม่งั้นมันจะยิงสกิลของเวฟเก่ารัวทันทีที่เริ่ม เปลืองคูลดาวน์เปล่า
        local w = getWave()
        for _, list in ipairs({ abilityList, skipList }) do
            for i = #list, 1, -1 do
                if (list[i].wave or 0) < w then table.remove(list, i) end
            end
        end
    end
    resume = nil

    local total = #mainList
    local fails = 0

    watchWavesWhilePlaying()
    if #abilityList > 0 then
        task.spawn(function() pcall(runAbilityTrack, abilityList) end)
    end
    if #skipList > 0 then
        task.spawn(function() pcall(runSkipTrack, skipList) end)
    end

    for i = startFrom, #mainList do
        local a = mainList[i]

        --  ถูกสั่งหยุดกลางคัน — จดไว้ว่าค้างที่ไหน แล้วค่อยเล่นต่อรอบหน้า
        if not playing then
            resume = {
                name  = macro.name,
                index = i,
                count = #mainList,
                map   = getMapName(),
                wave  = getWave(),
            }
            break
        end


        -- รอให้ถึงเวฟที่อัดไว้
        --  FocusFarm บังคับรอเสมอ แม้ผู้ใช้จะปิด "รอถึงเวฟ" ไว้
        if (waveGate or focusSell[a]) and a.wave and a.wave > 0 then
            while playing and getWave() < a.wave do
                status = T("WAIT_WAVE", i, total, a.wave, getWave())
                task.wait(0.3)
            end
        end
        --  เล่นตามเวลาที่อัด — รอให้ถึงวินาทีเดียวกับตอนอัดก่อนค่อยทำ
        --  เหมาะกับสูตรที่ต้องกดให้ทันจังหวะ
        --
        --  ปิดไว้จะทำทันทีที่เงินพอ ซึ่งทนกว่าในกรณีทั่วไป เพราะรอบนี้เงินอาจ
        --  เข้าช้าหรือเร็วกว่าตอนอัด การยึดนาฬิกาจะกลายเป็นรอเก้อหรือยิงก่อนเงินมา
        if timedPlay and a.t then
            while playing do
                local left = a.t - (os.clock() - playStart)
                if left <= 0 then break end
                status = T("WAIT_TIME", i, total, left)
                task.wait(math.min(left, 0.3))
            end
        end
        if not playing then break end

        local actionAt = os.clock()
        local ok, wasDead = runAction(a, i, total)
        local spent = os.clock() - actionAt
        if not ok then
            --  จดไว้สรุปท้ายไฟล์ จะได้ไม่ต้องไล่อ่านทั้ง 800 บรรทัด
            table.insert(failLog, ("#%d %s%s\n      Server replied: %s\n      At the time: wave %d, cash %s, towers %s")
                :format(
                    i, actionLabel(a),
                    a.type == "place"
                        and (" " .. tostring(a.tower) ..
                             (" at (%.2f, %.2f, %.2f)"):format(a.pos[1], a.pos[2], a.pos[3]))
                        or "",
                    a.type == "place" and (lastReply ~= "" and lastReply or "-")
                        or (wasDead and "tower missing" or "retry timed out"),
                    getWave(),
                    getCash() and ("$" .. getCash()) or "unreadable",
                    towerBreakdown()))
            lastReply = ""

            fails = fails + 1
            lastError = wasDead
                and T("SKIPPED_DEP", i, actionLabel(a))
                --  บอกเวลาที่ใช้ไปจริง ไม่ใช่ค่าที่ตั้งไว้
                --  เดิมพิมพ์ 45 วินาทีเสมอ ทั้งที่บางครั้งยอมแพ้ตั้งแต่ 8 วินาที
                --  ทำให้เข้าใจผิดว่าติดอยู่นานกว่าความจริง
                or  T("SKIPPED", i, actionLabel(a), math.floor(spent + 0.5))
        end

        --  วางไม่ขึ้น = ทาวเวอร์ตัวนี้ไม่มีในสนาม
        --  จดไว้เพื่อให้คำสั่งที่อ้างถึงมันข้ามได้ทันที ไม่ต้องรอหมดเวลาทีละอัน
        if not ok and a.type == "place" then
            deadRef[a.ref] = true

            --  บอกด้วยว่าตอนนั้นในสนามมีทาวเวอร์กี่ตัว ช่วยแยกสองสาเหตุออกจากกัน
            --  จำนวนเพิ่ม = วางขึ้นจริงแต่เราจับคู่ไม่ได้
            --  จำนวนเท่าเดิม = เซิร์ฟเวอร์ปฏิเสธจริง (จุดนั้นมีของ หรือชนลิมิต)
            lastError = lastError .. T("PLACE_INFO", myTowerCount())
        end

        task.wait(cmdDelay)
    end

    --  ตัดคำสั่งที่พิสูจน์แล้วว่าเป็นไปไม่ได้ออกจากมาโครถาวร
    --
    --  มาโครที่อัดไว้ก่อนมีตัวตรวจตอนอัด ยังมีคำสั่งที่ผู้เล่นกดพลาดติดอยู่
    --  ปล่อยไว้ก็เสียเวลาทุกรอบที่เล่น เก็บกวาดให้เองดีกว่าให้ไปอัดใหม่ทั้งชุด
    local cleaned = 0
    for i = #macro.actions, 1, -1 do
        if macro.actions[i].impossible then
            table.remove(macro.actions, i)
            cleaned = cleaned + 1
        end
    end

    --  บันทึกราคาที่เรียนรู้ได้ลงไฟล์ ไม่งั้นความรู้นี้หายไปทุกรอบ
    --
    --  เดิมโค้ดแก้ a.cost ให้ถูกอยู่แล้วตอนเล่น แต่แก้แค่ในหน่วยความจำ
    --  พอเล่นรอบใหม่ก็โหลดเลขเก่าจากไฟล์กลับมา แล้วนั่งรอเงินซ้ำที่เดิมทุกครั้ง
    --  เท่ากับเรียนรู้แล้วลืมทันที
    if cleaned > 0 or costFixed > 0 then
        writeMacro(macro)
    end


    if playing then
        --  เล่นจนจบรายการแล้ว ไม่มีอะไรให้เล่นต่อ
        resume = nil
        status = fails == 0 and T("DONE_ALL", total) or T("DONE_SKIP", fails)
    end
end

local function startPlaying()
    if recording then status = T("REC_STOP") return false end

    --  อยู่ในห้องเลือกด่านก็เปิดสวิตช์ค้างไว้ได้ รอจนโหลดด่านจริงเสร็จค่อยเล่น
    if not inGame() and not inLobby() then
        status = T("NOT_IN_GAME")
        return false
    end
    if not macro or #macro.actions == 0 then
        status = T("NEED_CMDS")
        return false
    end

    local ok, msg = checkLoadout()
    loadoutMsg = msg
    if not ok then
        pcall(function()
            Notify("Loadout Mismatch", msg, "Warning", "solar/danger-triangle-bold", 8)
        end)
    end

    playing = true
    lastError = ""

    --  เปิดค้างไว้ = เล่นซ้ำเมื่อขึ้นแมตช์ใหม่
    --  เช็คจากเวฟที่ถอยกลับไปต้นเกม ไม่ใช่วนทันที เพราะการวนทันทีจะไปวาง
    --  ทับทาวเวอร์ที่ยังอยู่ในสนาม แล้วล้มเหลวรัวทั้งชุด
    task.spawn(function()
        while playing do
            --  ยังไม่พร้อมเล่น — รอเฉยๆ ไม่ยิงคำสั่งอะไรทั้งนั้น
            --    1. ยังไม่อยู่ในด่านจริง (อยู่ห้องเลือกด่าน หรือด่านกำลังโหลด)
            --    2. อยู่ในด่านแล้วแต่ "คนละด่านกับที่อัดไว้"
            --  ข้อ 2 สำคัญพอกัน มาโครผูกกับทางเดินและจุดวางของด่านนั้นโดยตรง
            --  เอาไปเล่นด่านอื่นคือวางลงจุดที่ไม่มีอยู่จริง เสียเงินและเสียรอบเปล่า
            while playing do
                local mapNow  = getMapName()
                local mapWant = macro and macro.map
                local known   = type(mapWant) == "string"
                    and mapWant ~= "" and mapWant ~= "?"

                if not inGame() or inLobby() then
                    status = T("READY_WAIT")
                elseif known and mapNow == "?" then
                    status = T("READY_WAIT")
                elseif known and mapNow:lower() ~= mapWant:lower() then
                    status = T("WAIT_MAP", mapWant, mapNow)
                else
                    break
                end
                task.wait(1)
            end
            if not playing then break end

            --  ด่านเพิ่งโหลดเสร็จ ให้เกมตั้งตัวก่อนสักครู่
            task.wait(2)
            if not playing then break end

            --  ต้องคร่อม pcall ไว้ ไม่งั้นข้อผิดพลาดใดๆ ในระหว่างเล่นจะฆ่าเธรดนี้
            --  ทิ้งไปเงียบๆ สวิตช์ยังค้างเป็นเปิด สถานะยังเป็นข้อความเดิม
            --  ผู้ใช้จะเห็นแค่ "มาโครหยุดทำอะไรเฉยๆ" โดยไม่มีอะไรบอกสาเหตุ
            --  (เกิดมาแล้วจริงจากการเรียกฟังก์ชันที่ถูกลบทิ้งไป)
            local fine, err = pcall(playOnce)
            if not fine then
                lastError = T("CRASH", tostring(err))
                status    = T("CRASH_STOP")
                playing   = false
                break
            end
            if not playing then break end

            status = status .. T("WAIT_MATCH")
            local lastWave = getWave()
            while playing do
                local w = getWave()
                if w < lastWave or (w <= 1 and lastWave > 1) then break end
                lastWave = math.max(lastWave, w)
                task.wait(1)
            end
            if playing then task.wait(3) end
        end
    end)
    return true
end

local function stopPlaying()
    playing = false
    status = T("STOPPED")
end

--  กระดานไหนกำลังแสดงแมพชื่อนี้อยู่
--
--  ชื่อแมพอยู่ที่  Board<N>.Hitboxes.Bottom.MapDisplay.Title  (ยืนยันจากการดักจริง)
--  จำนวนโหวตอยู่ที่ Board<N>.Hitboxes.Count.Counter.Value    ใช้ตรวจว่าโหวตติดจริงไหม
--  อ่านตรงจุดแบบนี้เร็วกว่าและแม่นกว่ากวาดหาข้อความทั้งกระดาน
--  (ของเดิมกวาดแล้วจะไปเจอ "Created by ..." หรือชื่อคนโหวตด้วย)
local function boardMapTitle(b)
    local hb = b and b:FindFirstChild("Hitboxes")
    local bt = hb and hb:FindFirstChild("Bottom")
    local md = bt and bt:FindFirstChild("MapDisplay")
    local ti = md and md:FindFirstChild("Title")
    return (ti and ti:IsA("TextLabel")) and ti.Text or nil
end

local function boardVoteCount(b)
    local hb = b and b:FindFirstChild("Hitboxes")
    local ct = hb and hb:FindFirstChild("Count")
    local cn = ct and ct:FindFirstChild("Counter")
    local va = cn and cn:FindFirstChild("Value")
    return (va and va:IsA("TextLabel")) and (tonumber(va.Text) or 0) or nil
end

local function findMapBoard(name)
    local lb = lobbyFolder()
    local boards = lb and lb:FindFirstChild("Boards")
    if not (boards and type(name) == "string" and name ~= "") then return nil end

    for _, b in ipairs(boards:GetChildren()) do
        if boardMapTitle(b) == name then return b end
    end
    return nil
end

--  แท่นโหวตของกระดานนั้น
--  ผู้ใช้บอกว่าเป็นลูกตัวที่สอง แต่ค้นหาเอาปลอดภัยกว่านับตำแหน่ง
--  ลำดับลูกใน Roblox ไม่รับประกันว่าคงที่
local function boardVotePrompt(board)
    local hb = board and board:FindFirstChild("Hitboxes")
    local vp = hb and hb:FindFirstChild("VotePlatform")
    if not vp then return nil end

    for _, c in ipairs(vp:GetDescendants()) do
        if c:IsA("ProximityPrompt") then return c, c.Parent end
    end
    return nil
end

