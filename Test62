--  ข้อความของมาโครที่เลือกอยู่ ในรูป JSON
--
--  อ่านจากไฟล์ตรงๆ ไม่ใช่จากตัวแปรในหน่วยความจำ
--  เพราะตัวในหน่วยความจำมีของชั่วคราวปนอยู่ (t0, ตัวชี้โมเดล) ซึ่งแชร์ไปก็ใช้ไม่ได้
local function macroJSON()
    if currentName == "" then return nil, "No macro selected" end

    local path = macroPath(currentName)
    if not isfile(path) then return nil, "Macro file not found" end

    local ok, text = pcall(readfile, path)
    if not ok or type(text) ~= "string" or text == "" then
        return nil, "Could not read the macro file"
    end
    return text
end

--  ตั้งชื่อไม่ให้ทับของเดิม
--
--  นำเข้ามาโครชื่อซ้ำแล้วเขียนทับของเก่าทิ้งคือเรื่องที่ให้อภัยยาก
--  มาโครหนึ่งไฟล์ใช้เวลาอัดเป็นสิบนาที ต่อท้ายเลขไปดีกว่า
local function freeName(base)
    base = safeName(base)
    if not isfile(macroPath(base)) then return base end

    for i = 2, 99 do
        local try = ("%s (%d)"):format(base, i)
        if not isfile(macroPath(try)) then return try end
    end
    return ("%s (%d)"):format(base, os.time() % 100000)
end

--  นำเข้ามาโคร รับได้ทั้งลิงก์และตัว JSON เอง
local function importMacro(text)
    text = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if text == "" then return false, "Nothing pasted" end

    --  เป็นลิงก์ก็โหลดมาก่อน
    --  ต้องเป็น raw เท่านั้น ลิงก์หน้าเว็บปกติจะได้ HTML กลับมาแทน JSON
    if text:match("^https?://") then
        local ok, body = pcall(function() return game:HttpGet(text, true) end)
        if not ok or type(body) ~= "string" or body == "" then
            return false, "Could not load the link - it must be a raw link"
        end
        text = body:gsub("^%s+", ""):gsub("%s+$", "")
    end

    local ok, data = pcall(function() return HttpService:JSONDecode(text) end)
    if not ok or type(data) ~= "table" then
        return false, "Could not parse the JSON"
    end
    if type(data.actions) ~= "table" or #data.actions == 0 then
        return false, "That file has no macro commands in it"
    end

    --  เขียนใหม่ทั้งชุดผ่าน writeMacro ไม่ใช่ก๊อปไฟล์ดิบลงไป
    --  จะได้ผ่านการกรองฟิลด์ชุดเดียวกับตอนอัด ของแปลกปลอมจากไฟล์ข้างนอกไม่หลุดเข้ามา
    local name = freeName(data.name or "Imported")
    local m = {
        name      = name,
        map       = data.map,
        mode      = data.mode,
        startWave = data.startWave,
        towers    = type(data.towers) == "table" and data.towers or {},
        slots     = type(data.slots)  == "table" and data.slots  or {},
        autoBuff  = data.autoBuff,
        loadout   = data.loadout,
        actions   = data.actions,
    }

    if not writeMacro(m) then return false, "Could not save the file" end

    pcall(function() MacroDropdown:SetValues(listMacros()) end)
    loadMacro(name)
    uiSet(MacroDropdown, name)

    return true, ("Imported: %s (%d commands)"):format(name, #data.actions)
end

local function deleteMacro(n)
    local path = macroPath(n)
    if not isfile(path) then
        status = T("NO_FILE")
        return false
    end
    local ok = pcall(function() delfile(path) end)
    if ok then
        if currentName == safeName(n) then
            macro, currentName = nil, ""
        end
        status = T("DELETED", safeName(n))
    else
        status = T("DEL_FAIL")
    end
    return ok
end

-- ═══════════════════════════════════════════════════
--  ตรวจโหลดเอาต์
--
--  เทียบราคาของแต่ละช่อง hotbar กับตอนที่อัด ราคาต่างกัน = คนละทาวเวอร์
--  ถ้าไม่ตรงแล้วปล่อยให้เล่นไป มาโครจะวางผิดตัวทั้งชุดตั้งแต่คำสั่งแรก
-- ═══════════════════════════════════════════════════
local function checkLoadout()
    if not macro then return true, T("NO_MACRO") end
    if not macro.loadout then
        return true, T("NO_LOADOUT")
    end

    local now = hotbarCosts()
    if not now then return true, T("CANT_READ_LO") end

    local bad = {}
    for slot, cost in pairs(macro.loadout) do
        local cur = now[slot]
        if cur ~= cost then
            local who = macro.slots and macro.slots[slot]
            table.insert(bad, T("SLOT_DIFF", slot, tostring(cost),
                who and (" (" .. who .. ")") or "",
                cur and ("$" .. cur) or T("EMPTY_SLOT")))
        end
    end

    table.sort(bad)
    if #bad == 0 then return true, T("LO_OK") end
    return false, T("LO_BAD") .. "\n" .. table.concat(bad, "\n")
end

-- ═══════════════════════════════════════════════════
--  ตัวอัด
--
--  ดัก __namecall แบบเบาที่สุด — ในตัว hook แค่โยนของใส่คิวแล้วปล่อยผ่าน
--  งานหนักไปทำในลูปแยก ถ้าทำงานหนักในนี้ InvokeServer จะรอคำตอบ
--  เซิร์ฟเวอร์ไม่ทัน แล้วปุ่มในเกมจะพัง (เจอมาแล้วตอนเขียน debug)
--
--  คำสั่งที่สคริปต์นี้ส่งเองจะไม่ถูกอัดซ้ำ เพราะ checkcaller() เป็น true
-- ═══════════════════════════════════════════════════
local queue, qHead, qTail = {}, 1, 0

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    if (recording or self == RE) and (self == RE or self == RF) then
        local method = getnamecallmethod()
        if (method == "FireServer" or method == "InvokeServer") and not checkcaller() then
            local a = table.pack(...)

            --  ตามดูทาวเวอร์ที่ใส่อยู่จริง ทำตลอดเวลา ไม่ขึ้นกับว่ากำลังอัดอยู่ไหม
            --
            --  ตอนใส่ทาวเวอร์ที่ล็อบบี้ เกมยิงคำสั่งเดียวกับตอนเลือกทาวเวอร์จะวาง
            --  ต่างกันแค่มีตัวที่ห้าเป็น true  ดักของจริงมาแล้วจากล็อบบี้หลัก
            --      RE("Streaming", "SelectTower", ชื่อ, สกิน, true)
            if a[1] == "Streaming" and a[2] == "SelectTower" and type(a[3]) == "string" then
                if a[5] == true then
                    --  ตัวที่ห้าเป็น true คือการ "ใส่ทาวเวอร์" ที่ล็อบบี้
                    liveEquip[a[3]] = (type(a[4]) == "string" and a[4]) or "Default"
                elseif lastHotbar then
                    --  ไม่มีตัวที่ห้า คือการเลือกช่องในสนาม ตามหลัง Hotbar Click มาติดๆ
                    slotTower[lastHotbar] = {
                        name = a[3],
                        skin = (type(a[4]) == "string" and a[4]) or "Default",
                    }
                    lastHotbar = nil
                end
            elseif a[1] == "Hotbar" and a[2] == "Click" then
                lastHotbar = tonumber(a[3])
            end

            --  ⚠ วิธีที่แน่นอน: อ่านคำตอบของเซิร์ฟเวอร์ตรงๆ
            --
            --  InvokeServer ตอบกลับมาว่าสำเร็จหรือไม่ ตอนอัดผมทิ้งคำตอบนั้นไปทั้งหมด
            --  แล้วมานั่งเดาจากค่าที่เปลี่ยนในเกมแทน ซึ่งพลาดได้เสมอ
            --  เน็ตช้า เกมค้าง หรือกดรัว ค่าก็มาถึงไม่ตรงจังหวะ
            --
            --  คำตอบของเซิร์ฟเวอร์ไม่มีทางผิด มันคือผู้ตัดสินตัวจริง
            --  ต้องยิงคำสั่งต่อ "ก่อน" ถึงจะได้คำตอบ แล้วค่อยเข้าคิว
            --  ห้ามเรียก namecall อะไรก่อนหน้านี้เด็ดขาด เมธอดที่ค้างอยู่จะโดนทับ
            if recording and method == "InvokeServer" then
                local r = table.pack(oldNamecall(self, ...))
                a.reply  = r[1]
                a.replied = true

                qTail = qTail + 1
                queue[qTail] = a
                return table.unpack(r, 1, r.n)
            end

            if recording then
                qTail = qTail + 1
                queue[qTail] = a
            end
        end
    end
    return oldNamecall(self, ...)
end)

--  คิววัดราคาอัปเกรด แยกตามทาวเวอร์
--
--  เดิมใช้ task.delay(1.2) แล้วค่อยอ่าน @TotalSpent ซึ่งพังทันทีถ้าผู้เล่นรัว
--  อัปเกรดตัวเดียวกันหลายครั้งรวด เพราะทุกครั้งจะไปอ่านตอนที่อัปครบหมดแล้ว
--  ครั้งแรกจึงได้ราคาเท่ากับยอดรวมของทั้งชุด สูงเกินจริงหลายเท่า
--  แล้วตอนเล่นมาโครก็จะนั่งรอเงินที่ไม่เคยต้องใช้จนหมดเวลาแล้วข้ามคำสั่งนั้นทิ้ง
--
--  คราวนี้ผูกกับสัญญาณ @TotalSpent เปลี่ยนแทน ทุกครั้งที่ยอดขยับ
--  จะจับคู่ส่วนต่างเข้ากับคำสั่งที่รออยู่ตัวแรกสุด เรียงตามลำดับที่กดจริง
local upgradeQueue = {}
local upgradeConns = {}

local function trackUpgradeCost(m, action)
    local q = upgradeQueue[m]

    if not q then
        q = { spent = tSpent(m), waiting = {} }
        upgradeQueue[m] = q

        local r = rep(m)
        if r then
            local conn = r:GetAttributeChangedSignal("TotalSpent"):Connect(function()
                local now  = tSpent(m)
                local diff = now - q.spent
                q.spent = now
                local a = table.remove(q.waiting, 1)
                if a and diff > 0 then a.cost = diff end
            end)
            table.insert(upgradeConns, conn)
        end
    end

    table.insert(q.waiting, action)
end

local function clearUpgradeTracking()
    for _, c in ipairs(upgradeConns) do pcall(function() c:Disconnect() end) end
    upgradeConns = {}
    upgradeQueue = {}
end

local dropped = 0      -- คำสั่งที่อัดไว้แล้วถูกถอดออกเพราะเกมไม่รับ

--  เวลาที่แต่ละเวฟเริ่ม (วินาทีนับจากเริ่มอัด)
--
--  จำเป็นเพราะ "กดสกิลตอนบอสออก" ไม่ได้ผูกกับเวลาตั้งแต่เริ่มเกม
--  แต่ผูกกับ "วินาทีที่เท่าไหร่ของเวฟนั้น" ตอนเล่นซ้ำเวลารวมจะเลื่อนเสมอ
--  (รอเงิน รอโหวต ฯลฯ) ถ้ายึดเวลารวมก็จะกดผิดจังหวะไปทั้งชุด
local waveAt = {}

local function addAction(a)
    local now = os.clock() - macro.t0
    a.t    = now
    a.wave = getWave()
    a.tw   = now - (waveAt[a.wave] or 0)      -- วินาทีที่เท่าไหร่ของเวฟนั้น
    table.insert(macro.actions, a)
    return a
end

--  เฝ้าว่าเวฟเปลี่ยนตอนไหน ระหว่างอัดเท่านั้น
local function watchWavesWhileRecording()
    task.spawn(function()
        local last = getWave()
        waveAt[last] = os.clock() - macro.t0
        while recording do
            local w = getWave()
            if w ~= last then
                last = w
                waveAt[w] = os.clock() - macro.t0
            end
            task.wait(0.2)
        end
    end)
end

--  ตรวจย้อนหลังว่าคำสั่งที่เพิ่งอัดไปนั้นเกมรับจริงไหม ถ้าไม่รับก็ถอดออก
--
--  จำเป็นเพราะตัวดักเห็นแค่คำสั่งขาออก ไม่เห็นคำตอบของเซิร์ฟเวอร์
--  (จะไปดักคำตอบก็ไม่ได้ เพราะการรอผลข้างใน hook เป็นการ yield ข้ามขอบเขต
--  metamethod ซึ่ง Roblox ไม่ยอม แล้วคำสั่งในเกมจะพังทั้งหมด)
--
--  ผู้เล่นกดพลาดเป็นเรื่องปกติ เช่นวางทาวเวอร์เกินลิมิต หรือวางในจุดที่วางไม่ได้
--  ถ้าปล่อยให้ติดเข้ามาโคร ตอนเล่นซ้ำมันจะไปยิงคำสั่งที่ไม่มีวันสำเร็จ
--  เสียเวลาลองซ้ำ แล้วไปกินจังหวะของคำสั่งข้างหลังที่มีหน้าต่างเวลาจำกัด
--
--  ดูจากผลที่เกิดขึ้นในเกมจริง ไม่ใช่จากคำสั่งที่ส่งไป
--  ⚠ ห้ามเช็คครั้งเดียวแล้วตัดสิน
--
--  ของเดิมรอ 2.5 วินาทีแล้วดูทีเดียวจบ ผ่านก็เก็บ ไม่ผ่านก็ทิ้ง
--  ปัญหาคือมันวัด "ผลมาถึงภายใน 2.5 วินาทีไหม" ไม่ใช่ "คำสั่งสำเร็จไหม"
--  เน็ตช้า เกมค้างวินาทีเดียว หรือกดรัวหลายคำสั่งพร้อมกัน
--  ผลจะมาถึงช้ากว่านั้นเป็นเรื่องปกติ แล้วคำสั่งที่สำเร็จจริงก็ถูกลบทิ้ง
--  อาการที่เห็นคือ "อัดแล้วมาโครไม่จำการอัปเกรด"
--
--  เปลี่ยนเป็นคอยดูเรื่อยๆ จนกว่าจะเห็นผลหรือหมดเวลา
--  สำเร็จเมื่อไหร่ก็จบทันที การยืดเวลารอจึงไม่ได้ทำให้อะไรช้าลงเลย
--  ได้แต่ความทนต่อความหน่วง ซึ่งเป็นสิ่งที่ขาดอยู่
--  กดอัปเกรดค้างอยู่กี่ครั้งต่อทาวเวอร์หนึ่งตัว
local upPending = setmetatable({}, { __mode = "k" })

--  เซิร์ฟเวอร์ตอบว่าอะไร
--
--  ผู้ตัดสินตัวจริงคือคำตอบนี้ ไม่ใช่ค่าที่เปลี่ยนในเกมซึ่งมาถึงไม่ตรงจังหวะ
--  คืน true = สำเร็จแน่ · false = ถูกปฏิเสธแน่ · nil = ไม่รู้ ต้องไปดูผลในเกมต่อ
local function replySays(a)
    if not (a and a.replied) then return nil end

    local r = a.reply
    if r == true then return true end
    if r == false or r == nil then return false end

    --  ข้อความคือคำปฏิเสธเสมอ เกมส่งเหตุผลกลับมาเป็นข้อความ
    --  เช่น "You need $118 more" หรือ "You can only place 10 Farm(s)!"
    if type(r) == "string" then return r == "" and nil or false end

    --  ตารางคือข้อมูลผลลัพธ์ แปลว่าทำสำเร็จ
    if type(r) == "table" then return true end
    return nil
end

local function verifyLater(owner, action, label, check, wait)
    local deadline = wait or 8

    task.spawn(function()
        local until_ = os.clock() + deadline

        while os.clock() < until_ do
            --  อัดรอบใหม่ไปแล้ว ของเก่าไม่เกี่ยวกันแล้ว
            if macro ~= owner then return end
            if not recording then return end   -- หยุดอัดแล้ว อย่าไปลบของที่เก็บไว้

            local ok, effective = pcall(check)
            if ok and effective then return end

            task.wait(0.15)
        end

        --  หมดเวลาแล้วยังไม่เห็นผล ค่อยตัดสินว่าไม่สำเร็จ
        if macro ~= owner then return end
        local ok, effective = pcall(check)
        if ok and effective then return end

        for i = #owner.actions, 1, -1 do
            if owner.actions[i] == action then
                table.remove(owner.actions, i)
                dropped = dropped + 1
                break
            end
        end
    end)
end

local function handleCommand(a)
    if not (recording and macro) then return end

    local ns, act = a[1], a[2]

    --  จำช่องกับสกินที่กดล่าสุด เอาไว้เติมให้คำสั่งวางที่ตามมา
    if ns == "Hotbar" and act == "Click" then lastSlot = a[3] return end
    if ns == "Streaming" and act == "SelectTower" then lastSkin = a[4] return end

    if ns == "Voting" and act == "Skip" then
        --  หนึ่งเวฟโหวตข้ามได้ครั้งเดียว การกดซ้ำคือการยกเลิกโหวตของตัวเอง
        --  ถ้าอัดไว้ทั้งคู่ ตอนเล่นมาโครจะเปิดแล้วปิดโหวตทันที เกมไม่เริ่มสักที
        --
        --  log จริงเจอ skip ที่เวฟ 0 ถึงสามครั้ง ทำให้มาโครค้างอยู่ 130 วินาที
        --  กว่าครั้งที่สามจะบังเอิญเปิดโหวตกลับ
        local w = getWave()
        for _, prev in ipairs(macro.actions) do
            if prev.type == "skip" and prev.wave == w then return end
        end

        --  เก็บอาร์กิวเมนต์ที่เหลือด้วย ห้ามทิ้ง
        --  ซอร์สของ VoteWave มีปุ่ม Yes กับ No ที่เรียก Voted(true) / Voted(false)
        --  แปลว่าโหวตข้ามเวฟน่าจะแนบค่ามาด้วย ต่างจากปุ่ม Ready ตอนก่อนเริ่มเกม
        --  ที่ดักได้ว่าไม่มีอาร์กิวเมนต์เลย ถ้าทิ้งไปก็เท่ากับส่งคำสั่งไม่ครบ
        local extra, n = {}, 0
        for i = 3, a.n do
            n = n + 1
            extra[tostring(n)] = packValue(a[i])
        end
        addAction({ type = "skip", extra = extra, extraN = n })
        return
    end
    if ns ~= "Troops" then return end

    if act == "Place" then
        local d, name = a[3], a[4]
        if type(d) ~= "table" or not d.Position then return end

        refCount = refCount + 1
        local action = addAction({
            type  = "place",
            ref   = refCount,
            tower = name,
            skin  = lastSkin,
            slot  = lastSlot,
            pos   = { d.Position.X, d.Position.Y, d.Position.Z },
            rot   = { (d.Rotation or CFrame.new()):GetComponents() },
            cost  = 0,
        })

        if lastSlot and name then macro.slots[tostring(lastSlot)] = name end

        --  เซิร์ฟเวอร์ปฏิเสธมาแล้ว ไม่ต้องอัด
        if replySays(a) == false then
            for i = #macro.actions, 1, -1 do
                if macro.actions[i] == action then
                    table.remove(macro.actions, i)
                    dropped = dropped + 1
                    break
                end
            end
            return
        end

        --  ราคาจริงต้องรอทาวเวอร์โผล่ก่อนถึงจะอ่าน @TotalSpent ได้
        table.insert(pendingPlaces,
            { action = action, pos = d.Position, at = os.clock() })

        --  ไม่มีทาวเวอร์โผล่ = เกมปฏิเสธ (เช่นวางเกินลิมิต หรือจุดนั้นวางไม่ได้)
        local ref = action.ref
        --  ให้เวลามากขึ้นเท่ากับตัวอื่น เน็ตช้าแล้วทาวเวอร์โผล่ช้าก็มี
        --  ตัวคอยดูจบทันทีที่ทาวเวอร์โผล่ การยืดเวลาจึงไม่ทำให้ช้าลง
        verifyLater(macro, action, ("Place %s"):format(tostring(name)), function()
            return refModel[ref] ~= nil
        end, 8)

    elseif act == "Upgrade" then
        local m = type(a[4]) == "table" and a[4].Troop
        local r = m and modelRef[m]
        if not r then return end    -- ไม่ใช่ทาวเวอร์ที่มาโครนี้วางไว้ ข้าม

        --  ราคาอัปเกรดวัดจาก @TotalSpent ที่เพิ่มขึ้น แม่นกว่าอ่านเงินบนจอ
        --  เพราะเงินอาจขยับจากรายได้ของ Farm พร้อมกันพอดี
        --  ⚠ เซิร์ฟเวอร์ปฏิเสธมาแล้ว ไม่ต้องอัดตั้งแต่แรก
        --  เงินไม่พอ อัปตัน หรือชนเงื่อนไขอะไรก็ตาม รู้ผลตรงนี้เลย
        --  ไม่ต้องอัดลงไปก่อนแล้วมานั่งลุ้นว่าจะโดนลบทีหลังไหม
        local said = replySays(a)
        if said == false then return end

        --  เก็บสายที่ผู้เล่นเลือกไว้ด้วย ทาวเวอร์สายเดียวจะไม่มีค่านี้
        --
        --  โมดูล Upgrades ของเกมบอกไว้ว่า path ที่ไม่เกินศูนย์คือ "ไม่มีสาย"
        --      if not u9.path then path = nil elseif 0 >= u9.path then path = nil end
        --  ยึดกติกาเดียวกัน จะได้ไม่เผลอส่งเลขศูนย์ไปให้เซิร์ฟเวอร์ตีความเอง
        local path = a[4].Path
        if type(path) == "number" and path <= 0 then path = nil end

        local spent0, lv0 = tSpent(m), tLevel(m)
        local up = addAction({ type = "upgrade", ref = r, cost = 0, path = path })
        trackUpgradeCost(m, up)

        --  เซิร์ฟเวอร์ยืนยันว่าสำเร็จแล้ว เก็บไว้เลย ไม่ต้องตรวจซ้ำ
        --  นี่คือจุดที่ทำให้ "กดรัวแล้วหลุด" หายไปทั้งหมด
        --  เพราะไม่ต้องพึ่งจังหวะการมาถึงของค่าในเกมอีกต่อไป
        if said == true then
            upPending[m] = nil
            return
        end

        --  ⚠ กดรัวหลายครั้งต้องนับเป็นรายครั้ง
        --
        --  ของเดิมทุกคำสั่งเทียบกับ "ระดับตอนที่ตัวเองถูกกด"
        --  กดรัวสามครั้งในเสี้ยววินาที ทั้งสามจะจับค่าเดิมเหมือนกันหมด
        --  พอขึ้นไปหนึ่งขั้น ทั้งสามคำสั่งก็ผ่านหมด ทั้งที่สำเร็จจริงแค่ครั้งเดียว
        --  หรือกลับกัน ถ้าเซิร์ฟเวอร์ตอบช้ากว่าที่กด ก็โดนลบทิ้งทั้งชุด
        --
        --  จึงจองลำดับไว้ล่วงหน้า คำสั่งที่ n ต้องเห็นระดับขึ้นถึง lv0 + n
        --  ตรงกับความเป็นจริงว่ากดกี่ครั้งต้องขึ้นกี่ขั้น
        upPending[m] = (upPending[m] or 0) + 1
        local wantLv = lv0 + upPending[m]

        --  ระดับตันแล้วก็ดูที่ยอดเงินที่จ่ายแทน
        --  บางทาวเวอร์อัปฟรีจากบัฟส่วนลด ระดับขึ้นแต่ยอดไม่ขยับ จึงต้องดูทั้งสองทาง
        verifyLater(macro, up, "Upgrade", function()
            return tLevel(m) >= wantLv or tSpent(m) > spent0
        end)

        --  ปล่อยคิวคืนเมื่อผลมาถึงแล้ว ไม่งั้นการกดครั้งถัดไปจะตั้งเป้าสูงเกินจริง
        task.delay(9, function()
            if upPending[m] then
                upPending[m] = upPending[m] - 1
                if upPending[m] <= 0 then upPending[m] = nil end
            end
        end)

    elseif act == "Option" then
        local d = type(a[4]) == "table" and a[4]
        local m = d and d.Troop
        local r = m and modelRef[m]
        if not r or not d.Name then return end

        local rep0 = rep(m)
        local before = rep0 and rep0:GetAttribute("Options")
        local opt = addAction({
            type  = "option",
            ref   = r,
            name  = tostring(d.Name),
            value = packValue(d.Value),
        })

        verifyLater(macro, opt, ("Option %s"):format(tostring(d.Name)), function()
            local r2 = rep(m)
            return r2 ~= nil and r2:GetAttribute("Options") ~= before
        end)

    elseif act == "Target" then
        local d = type(a[4]) == "table" and a[4]
        local m = d and d.Troop
        local r = m and modelRef[m]
        if not r or not d.Target then return end

        local before = tTargetMode(m)
        local tg = addAction({ type = "target", ref = r, mode = tostring(d.Target) })

        verifyLater(macro, tg, ("Targeting %s"):format(tostring(d.Target)), function()
            return tTargetMode(m) ~= before
        end)

    elseif act == "Sell" then
        local m = type(a[3]) == "table" and a[3].Troop
        local r = m and modelRef[m]
        if not r then return end
        local sell = addAction({ type = "sell", ref = r })

        if replySays(a) == false then
            for i = #macro.actions, 1, -1 do
                if macro.actions[i] == sell then
                    table.remove(macro.actions, i)
                    dropped = dropped + 1
                    break
                end
            end
            return
        end

        verifyLater(macro, sell, "Sell", function()
            return m.Parent == nil
        end)

    elseif act == "Abilities" then
        local d = type(a[4]) == "table" and a[4]
        local m = d and d.Troop
        local r = m and modelRef[m]
        if not r or not d.Name then return end
        --  จดตัวเลือกที่ตั้งไว้ตอนกด
        --
        --  สกิลของบางทาวเวอร์ให้ผลต่างกันตามตัวเลือก เช่น Drop The Beat ของ DJ Booth
        --    Purple  ผลักและชะลอศัตรู
        --    Green   ได้เงินตามจำนวนทาวเวอร์ในระยะ
        --    Red     ทำดาเมจและลดเกราะ
        --  กดถูกจังหวะแต่ Track ผิด = ได้เอฟเฟกต์คนละอย่างกับที่ตั้งใจ
        local rep0 = rep(m)
        local opts = rep0 and rep0:GetAttribute("Options")
        if type(opts) ~= "string" or opts == "" or opts == "[]" then opts = nil end

        --  จดว่าตอนกดมีบอสอยู่ในสนามไหม
        --  ถ้ามี แปลว่าผู้เล่นตั้งใจกดตอนบอสออก ซึ่งเป็นจังหวะที่แม่นกว่าการนับวินาที
        --  เพราะรอบหน้าบอสอาจออกช้าหรือเร็วกว่าเดิมตามความเร็วที่เคลียร์เวฟ
        addAction({
            type = "ability",
            ref  = r,
            name = d.Name,
            data = packValue(d.Data) or {},
            boss = bossOnField() or nil,
            opts = opts,
        })
    end
end

task.spawn(function()
    while ALIVE do
        while qHead <= qTail do
            local item = queue[qHead]
            queue[qHead] = nil
            qHead = qHead + 1
            pcall(handleCommand, item)
        end
        task.wait(0.1)
    end
end)

--  ทาวเวอร์ที่เพิ่งโผล่ = ผลของคำสั่งวางที่เพิ่งส่งไป จับคู่ด้วยตำแหน่ง
--
--  การผูก ref ตรงนี้สำคัญกว่าที่เห็น เพราะตัวอัดจะจดคำสั่งอัปเกรด/ขาย/สกิล
--  เฉพาะทาวเวอร์ที่ผูก ref ไว้ได้เท่านั้น ถ้าผูกไม่ติด คำสั่งพวกนั้นจะถูกทิ้งเงียบๆ
--  โดยไม่มีอะไรฟ้องเลย — ผู้เล่นจะเห็นแค่ว่า "อัปเกรดตัวแรกๆ ไม่ถูกจด"
--
--  ของเดิมรอ 0.4 วินาทีแล้วอ่านตำแหน่งทีเดียว ถ้า @Position ยังมาไม่ถึงก็ปล่อยผ่าน
--  ซึ่งเกิดบ่อยที่สุดตอนเริ่มเกมที่โหลดหนัก คือช่วงที่วางทาวเวอร์ตัวแรกๆ พอดี
local function bindNewTower(m)
    if not recording then return end

    --  รอจนกว่าจะอ่านตำแหน่งได้จริง ไม่ใช่เช็คครั้งเดียวแล้วยอมแพ้
    local p
    for _ = 1, 30 do
        if not recording then return end
        p = tPos(m)
        if p then break end
        task.wait(0.1)
    end
    if not p or not isMine(m) then return end

    --  จับคู่กับคำสั่งวางที่ใกล้ที่สุดในคิว
    local best, bestDist, bestIdx
    for i = #pendingPlaces, 1, -1 do
        local pp = pendingPlaces[i]
        if os.clock() - pp.at > 15 then
            table.remove(pendingPlaces, i)      -- เก่าเกินไป ทิ้ง
        else
            local d = (p - pp.pos).Magnitude
            if d <= 2 and (not bestDist or d < bestDist) then
                best, bestDist, bestIdx = pp, d, i
            end
        end
    end
    if not best then return end

    table.remove(pendingPlaces, bestIdx)
    refModel[best.action.ref] = m
    modelRef[m] = best.action.ref
    best.action.cost = tSpent(m)
end

local towerConn
local function watchTowers()
    if towerConn then towerConn:Disconnect() end
    local f = towersFolder()
    if not f then return end
    towerConn = f.ChildAdded:Connect(function(m)
        task.spawn(function() pcall(bindNewTower, m) end)
    end)
end

watchTowers()
workspace.ChildAdded:Connect(function(c)
    if c.Name == "Towers" then task.wait(0.5) watchTowers() end
end)

