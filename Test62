--  ตัวอัปเดตแถบสถานะ
--
--  Fluent ตั้งชื่อเมธอดของ Paragraph ไม่เหมือนกันในแต่ละรุ่น
--  ลองทีละชื่อแล้วจำตัวที่ใช้ได้ไว้ จะได้ไม่ต้องลองใหม่ทุกวินาที
-- ═══════════════════════════════════════════════════
local paraSetter = {}    -- [paragraph] = ฟังก์ชันที่ใช้ได้กับตัวนั้น

setParaText = function(para, text)
    if type(para) ~= "table" then return end
    if paraSetter[para] then paraSetter[para](text) return end

    for _, name in ipairs({ "SetDesc", "SetContent", "SetDescription", "SetValue" }) do
        if type(para[name]) == "function" then
            local ok = pcall(function() para[name](para, text) end)
            if ok then
                paraSetter[para] = function(t)
                    pcall(function() para[name](para, t) end)
                end
                return
            end
        end
    end
end

local function setStatusText(text) setParaText(StatsPara, text) end

--  รายชื่อทาวเวอร์ที่มาโครต้องใช้ กับที่ใส่อยู่จริงตอนนี้
task.spawn(function()
    local last = nil
    while ALIVE do
        task.wait(2)
        pcall(function()
            local list = macroLoadout()
            local text

            if not (list and #list > 0) then
                text = macro and "This macro has no tower data yet"
                             or "No macro selected"
            else
                local parts = {}
                for _, t in ipairs(list) do
                    --  ติ๊กถูกให้ตัวที่ใส่อยู่แล้ว จะได้เห็นทันทีว่าขาดตัวไหน
                    table.insert(parts, (liveEquip[t.name] and "[/] " or "[ ] ") .. t.name
                        .. (t.skin ~= "Default" and (" (" .. t.skin .. ")") or ""))
                end
                text = table.concat(parts, "\n")
            end

            if text ~= last then
                last = text
                setParaText(LoadoutPara, text)
            end
        end)
    end
end)

