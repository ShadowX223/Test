--  ⚠ ยังทำงานไม่ได้ — รู้ที่อยู่ของคำสั่งครบแล้ว แต่ยังไม่รู้ว่าต้องส่งอะไรไปด้วย
--
--  ที่รู้แล้วจากการดัมป์ ReplicatedStorage.Network
--      PlaytimeRewards  RF:ClaimReward     (ข้าม RF:ClaimVideo ที่ต้องดูโฆษณา)
--      DailySpin        RF:RedeemSpin  RF:RedeemReward  RF:GetDailyReward
--      Quests           RF:ClaimQuest
--      Achievements     RF:Claim
--
--  Playtime ดักของจริงมาแล้ว ที่เหลือยังไม่รู้อาร์กิวเมนต์
--      RF:ClaimReward(1)  ...  RF:ClaimReward(6)
--  รางวัลมีหกช่อง ส่งเลขช่องไปตรงๆ ไม่มีอย่างอื่น
--
--  ยิงครบทั้งหกช่องทุกรอบ เพราะฝั่งเราไม่รู้ว่าช่องไหนถึงเวลาแล้ว
--  ช่องที่ยังไม่ถึงเวลาเซิร์ฟเวอร์ปฏิเสธเอง ไม่มีผลข้างเคียง
local function netCall(folder, name, ...)
    local net = ReplicatedStorage:FindFirstChild("Network")
    local grp = net and net:FindFirstChild(folder)
    local rf  = grp and grp:FindFirstChild(name)
    if not rf then return false, "Not found: " .. folder .. "." .. name end
    return pcall(function(...) return rf:InvokeServer(...) end, ...)
end

local function claimPlaytime()
    local got = 0
    for i = 1, 6 do
        local ok, res = netCall("PlaytimeRewards", "RF:ClaimReward", i)
        if ok and res ~= nil and res ~= false then got = got + 1 end
        task.wait(0.25)
    end
    return got
end

--  วงล้อรายวัน — ไม่มีอาร์กิวเมนต์เลย
--      Network.DailySpin["RF:RedeemSpin"]:InvokeServer()
--  URE:WheelPromptShow เป็นแค่การเปิดหน้าต่างให้ดู ไม่ได้เก็บของ จึงไม่ยิง
--  หมวด DailySpin มีสองคำสั่งที่ทำคนละเรื่องกัน แยกให้ผู้ใช้เลือกเอง
--      RF:RedeemSpin    หมุนวงล้อ      → Daily Spin
--      RF:RedeemReward  รับของรายวัน   → Daily Reward
--  ทั้งคู่ไม่มีอาร์กิวเมนต์ ดักของจริงมาแล้วทั้งสองตัว
--
--  ที่ต้องแยก เพราะบางคนอยากเก็บของรายวันแต่ไม่อยากหมุน
--  (เก็บสิทธิ์หมุนไว้ใช้ตอนมีอีเวนต์ของดี) รวมเป็นปุ่มเดียวคือบังคับให้ทำทั้งคู่
local function claimSpin()
    local ok, res = netCall("DailySpin", "RF:RedeemSpin")
    return (ok and res ~= nil and res ~= false) and 1 or 0
end

local function claimDailyReward()
    local ok, res = netCall("DailySpin", "RF:RedeemReward")
    return (ok and res ~= nil and res ~= false) and 1 or 0
