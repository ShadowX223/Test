local function failSummary()
    if #failLog == 0 then
        return "Last run: every command succeeded"
    end
    local out = { ("Last run: %d command(s) failed"):format(#failLog), "" }
    for _, line in ipairs(failLog) do
        table.insert(out, line)
        table.insert(out, "")
    end
    return table.concat(out, "\n")
end

