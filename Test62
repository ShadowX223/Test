-- ── เข้าเกมเองจากล็อบบี้หลัก ────────────────────────────
--
--  ดักของจริงมาแล้วทั้งชุด ไม่ได้เดาสักตัว
--
--    RF("Multiplayer", "single_create")
--        → { state = { group_leader = <UserIdเรา>, group_type = "single" }, id = "" }
--        สร้างปาร์ตี้เดี่ยว ต้องทำก่อนเสมอ ไม่งั้น v2:start ไม่มีปาร์ตี้ให้เริ่ม
--
--    RF("Multiplayer", "v2:start", { mode = "survival", difficulty = "Easy", count = 1 })
--        → true, nil
--        count คือจำนวนผู้เล่นสูงสุด  1=Solo 2=Duo 3=Trio 4=Quad
--        mode เป็นตัวพิมพ์เล็ก ตรงกับแท็บในหน้าต่าง Play
--        difficulty ตรงกับชื่อใน Shared.Data.GameModeData
--
--    RF("Multiplayer", "v2:stop")  → true       ยกเลิกการหาห้อง
--
--  จับคู่ได้แล้วเกมจะย้ายเราไปเองที่ place 5591597781 ไม่ต้องสั่งย้าย
--
--  ⚠ ยืนยันแล้วเฉพาะ mode = "survival"
--    แท็บอื่น (story / pvp / arcade / sandbox) ยังไม่เคยดักของจริง
--    จึงเดาชื่อให้ไม่ได้ ถ้าจะใช้ต้องไปเก็บ log เพิ่มก่อน
local JOIN_MODE   = "survival"

--  จำนวนผู้เล่นสูงสุด แปลงจากคำที่โชว์ใน UI เป็นตัวเลขที่เซิร์ฟเวอร์ต้องการ
local SQUAD_COUNT = { Solo = 1, Duo = 2, Trio = 3, Quad = 4 }

local joinGen = 0

--  ยิงคำสั่งหมวด Multiplayer หนึ่งครั้ง คืน ok, ผลลัพธ์
local function mpCall(action, payload)
    if not RF then return false, "RemoteFunction not found" end
    local ok, res = pcall(function()
        if payload == nil then return RF:InvokeServer("Multiplayer", action) end
        return RF:InvokeServer("Multiplayer", action, payload)
    end)
    return ok, res
end

local function autoJoinLoop()
    joinGen = joinGen + 1
    local myGen = joinGen

    task.spawn(function()

        local warned = false

        while autoJoin and joinGen == myGen do
            --  อยู่ในด่านหรือห้องเลือกด่านอยู่แล้ว ไม่ต้องทำอะไร
            if not inMainLobby() then
                warned = false
                task.wait(3)

            elseif wantMode == "" then
                if not warned then
                    warned = true
                    status = "Auto Join: pick a difficulty first"
                end
                task.wait(3)

            else
                warned = false
                local count = SQUAD_COUNT[wantSquad] or 1

                --  1. สร้างปาร์ตี้เดี่ยวก่อน
                --     ถ้าเคยเข้าคิวค้างไว้ ต้องยกเลิกก่อน ไม่งั้นสั่งเริ่มซ้อนไม่ได้
                mpCall("v2:stop")
                task.wait(0.3)

                local okC, resC = mpCall("single_create")
                if not okC then
                    status = "Auto Join: could not create the party"
                    task.wait(6)

                else
                    --  2. เริ่มหาห้อง
                    local payload = {
                        mode       = JOIN_MODE,
                        difficulty = wantMode,
                        count      = count,
                    }
                    local okS, resS = mpCall("v2:start", payload)

                    if not okS or resS == false then
                        status = "Auto Join: could not start matchmaking"
                        task.wait(6)

                    else
                        status = ("Auto Join: searching %s (%d players)"):format(wantMode, count)

                        --  3. รอจนหลุดจากล็อบบี้หลัก (เกมย้ายเราเอง)
                        --
                        --  ไม่สั่งย้ายเซิร์ฟเวอร์เอง เพราะเกมทำให้อยู่แล้ว
                        --  ถ้าไปสั่งซ้ำจะกลายเป็นเข้าเซิร์ฟเวอร์ผิดตัวแล้วเด้งกลับ
                        local until_ = os.clock() + 90
                        while autoJoin and joinGen == myGen
                            and inMainLobby() and os.clock() < until_ do
                            task.wait(1)
                        end

                        if not inMainLobby() then
                            status = "Auto Join: match found"
                            --  ปล่อยให้ลูปวนกลับไปนอนรอที่กิ่ง "not in the main lobby"
                        elseif autoJoin and joinGen == myGen then
                            --  90 วิแล้วยังไม่ได้ห้อง ยกเลิกแล้วเริ่มใหม่
                            --  ปล่อยค้างไว้ไม่ดี เพราะคิวฝั่งเซิร์ฟเวอร์อาจตายไปแล้ว
                            mpCall("v2:stop")
                            task.wait(2)
                        end
                    end
                end
            end
        end

        --  ปิดสวิตช์แล้วต้องยกเลิกคิวที่ค้างด้วย ไม่งั้นเกมจะลากเราเข้าห้องทีหลัง
        if joinGen == myGen and not autoJoin then
            mpCall("v2:stop")
        end
    end)
end

