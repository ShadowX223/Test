GENV[HUB_KEY].stop = function()
    ALIVE     = false
    playing   = false
    recording = false
    autoVote  = false
    autoBuff  = false
    autoAgain = false
    autoLobby = false
    wantPlay  = false
    webhookOn = false
    autoJoin  = false
    autoPlay  = false
    posPlay   = false

    --  คืนของที่ไปแก้ไว้ในโลก ก่อนจะปล่อยกล่องนี้ทิ้ง
    --
    --  สำคัญมากเวลารันทับ เพราะตารางที่จำค่าเดิมไว้อยู่ในกล่องของรอบนี้
    --  รอบใหม่มองไม่เห็น ถ้าไม่คืนตรงนี้ก็คืนไม่ได้อีกเลย
    --  อาการที่จะเจอคือจอดำค้างถาวรกดปิดไม่ได้ และภาพยังโดนถอดทิ้งอยู่
    pcall(function() perfApply(false) end)
    pcall(function() blackApply(false) end)
    pcall(function() if blackGui then blackGui:Destroy() end end)

    --  ก้อนหมุดของ Auto Play ค้างอยู่ในสนาม รอบใหม่จะสร้างซ้อนทับอีกชุด
    pcall(function()
        local f = workspace:FindFirstChild("ShadowXMarks")
        if f then f:Destroy() end
    end)

    --  คืนป้ายชื่อให้ตัวเอง ไม่งั้นปิดสคริปต์แล้วชื่อหายถาวร
    pcall(function()
        local tags = workspace:FindFirstChild("Nametags")
        local mine = tags and tags:FindFirstChild(LocalPlayer.Name)
        local disp = mine and mine:FindFirstChild("Display")
        if disp then disp.Enabled = true end
    end)

    pcall(function() Window:Destroy() end)

    --  ปุ่มลอยเป็น ScreenGui แยกต่างหาก ปิดหน้าต่างไม่ได้ลบมันไปด้วย
    --  ไม่เก็บกวาดจะเหลือปุ่มค้างซ้อนกันทุกครั้งที่รันทับ
    pcall(function()
        for _, g in ipairs(LocalPlayer:FindFirstChild("PlayerGui"):GetChildren()) do
            if g:IsA("ScreenGui") and (g.Name == "OpenUiBtn" or g.Name == "ToggleUI") then
                g:Destroy()
            end
        end
    end)
end

