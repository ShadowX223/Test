secLoadout:AddButton({
    Title = "Save current loadout",
    Icon = "solar/checklist-minimalistic-bold",
    Description = "Stores your equipped towers into the selected macro",
    --  รายชื่อมาจากคำสั่งจริงที่เกมยิงตอนคุณกดใส่ทาวเวอร์
    --  ถ้าเพิ่งเปิดสคริปต์แล้วยังไม่ได้แตะช่องทาวเวอร์เลย จะยังไม่มีอะไรให้บันทึก
