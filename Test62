--  ตัวเก็บสถานะของผู้เล่น — ที่อยู่ของรางวัลทั้งหมด
--
--  เส้นทางมาจากโมดูล MapManager ของเกมเอง ซึ่งเรียกแบบนี้ตรงๆ:
--    require(ReplicatedStorage.Client.Modules.Replicators.PlayerReplicator)
--        .GetLocalPlayer():expect()
--
--  แต่ :expect() จะโยน error ถ้า Promise ยังไม่เสร็จ จึงต้องมีทางสำรอง
--  เก็บผลไว้ใช้ซ้ำด้วย เพราะตอนจบเกมมีเวลาไม่กี่วินาทีก่อนย้ายเซิร์ฟเวอร์
local cachedRep = nil

local function playerReplicator()
    if cachedRep then return cachedRep end

    local ok, mod = pcall(function()
        return require(ReplicatedStorage.Client.Modules.Replicators.PlayerReplicator)
    end)
    if not ok or type(mod) ~= "table" then
        return nil, "could not require PlayerReplicator: " .. tostring(mod)
    end
    if type(mod.GetLocalPlayer) ~= "function" then
        return nil, "module has no GetLocalPlayer"
    end

    --  :expect() โยน error ตอนยังไม่พร้อม ส่วน :await() คืน (ok, ค่า) แทน
    --  ลอง await ก่อนเพราะไม่โยน error แล้วค่อยถอยไป expect
    local rep
    local okA, a1, a2 = pcall(function()
        local pr = mod.GetLocalPlayer()
        if type(pr.await) == "function" then return pr:await() end
        return true, pr:expect()
    end)
    if okA and a1 then rep = a2 end

    if not rep then
        local okE, r = pcall(function() return mod.GetLocalPlayer():expect() end)
        if okE then rep = r end
    end

    if not rep then return nil, "GetLocalPlayer returned nothing" end

    cachedRep = rep
    return rep
end

