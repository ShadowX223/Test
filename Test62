--  สุ่มแมพจากกระดานที่มีอยู่จริง
--
--  ไม่สุ่มจากรายชื่อแมพทั้งเกม เพราะแมพที่ไม่ได้ขึ้นกระดานโหวตไม่ได้อยู่แล้ว
--  (ยกเว้นมี VIP ไว้บังคับ ซึ่งโหมดสุ่มไม่ควรไปยุ่ง — จุดประสงค์คือเอาอะไรก็ได้ที่มี)
--
--  สุ่มครั้งเดียวต่อรอบโหวต แล้วจำไว้
--  สุ่มใหม่ทุกครั้งที่ลูปวนจะกลายเป็นเปลี่ยนใจไปเรื่อยๆ แล้วไม่ได้โหวตสักแมพ
local function randomBoardMap()
    local lb = lobbyFolder()
    local boards = lb and lb:FindFirstChild("Boards")
    if not boards then return nil end

    local pool = {}
    for _, b in ipairs(boards:GetChildren()) do
        local title = boardMapTitle(b)
        if type(title) == "string" and title ~= "" then
            table.insert(pool, title)
        end
    end
    if #pool == 0 then return nil end

    --  เรียงชื่อก่อนสุ่ม ลำดับลูกใน Roblox ไม่คงที่
