            if not route then
                text = "No lane found - you must be in a match"
            else
                local mid = circleCenter()
                text = table.concat({
                    ("Lanes: %s (%d circle(s))"):format(
                        (function()
                            local t = {}
                            for _, r in ipairs(selectedRoutes()) do table.insert(t, r.name) end
                            return table.concat(t, ", ")
                        end)(), #damageCircles()),
                    ("Circle at %d%%, radius %d, spacing %.1f"):format(posAlong, posRadius, posGap),
                    posFarmOn
                        and ("Farm circle at %d%%, radius %d"):format(posFarmAlong, posFarmRadius)
                        or "Farm circle off",
                    OPT.focusFarm and ("Focus farm: %s"):format(tostring(farmWhy)) or "",
                    knownSlotText(),
                    mid and ("Centre (%.0f, %.0f)"):format(mid.X, mid.Z) or "",
                    "",
                    posMsg,
