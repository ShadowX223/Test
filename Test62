--  ทำงานเฉพาะตอนเปิดระบบอัตโนมัติไว้เท่านั้น
--  ถ้าผู้ใช้แค่เปิดสคริปต์ทิ้งไว้เฉยๆ แล้วโดนลากออกจากเกมคงไม่ใช่สิ่งที่ต้องการ
task.spawn(function()
    local mark, markAt = "", os.clock()

    while ALIVE do
        task.wait(5)

        local armed = autoJoin or autoVote or playing or wantPlay
        if not (OPT.watchdog and armed) then
            markAt = os.clock()
        else
            local okF, now = pcall(function()
                return ("%s|%s|%s|%s|%s"):format(
                    tostring(inMainLobby()), tostring(inLobby()), tostring(inGame()),
                    tostring(getWave()),
                    tostring(resume and resume.index or 0))
            end)
            if not okF then now = mark end

            if now ~= mark then
                mark, markAt = now, os.clock()

            elseif os.clock() - markAt > (OPT.watchdogMin * 60) then
                markAt = os.clock()
                status = ("Stuck for over %d minute(s) - recovering"):format(OPT.watchdogMin)

                if OPT.watchdogAction == "Rejoin same server" then
                    pcall(function()
                        game:GetService("TeleportService")
                            :TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
                    end)
                else
                    pcall(leaveToMainLobby)
                end
                task.wait(15)
            end
        end
    end
end)

-- ── ตั้งทาวเวอร์ให้ตรงกับมาโคร ───────────────────
--
--  ช่องทาวเวอร์ไม่ตรงกับตอนอัด = คำสั่งวางพลาดทั้งรอบแบบเงียบๆ
--  ตอนอัดเราเก็บ macro.slots ไว้แล้ว (ช่อง → ชื่อทาวเวอร์) เอามาใช้ได้เลย
--
--  คำสั่งเดียวกับตอนวางทาวเวอร์ แต่มีตัวที่สามเป็น true
--      RE("Streaming", "SelectTower", ชื่อ, สกิน, true)
--  ดักของจริงมาแล้วตอนอยู่ล็อบบี้หลักและกดเปลี่ยนทาวเวอร์ด้วยมือ
--
--  สกินไม่ได้เก็บแยกตามช่อง แต่คำสั่งวางแต่ละอันมี a.skin อยู่ จึงดึงจากตรงนั้น
local function macroLoadout()
    if not macro then return nil end

    --  สกินไม่ได้เก็บแยกไว้ แต่คำสั่งวางทุกอันมี a.skin ติดมาด้วย
    local skinOf = {}
    for _, a in ipairs(macro.actions or {}) do
        if a.type == "place" and a.tower and not skinOf[a.tower] then
            skinOf[a.tower] = a.skin or "Default"
        end
    end

    --  เอาจาก macro.towers เป็นหลัก เพราะสร้างจากคำสั่งวางจริงตอนอัด
    --  macro.slots เก็บเลขช่องไว้ก็จริง แต่มาโครเก่าบางไฟล์ไม่มีข้อมูลนี้
    local seen, out = {}, {}
    for _, name in ipairs(macro.towers or {}) do
        if not seen[name] then
            seen[name] = true
            table.insert(out, { name = name, skin = skinOf[name] or "Default" })
        end
    end
    for _, name in pairs(macro.slots or {}) do
        if type(name) == "string" and not seen[name] then
            seen[name] = true
            table.insert(out, { name = name, skin = skinOf[name] or "Default" })
        end
    end
    return out
end

--  ใส่อยู่ตรงกับที่มาโครต้องใช้แล้วหรือยัง
local function loadoutMatches()
    local list = macroLoadout()
    if not (list and #list > 0) then return true end
    for _, t in ipairs(list) do
        if not liveEquip[t.name] then return false end
    end
    return true
end

--  ยิงถี่ไม่ได้
--
--  ทุกครั้งที่เปลี่ยนทาวเวอร์ เกมจะสร้างหน้าตัวอย่างทาวเวอร์ใหม่
--  ยิงรัวเกินไปแล้วมันสร้างไม่ทัน จะขึ้น error ของเกมเอง
--      PivotTo is not a valid member of Folder ... worldModel.Skins
--      (TowerPreview บรรทัด 212 — เรียกตอนโฟลเดอร์ยังว่าง)
--  ไม่ได้ทำให้อะไรพัง แต่รกและไม่จำเป็น เว้นจังหวะให้มันตามทันดีกว่า
--
--  ตัวที่ใส่อยู่แล้วก็ข้ามไปเลย ไม่ต้องยิงซ้ำให้เสียเที่ยว
local function applyLoadout()
    local list = macroLoadout()
    if not (list and #list > 0 and RE) then return false end

    local sent = 0
    for _, t in ipairs(list) do
        if liveEquip[t.name] ~= t.skin then
            pcall(function()
                RE:FireServer("Streaming", "SelectTower", t.name, t.skin, true)
            end)
            liveEquip[t.name] = t.skin
            sent = sent + 1
            task.wait(0.6)
        end
    end
    return true, sent
end

--  ใส่ทาวเวอร์ให้เองตอนอยู่ล็อบบี้
--
--  ต้องทำที่ล็อบบี้เท่านั้น เข้าด่านแล้วช่องทาวเวอร์ล็อกไปแล้ว แก้ไม่ได้อีก
--  ทำครั้งเดียวต่อการเข้าล็อบบี้หนึ่งครั้ง ไม่ใช่วนยิงรัวๆ
task.spawn(function()
    local doneFor = nil

    while ALIVE do
        task.wait(3)

        local atLobby = inMainLobby() or inLobby()
        if not atLobby then
            doneFor = nil

        elseif OPT.autoLoadout and macro and currentName ~= doneFor then
            if loadoutMatches() then
                doneFor = currentName
            else
                local ok, sent = applyLoadout()
                if ok then
                    doneFor = currentName
                    if (sent or 0) > 0 then
                        status = ("Equipped the macro's towers (%d)"):format(sent)
                    end
                end
            end
        end
    end
end)

