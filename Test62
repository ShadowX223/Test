--  ชื่อคอนฟิกที่ถูกตั้งให้โหลดอัตโนมัติ (nil = ยังไม่เคยตั้ง)
local AUTOLOAD_FILE = CFG_DIR .. "/settings/autoload.txt"

local function currentAutoload()
    if not (isfile and readfile and isfile(AUTOLOAD_FILE)) then return nil end
    local ok, name = pcall(readfile, AUTOLOAD_FILE)
    if ok and type(name) == "string" then
        name = name:gsub("%s+$", "")
        if name ~= "" then return name end
    end
    return nil
end

--  ยังไม่เคยตั้งคอนฟิกไว้ → สร้าง autosave แล้วตั้งให้โหลดเองตั้งแต่ครั้งหน้า
if not currentAutoload() then
    pcall(function() makefolder(CFG_DIR) end)
    pcall(function() makefolder(CFG_DIR .. "/settings") end)
    pcall(function() SaveManager:Save(AUTO_CFG) end)
    pcall(function() writefile(AUTOLOAD_FILE, AUTO_CFG) end)
    pcall(function() SaveManager:RefreshConfigList() end)
end

