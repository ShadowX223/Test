        task.wait(0.25)
    end

    UserInputService.InputBegan:Connect(function(input, typing)
        if typing then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end

        if not vpFrame or not vpFrame.Parent then findVpFrame() end

        local inside, x, y = tapInside(input.Position.X, input.Position.Y)
        if not inside then return end

        --  กันแตะรัวจนได้จุดซ้อนกันหลายจุดจากนิ้วเดียว
        if os.clock() - lastTap < 0.2 then return end
        lastTap = os.clock()

        task.spawn(addPoint, x, y)
    end)
end)

