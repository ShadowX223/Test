--  ระยะโจมตีจริงของทาวเวอร์ตัวนี้ ณ ตอนนี้
--
--  @Range เป็นแอตทริบิวต์สดบน TowerReplicator ที่เซิร์ฟเวอร์อัปเดตให้เอง
--  ตรงกับระดับปัจจุบันอยู่แล้ว ไม่ต้องไปคำนวณจากโมดูลเอง
--  (ยืนยันแล้ว: DJ Booth ขั้น 2 ได้ 15 · ขั้น 5 ได้ 18 ตรงกับตารางในโมดูลเป๊ะ)
--
--  @RangeBuff เป็นเปอร์เซ็นต์ ไม่ใช่จำนวนสตัด
--  หลักฐาน: Scout มี @Range 17.5 กับ @RangeBuff 12.5 ตอนมี DJ แทร็ก Purple อยู่ใกล้
--  และในโมดูลของ DJ เขียนไว้ว่า PurpleTrackBuffs.Range = 12.5
--  ถ้าเป็นสตัดจริง Scout จะยิงไกล 30 ซึ่งไกลเกินจริงไปมาก
local function tRange(m)
    local r = rep(m)
    if not r then return nil end
    local base = tonumber(r:GetAttribute("Range"))
    if not base or base <= 0 then return nil end
    local buff = tonumber(r:GetAttribute("RangeBuff")) or 0
    return base * (1 + buff / 100)
end

--  บอสที่ใกล้ทาวเวอร์ตัวนี้ที่สุด ห่างเท่าไหร่ (คืน nil ถ้าไม่มีบอสหรืออ่านไม่ได้)
--
--  วัดแบบราบ ตัดแกน Y ทิ้ง เพราะระยะของทาวเวอร์เป็นวงกลมบนพื้น ไม่ใช่ทรงกลม
--  บอสตัวสูงหรือตัวที่เดินบนสะพานจะได้ไม่ถูกนับว่าไกลกว่าความจริง
local function bossDistance(m)
    local r = rep(m)
    local tp = r and r:GetAttribute("Position")
    if typeof(tp) ~= "Vector3" then
        local ok, pv = pcall(function() return m:GetPivot().Position end)
        tp = ok and pv or nil
    end
    if typeof(tp) ~= "Vector3" then return nil end

    local best
    for _, bp in ipairs(bossPositions()) do
        local dx, dz = bp.X - tp.X, bp.Z - tp.Z
        local d = math.sqrt(dx * dx + dz * dz)
        if not best or d < best then best = d end
    end
    return best
end

--  บอสเข้าระยะของทาวเวอร์ตัวนี้แล้วหรือยัง
--  คืน nil = อ่านไม่ได้ (ไม่ใช่ "ยังไม่เข้า") ตัวเรียกจะได้แยกสองกรณีนี้ออกจากกัน
local function bossInRange(m)
    local rng = tRange(m)
    if not rng then return nil end
    local d = bossDistance(m)
    if not d then return nil end
    return d <= rng, d, rng
end

--  ราคาอัปเกรดขั้นถัดไปของทาวเวอร์ตัวนี้ อ่านสดจากโมดูลเกม
--
--  ดีกว่าราคาที่อัดไว้ทุกทาง เพราะราคาที่อัดวัดจากยอดเงินที่เปลี่ยน
--  ซึ่งเพี้ยนได้ง่ายเวลารัวอัปเกรดหลายครั้งติด (เคยจด 2500 ทั้งที่จ่ายจริง 1300)
--  ส่วนตัวเลขในโมดูลคือของที่เกมใช้จริง ไม่มีทางเพี้ยน
--
--  @GoldenPerks บอกว่าทาวเวอร์ตัวนี้เป็นสกิน Golden หรือเปล่า ซึ่งใช้คนละตารางราคา
--  ราคาอัปเกรดที่ต้องจ่ายจริง
--
--  ราคาในตารางเป็นแค่ราคาตั้ง ของจริงโดนคูณลดหลายชั้น
--  สูตรนี้ลอกมาจากโมดูลของเกมตรงๆ (Upgrade บรรทัด 133)
--
--      v1 = base - (Discount or 0) / 100 * base
--      if PriceScale then v1 = v1 * PriceScale.Value end
--      return math.floor(v1 * (GameRules.Get("UpgradeCostMultiplier") or 1))
--
--  ที่ผ่านมาผมใช้ราคาตั้งเฉยๆ เลยรอเงินผิดยอดเสมอเมื่อมีบัฟส่วนลด
--  (Commander / DJ Booth ให้ส่วนลด และบางโหมดตั้ง PriceScale ไว้ไม่เท่ากับหนึ่ง)
--  รอเยอะเกินก็เสียเวลา รอน้อยเกินก็ยิงแล้วโดนปฏิเสธ
local function upgradeCost(m, path)
    local r = rep(m)
    if not r then return nil end

    local costs = upgradeCosts(tName(m), r:GetAttribute("GoldenPerks") == true)
    if not costs then return nil end

    local base = costs[tLevel(m) + 1]

    --  ขั้นแยกสายคืนมาเป็นตาราง ต้องเลือกสายก่อน
    --  รู้สายที่จะไป (มาโครจดไว้) ก็ใช้สายนั้น
    --  ไม่รู้ก็เอาสายที่ถูกที่สุด เพื่อไม่ให้รอเงินเกินจำเป็นจนไม่ได้อัปเลย
    if type(base) == "table" then
        local pick = path and base[path] or nil
        if not pick then
            for _, c in pairs(base) do
                if type(c) == "number" and (not pick or c < pick) then pick = c end
            end
        end
        base = pick
    end

    if not base then return nil end     -- ตันแล้ว

    local price = base

    --  ส่วนลดเป็นเปอร์เซ็นต์
    --
    --  ⚠ ไม่ใช่ attribute อย่างที่ผมเดาไว้ตอนแรก
    --  TowerBuffs บรรทัด 70 อ่านแบบนี้
    --      v1 = p1:FindFirstChild("Discount")
    --      if typeof(v1.Value) == "number" and 0 < v1.Value then ...
    --  แปลว่ามันเป็นออบเจกต์ลูกที่มี .Value ไม่ใช่ค่าที่ติดมากับตัว
    --
    --  ไม่รู้แน่ว่าลูกตัวนี้แขวนอยู่กับอะไร จึงมองสามที่ตามลำดับความน่าจะเป็น
    --  เจอที่ไหนก่อนใช้ที่นั่น ไม่เจอเลยก็ถือว่าไม่มีส่วนลด ราคาก็เท่าเดิม
    pcall(function()
        local d = 0

        local function readFrom(box)
            if not box then return end
            local v = box:FindFirstChild("Discount")
            if v and typeof(v.Value) == "number" and v.Value > 0 then
                d = v.Value
            end
        end

        readFrom(r)                                 -- ใน TowerReplicator
        if d == 0 then readFrom(m) end              -- ใต้ตัวโมเดลเอง
        if d == 0 then readFrom(m:FindFirstChild("Buffs")) end

        --  เผื่อเป็น attribute จริงในบางรุ่น อ่านไว้เป็นทางสุดท้าย
        if d == 0 then d = tonumber(r:GetAttribute("Discount")) or 0 end

        if d > 0 then price = price - d / 100 * price end
    end)

    --  ตัวคูณของด่าน อยู่ที่ ReplicatedStorage.State.PriceScale
    pcall(function()
        local st = ReplicatedStorage:FindFirstChild("State")
        local ps = st and st:FindFirstChild("PriceScale")
        local v  = ps and tonumber(ps.Value)
        if v and v > 0 then price = price * v end
    end)

    --  ตัวคูณของโหมด
    pcall(function()
        local gr = ReplicatedStorage:FindFirstChild("Shared")
        gr = gr and gr:FindFirstChild("Modules")
        gr = gr and gr:FindFirstChild("GameRules")
        if not (gr and gr:IsA("ModuleScript")) then return end

        local mod = require(gr)
        local get = type(mod) == "table" and mod.Get
        if type(get) ~= "function" then return end

        local mul = tonumber(get("UpgradeCostMultiplier"))
        if mul and mul > 0 then price = price * mul end
    end)

    return math.floor(price)
end

