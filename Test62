local function layoutTotal(lay)
    local n = 0
    for i = 1, 6 do n = n + layoutCount(lay, i) end
    return n
end

--  ค่าของวงเก็บรวมในไฟล์เดียวกับจุดของ Play Map
--  แยกตามแมพเหมือนกัน เพราะเส้นทางกับพื้นที่ของแต่ละแมพคนละเรื่องกันสิ้นเชิง
local function stampPosSettings()
    if not layout then return end
    layout.pos = {
        along  = posAlong,
        radius = posRadius,
        gap    = posGap,
        route  = posRoute,
        lanes  = posLanes,
        farmOn     = posFarmOn,
        farmAlong  = posFarmAlong,
        farmRadius = posFarmRadius,
    }
end

local function saveLayout()
    if not (layout and layout.map) then return false end
    stampPosSettings()
    ensureLayoutFolder()
    return (pcall(function()
        writefile(layoutPath(layout.map), HttpService:JSONEncode(layout))
    end))
end

--  โหลดชุดจุดของแมพที่อยู่ตอนนี้
--
--  จุดของแมพหนึ่งเอาไปใช้กับอีกแมพไม่ได้เลย พิกัดคนละเรื่องกันสิ้นเชิง
--  ถ้าไม่แยกไฟล์ตามแมพ ผลที่ได้คือสั่งวางลงกลางอากาศทั้งชุด
local function loadLayout(force)
    local mapName = getMapName()
    if not mapName or mapName == "" or mapName == "?" then return nil end
    if layout and layout.map == mapName and not force then return layout end

    local path = layoutPath(mapName)
    if isfile and isfile(path) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
        if ok and type(data) == "table" and type(data.slots) == "table" then
            data.map = mapName
            for i = 1, 6 do
                data.slots[tostring(i)] = data.slots[tostring(i)] or {}
            end
            layout = data

            --  คืนค่าวงที่ตั้งไว้ของแมพนี้ พร้อมเด้งสไลเดอร์ให้ตรง
            --  ไม่เด้งสไลเดอร์ด้วยจะสับสนหนัก ตัวเลขบนจอกับที่ใช้จริงคนละค่า
            if type(data.pos) == "table" then
                posAlong  = tonumber(data.pos.along)  or posAlong
                posRadius = tonumber(data.pos.radius) or posRadius
                posGap    = tonumber(data.pos.gap)    or posGap
                if type(data.pos.route) == "string" then posRoute = data.pos.route end
                if type(data.pos.lanes) == "table" then posLanes = data.pos.lanes end
                if data.pos.farmOn ~= nil then posFarmOn = data.pos.farmOn and true or false end
                posFarmAlong  = tonumber(data.pos.farmAlong)  or posFarmAlong
                posFarmRadius = tonumber(data.pos.farmRadius) or posFarmRadius

                task.defer(function()
                    pcall(function() uiSet(AlongSlider,  posAlong)  end)
                    pcall(function() uiSet(RadiusSlider, posRadius) end)
                    pcall(function() uiSet(GapSlider,    posGap)    end)
                    pcall(function() uiSet(FarmAlongSlider,  posFarmAlong)  end)
                    pcall(function() uiSet(FarmRadiusSlider, posFarmRadius) end)
                end)
            end

            return layout
        end
    end

    layout = blankLayout(mapName)
    return layout
end

