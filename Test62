--  ส่ง JSON ไปที่ Webhook พร้อมลองซ้ำ
--
--  ลองซ้ำเพราะจังหวะจบเกมเป็นช่วงที่เปราะที่สุด — เกมกำลังย้ายเซิร์ฟเวอร์
--  คำขอที่ยิงไปตอนนั้นถูกตัดกลางทางได้ แล้ว executer จะคืนตารางที่ไม่มี StatusCode
--  ซึ่งเป็นอาการเดียวกับที่เห็น: กดปุ่มทดสอบได้ 204 แต่ตอนจบแมตช์ได้ "?"
local function postJSON(payload)
    if webhookURL == "" then
        return false, "No link in the Webhook URL box yet"
    end
    if not webhookURL:match("^https://discord%.com/api/webhooks/")
        and not webhookURL:match("^https://discordapp%.com/api/webhooks/") then
        return false, "That is not a Discord webhook link: " .. webhookURL:sub(1, 40)
    end
    if not httpPost then
        return false, "Your executor has no HTTP function (http_request / request / syn.request)"
    end

    local body = HttpService:JSONEncode(payload)
    local lastWhy

    for attempt = 1, 3 do
        local ok, res = pcall(httpPost, {
            Url     = webhookURL,
            Method  = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body    = body,
        })

        if ok then
            local code = type(res) == "table" and (res.StatusCode or res.Status) or nil
            local why  = type(res) == "table" and (res.Body or res.StatusMessage) or nil

            --  Discord ตอบ 204 เมื่อสำเร็จ ไม่ใช่ 200
            if code == 200 or code == 204 then
                return true, ("Sent (HTTP %s%s)"):format(
                    tostring(code), attempt > 1 and (" - attempt " .. attempt) or "")
            end

            --  executer บางตัวไม่คืน StatusCode มาให้ แต่มีธง Success แทน
            if code == nil and type(res) == "table" and res.Success == true then
                return true, "Sent (executor reported success without a code)"
            end

            lastWhy = ("HTTP %s %s"):format(
                tostring(code or "?"), tostring(why or ""):sub(1, 100))
        else
            lastWhy = "HTTP call failed: " .. tostring(res)
        end

        if attempt < 3 then task.wait(1.5) end
    end

    return false, tostring(lastWhy)
end

