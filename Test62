posGen      = 0

posFarmOn     = false
posFarmAlong  = 50
posFarmRadius = 20
posLanes      = nil

--  ระยะห่างขั้นต่ำระหว่างทาวเวอร์สองตัว
--
--  วางชิดกันเกินไปเซิร์ฟเวอร์ปฏิเสธ แล้วเราจะเสียเวลายิงคำสั่งที่ไม่มีวันสำเร็จ
--  กันไว้ตั้งแต่ตอนเลือกจุดดีกว่า
--  ค่าเริ่มต้น 5.5 กว้างเกินจริง ผู้เล่นวางชิดกว่านี้ได้เยอะ
--  จึงเปิดให้ปรับเอง และจำแยกตามแมพ เพราะแต่ละแมพพื้นที่ไม่เท่ากัน
posGap = 4.0

--  อ่านเส้นทางทั้งหมดที่แมพนี้มี
--
--  ลำดับของจุดสำคัญมาก ต่อผิดลำดับเส้นทางจะกระโดดข้ามแมพไปมา
--  GetChildren ไม่รับประกันลำดับ จึงเรียงตามเลขในชื่อก่อน
--  แล้ววัดความยาวเทียบกับลำดับเดิม เอาแบบที่สั้นกว่า
--  เพราะลำดับที่ถูกต้องย่อมไม่มีการวิ่งกลับไปกลับมา
local function routeLength(pts)
    local total = 0
    for i = 2, #pts do total = total + (pts[i] - pts[i-1]).Magnitude end
    return total
end

--  ต่อจุดเป็นเส้นทาง
--
--  ⚠ วิธีเดิมใช้ไม่ได้ และนี่คือสาเหตุที่วงหลุดออกนอกแมพ
--    เดิมเทียบความยาวสองแบบแล้วเอาแบบที่สั้นกว่า
--    แต่ถ้าลำดับดิบมั่วทั้งคู่ ก็ได้แบบที่ "มั่วน้อยกว่า" มาอยู่ดี ไม่ใช่แบบที่ถูก
--
--  วิธีใหม่ต่อจุดแบบเดินหาเพื่อนบ้านที่ใกล้ที่สุด
--    เริ่มจากปลายเส้น (จุดที่ไกลจากใจกลางกลุ่มที่สุด)
--    แล้วเดินไปหาจุดที่ยังไม่ได้ใช้ซึ่งใกล้ที่สุด ทำจนครบ
--  ทางเดินในเกมไม่ตัดทับตัวเอง วิธีนี้จึงได้ลำดับที่ถูกเสมอ
--  โดยไม่ต้องพึ่งว่าเกมจะตั้งชื่อจุดเป็นตัวเลขหรือเปล่า
local function chainPoints(list)
    if #list <= 2 then return list end

    local mid = Vector3.new()
    for _, p in ipairs(list) do mid = mid + p end
    mid = mid / #list

    --  ปลายเส้นคือจุดที่ไกลจากใจกลางที่สุด
    local startAt, far = 1, -1
    for i, p in ipairs(list) do
        local d = (p - mid).Magnitude
        if d > far then startAt, far = i, d end
    end

    local used, out = {}, {}
    local cur = startAt
    used[cur] = true
    table.insert(out, list[cur])

    for _ = 2, #list do
        local best, bestD = nil, nil
        for i, p in ipairs(list) do
            if not used[i] then
                local d = (p - list[cur]).Magnitude
                if not bestD or d < bestD then best, bestD = i, d end
            end
        end
        if not best then break end
        used[best] = true
        cur = best
        table.insert(out, list[cur])
    end
    return out
end

local function pathRoutes()
    local map   = workspace:FindFirstChild("Map")
    local paths = map and map:FindFirstChild("Paths")
    if not paths then return {} end

    local out = {}
    for _, route in ipairs(paths:GetChildren()) do
        --  เอาเฉพาะลูกชั้นแรก ไม่ลงลึก
        --  ลงลึกจะได้ชิ้นส่วนย่อยของจุดติดมาด้วย แล้วเส้นทางจะพันกันเป็นกระจุก
        local parts = {}
        for _, d in ipairs(route:GetChildren()) do
            if d:IsA("BasePart") then table.insert(parts, d) end
        end
        if #parts < 2 then
            for _, d in ipairs(route:GetDescendants()) do
                if d:IsA("BasePart") then table.insert(parts, d) end
            end
        end

        if #parts >= 2 then
            local allNum = true
            for _, p in ipairs(parts) do
                if not tonumber(p.Name) then allNum = false break end
            end

            local pts = {}
            if allNum then
                --  ชื่อเป็นตัวเลข = เกมบอกลำดับไว้แล้ว เชื่อได้เลย
                table.sort(parts, function(a, b)
                    return tonumber(a.Name) < tonumber(b.Name)
                end)
                for _, p in ipairs(parts) do table.insert(pts, p.Position) end
            else
                for _, p in ipairs(parts) do table.insert(pts, p.Position) end
                pts = chainPoints(pts)
            end

            table.insert(out, { name = route.Name, points = pts })
        end
    end

    table.sort(out, function(a, b) return a.name < b.name end)
    return out
end

--  จุดบนเส้นทางที่เปอร์เซ็นต์นี้
--
--  ใช้เปอร์เซ็นต์แทนเลขดิบ เพราะแต่ละแมพยาวไม่เท่ากันเลย
--  เลข 10 บนแมพเล็กกับแมพใหญ่จะไปคนละที่กันคนละเรื่อง
local function pointOnRoute(pts, pct)
    if not pts or #pts < 2 then return nil end

    local total = routeLength(pts)
    if total <= 0 then return pts[1] end

    local want, run = total * math.clamp(pct, 0, 100) / 100, 0
    for i = 2, #pts do
        local seg = (pts[i] - pts[i-1]).Magnitude
        if run + seg >= want then
            local t = (seg > 0) and ((want - run) / seg) or 0
            return pts[i-1]:Lerp(pts[i], t)
        end
        run = run + seg
    end
    return pts[#pts]
end

--  เลนที่เลือกไว้ทั้งหมด
--
--  ไม่เลือกอะไรเลย = เอาทุกเลน เพราะปล่อยเลนใดเลนหนึ่งโล่งคือแพ้แน่นอน
--  ค่าเริ่มต้นควรเป็นสิ่งที่ปลอดภัยที่สุด ไม่ใช่สิ่งที่ผู้ใช้ต้องมาแก้ทีหลัง
local function selectedRoutes()
    local all = pathRoutes()
    if #all == 0 then return {} end
    if not posLanes or next(posLanes) == nil then return all end

    local out = {}
    for _, r in ipairs(all) do
        if posLanes[r.name] then table.insert(out, r) end
    end
    return (#out > 0) and out or all
end

local function currentRoute()
    return selectedRoutes()[1]
end

--  วงของตัวทำดาเมจ หนึ่งวงต่อหนึ่งเลน
local function damageCircles()
    local out = {}
    for i, r in ipairs(selectedRoutes()) do
        local mid = pointOnRoute(r.points, posAlong)
        if mid then
            table.insert(out, {
                mid    = mid,
                radius = posRadius,
                label  = (#selectedRoutes() > 1) and ("Damage %d"):format(i) or "Damage",
            })
        end
    end
    return out
end

local function circleCenter()
    local r = currentRoute()
    return r and pointOnRoute(r.points, posAlong) or nil
end

--  จุดกลางของวงฟาร์ม ปิดวงฟาร์มไว้ก็คืน nil
local function farmCenter()
    if not posFarmOn then return nil end
    local r = currentRoute()
    return r and pointOnRoute(r.points, posFarmAlong) or nil
end

local function placeTargets()
    local out = {}
    for _, name in ipairs({ "Ground", "Cliff" }) do
        local m = workspace:FindFirstChild(name)
        if m then table.insert(out, m) end
    end
    return out
end

--  ขอบเขตพื้นที่เล่นจริง ใช้เล็งกล้อง
local function groundBounds()
    local targets = placeTargets()
    local lo, hi = nil, nil

    for _, root in ipairs(targets) do
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("BasePart") then
                local a = d.Position - d.Size * 0.5
                local b = d.Position + d.Size * 0.5
                lo = lo and Vector3.new(math.min(lo.X,a.X), math.min(lo.Y,a.Y), math.min(lo.Z,a.Z)) or a
                hi = hi and Vector3.new(math.max(hi.X,b.X), math.max(hi.Y,b.Y), math.max(hi.Z,b.Z)) or b
            end
        end
    end
    return lo, hi
end

--  ยิงลำแสงหาจุดวางจริง
--
--  ทำกับ workspace ของจริง ไม่ใช่ของที่ก๊อปลง Viewport
--  เพราะของที่ก๊อปไม่มีตัวตนในโลกฟิสิกส์ ยิงลำแสงใส่ไม่โดน
--  แต่มันตั้งอยู่พิกัดเดียวกันเป๊ะ ลำแสงจากกล้องของ Viewport จึงใช้กับของจริงได้ตรงๆ
local function placeRay(origin, dir)
    local targets = placeTargets()
    if #targets == 0 then return nil end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances = targets
    return workspace:Raycast(origin, dir * 2000, params)
end

-- ── ก้อนหมุดในแมพจริง ────────────────────────────
--
--  ทำเป็นของฝั่งเราล้วน ไม่ยุ่งกับของเกม และตั้ง CanCollide = false
--  ไม่งั้นมันจะไปขวางลำแสงตอนเลือกจุดถัดไป และอาจกันการวางจริงด้วย
local markFolder = nil
local vpMarkFolder = nil     -- ก้อนชุดที่สองสำหรับโชว์บนแผนที่ใน UI

local function clearMarks()
    if markFolder then pcall(function() markFolder:ClearAllChildren() end) end
    if vpMarkFolder then pcall(function() vpMarkFolder:ClearAllChildren() end) end
end

local function makeMark(parent, pos, slot, idx)
    local p = Instance.new("Part")
    p.Shape        = Enum.PartType.Ball
    p.Size         = Vector3.new(3, 3, 3)
    p.Anchored     = true
    p.CanCollide   = false
    p.CanQuery     = false
    p.CanTouch     = false
    p.Material     = Enum.Material.Neon
    p.Color        = SLOT_COLOR[slot] or Color3.new(1, 1, 1)
    p.Transparency = 0.35
    p.Position     = pos + Vector3.new(0, 1.6, 0)
    p.Parent       = parent

    --  เลขช่องกำกับไว้ ไม่งั้นสีหกสีจำไม่ไหว
    local bb = Instance.new("BillboardGui")
    bb.Size          = UDim2.fromOffset(34, 34)
    bb.AlwaysOnTop   = true
    bb.LightInfluence = 0
    bb.Parent        = p

    local lb = Instance.new("TextLabel")
    lb.Size                   = UDim2.fromScale(1, 1)
    lb.BackgroundTransparency = 1
    lb.Text                   = tostring(slot)
    lb.TextColor3             = Color3.new(1, 1, 1)
    lb.TextStrokeTransparency = 0.2
    lb.Font                   = Enum.Font.GothamBold
    lb.TextSize               = 16
    lb.Parent                 = bb

    return p
end

local function refreshMarks()
    clearMarks()

    --  วงต้องขึ้นให้เห็นตอนกำลังปรับสไลเดอร์ ไม่ใช่ขึ้นตอนกดเล่นแล้ว
    --  ปรับไปโดยไม่เห็นอะไรเลยคือปรับแบบหลับตา
    if not (layout and (apShowMarks or posShowRing or posPlay)) then return end

    if not (markFolder and markFolder.Parent) then
        markFolder = Instance.new("Folder")
        markFolder.Name = "ShadowXMarks"
        markFolder.Parent = workspace
    end

    for slot = 1, (apShowMarks and 6 or 0) do
        for idx, pt in ipairs(layout.slots[tostring(slot)] or {}) do
            local pos = Vector3.new(pt[1], pt[2], pt[3])
            pcall(makeMark, markFolder, pos, slot, idx)
            if vpMarkFolder and vpMarkFolder.Parent then
                pcall(makeMark, vpMarkFolder, pos, slot, idx)
            end
        end
    end

    --  วงกลมของ Play Pos วาดที่นี่ด้วย จะได้ล้างพร้อมกันและซิงก์เข้ากรอบทีเดียว
    if posPlay or posShowRing then
        local function drawRing(mid, radius, colour, label)
            local function ring(parent)
                local p = Instance.new("Part")
                p.Shape        = Enum.PartType.Cylinder
                --  ทรงกระบอกของ Roblox นอนตามแกน X ต้องหมุนให้ตั้งก่อน
                p.Size         = Vector3.new(0.4, radius * 2, radius * 2)
                p.CFrame       = CFrame.new(mid + Vector3.new(0, 0.6, 0))
                                 * CFrame.Angles(0, 0, math.rad(90))
                p.Anchored     = true
                p.CanCollide   = false
                p.CanQuery     = false
                p.CanTouch     = false
                p.Material     = Enum.Material.Neon
                p.Color        = colour
                p.Transparency = 0.78
                p.Parent       = parent

                --  ป้ายชื่อวง มีหลายวงแล้วต้องดูออกว่าวงไหนคืออะไร
                --  สีอย่างเดียวไม่พอเมื่อมีวงดาเมจสองวงที่สีเหมือนกัน
                if label then
                    local bb = Instance.new("BillboardGui")
                    bb.Size           = UDim2.fromOffset(120, 26)
                    bb.StudsOffset    = Vector3.new(0, 4, 0)
                    bb.AlwaysOnTop    = true
                    bb.LightInfluence = 0
                    bb.Parent         = p

                    local lb = Instance.new("TextLabel")
                    lb.Size                   = UDim2.fromScale(1, 1)
                    lb.BackgroundTransparency = 1
                    lb.Text                   = label
                    lb.TextColor3             = colour
                    lb.TextStrokeTransparency = 0.2
                    lb.Font                   = Enum.Font.GothamBold
                    lb.TextSize               = 15
                    lb.Parent                 = bb
                end
            end

            if markFolder and markFolder.Parent then pcall(ring, markFolder) end
            if vpMarkFolder and vpMarkFolder.Parent then pcall(ring, vpMarkFolder) end
        end

        --  วงตัวทำดาเมจ ฟ้า — หนึ่งวงต่อหนึ่งเลน
        for _, c in ipairs(damageCircles()) do
            drawRing(c.mid, c.radius, Color3.fromRGB(90, 200, 255), c.label)
        end

        --  วงฟาร์ม เขียว — แยกสีให้ดูออกทันทีว่าอันไหนคืออันไหน
        local fmid = farmCenter()
        if fmid then
            drawRing(fmid, posFarmRadius, Color3.fromRGB(90, 235, 130), "Farm")
        end
    end

    --  บอก Fluent ให้เอาโมเดลไปแสดงใหม่
    --
    --  ตอนแรกจุดไม่ขึ้นในกรอบเลย เพราะ SetObject ก๊อปโมเดลไปวางไว้ข้างใน
    --  ของที่แสดงอยู่จึงเป็นสำเนาที่หยุดนิ่งตั้งแต่ตอนกดโหลด
    --  เราไปเพิ่มจุดในต้นฉบับ สำเนานั้นไม่รู้เรื่องด้วย ต้องสั่งให้เอาไปใหม่
    --
    --  ส่ง keepCamera = true ไม่งั้นมุมกล้องจะเด้งกลับทุกครั้งที่เพิ่มจุด
    if vpElement and vpModel then
        pcall(function() vpElement:SetObject(vpModel, true) end)
    end
end

-- ── แผนที่ใน UI ──────────────────────────────────
--
--  ก๊อป workspace.Map ทั้งก้อนลง Viewport ได้เลย เพราะสำรวจแล้วมีแค่ 368-414 พาร์ต
--  ถ้าเกินสี่พันเมื่อไหร่ต้องเปลี่ยนวิธี แต่ตอนนี้ยังห่างมาก
--
--  กล้องตั้งตรงจากด้านบนลงล่าง เล็งกลางพื้นที่เล่น
--  ระยะคำนวณจากความกว้างจริงของพื้นที่ ไม่ได้ตั้งเลขตายตัว
--  เพราะแต่ละแมพกว้างไม่เท่ากันเลย (200 กับ 80 ในสองแมพที่ลองมา)
local VP_FOV    = 45
local vpZoom    = 1       -- ตัวคูณระยะกล้อง ยิ่งน้อยยิ่งซูมเข้า
local VP_MARGIN = 1.18      -- เผื่อขอบไว้นิดหน่อย ให้เห็นแมพเต็มๆ ไม่ชิดกรอบ

local vpCamera = nil
local vpModel  = nil
local vpFrame  = nil        -- ตัวกรอบจริง เอาไว้ดักการแตะ
local vpElement = nil

--  เล็งกล้องที่ "พื้นที่เล่นจริง" ไม่ใช่ทั้งแมพ
--
--  ⚠ เดิมเล็งที่ Ground ทั้งก้อน ซึ่งบางแมพกว้างมหาศาล
--  ผลคือซูมออกไกลจนพื้นที่ที่วางได้จริงเหลือนิดเดียวกลางจอ จิ้มไม่แม่นเลย
--
--  พื้นที่ที่มีความหมายคือรอบๆ ทางเดินซอมบี้ ทาวเวอร์ต้องอยู่ใกล้ทางถึงจะยิงถึง
--  จึงเล็งที่ขอบเขตของทางเดินแทน แล้วเผื่อรัศมีออกไปรอบด้าน
--  ไม่มีทางเดินค่อยถอยไปใช้ Ground เหมือนเดิม
local function playBounds()
    local r = currentRoute()
    if r and #r.points >= 2 then
        local lo, hi = nil, nil
        for _, p in ipairs(r.points) do
            lo = lo and Vector3.new(math.min(lo.X,p.X), math.min(lo.Y,p.Y), math.min(lo.Z,p.Z)) or p
            hi = hi and Vector3.new(math.max(hi.X,p.X), math.max(hi.Y,p.Y), math.max(hi.Z,p.Z)) or p
        end
        --  เผื่อรอบทางเดินไว้ ทาวเวอร์วางข้างทางไม่ได้อยู่บนทาง
        local pad = Vector3.new(35, 0, 35)
        return lo - pad, hi + pad
    end
    return groundBounds()
end

local function aimCamera()
    if not vpCamera then return end

    local lo, hi = playBounds()
    if not (lo and hi) then return end

    local mid  = (lo + hi) * 0.5
    local span = math.max(hi.X - lo.X, hi.Z - lo.Z, 20)

    --  ระยะที่ทำให้พื้นที่กว้าง span พอดีกรอบ
    local dist = (span * 0.5 * VP_MARGIN * (vpZoom or 1)) / math.tan(math.rad(VP_FOV) * 0.5)

    vpCamera.FieldOfView = VP_FOV
    vpCamera.CFrame = CFrame.lookAt(
        Vector3.new(mid.X, hi.Y + dist, mid.Z),
        Vector3.new(mid.X, hi.Y, mid.Z),
        Vector3.new(0, 0, -1))     -- กันภาพพลิก เพราะมองตรงลงล่างพอดี
end

local function buildMapView()
    local src = workspace:FindFirstChild("Map")
    if not src then return false, "No map yet - you must be in a match" end

    local holder = Instance.new("Model")
    holder.Name = "ShadowXMapView"

    --  Archivable = false ทำให้ Clone คืน nil เงียบๆ ไม่ใช่ error
    --  เกมบางแมพตั้งค่านี้ไว้ ต้องเปิดชั่วคราวแล้วคืนให้เหมือนเดิม
    local ok, why = pcall(function()
        local wasArch = src.Archivable
        if not wasArch then src.Archivable = true end

        local c = src:Clone()
        src.Archivable = wasArch

        if not c then error("The map model could not be copied") end
        c.Parent = holder
    end)
    if not ok then return false, "Could not copy the map: " .. tostring(why) end

    --  ทิ้งของรอบก่อน ไม่งั้นเปลี่ยนแมพทีก็ทับถมไปเรื่อยๆ
    local prev = vpModel
    if prev and prev ~= holder then
        task.delay(1, function() pcall(function() prev:Destroy() end) end)
    end

    --  ระบายพื้นที่ที่วางได้ให้เห็นชัด
    --
    --  ในแผนที่ย่อส่วน แยกไม่ออกเลยว่าตรงไหนวางได้ตรงไหนเป็นถนนหรือของประดับ
    --  จิ้มไปก็โดนปฏิเสธแล้วต้องลองใหม่ไปเรื่อยๆ
    --  ทาบแผ่นเรืองแสงบางๆ ทับพื้นที่วางได้ จะได้เล็งถูกตั้งแต่ครั้งแรก
    pcall(function()
        local paint = Instance.new("Folder")
        paint.Name = "Placeable"
        paint.Parent = holder

        for _, root in ipairs(placeTargets()) do
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("BasePart") then
                    local q = Instance.new("Part")
                    q.Size         = Vector3.new(d.Size.X, 0.2, d.Size.Z)
                    q.CFrame       = CFrame.new(d.Position + Vector3.new(0, d.Size.Y * 0.5 + 0.3, 0))
                    q.Anchored     = true
                    q.CanCollide   = false
                    q.CanQuery     = false
                    q.Material     = Enum.Material.Neon
                    q.Color        = Color3.fromRGB(80, 235, 140)
                    q.Transparency = 0.68
                    q.Parent       = paint
                end
            end
        end
    end)

    vpMarkFolder = Instance.new("Folder")
    vpMarkFolder.Name = "Marks"
    vpMarkFolder.Parent = holder

    vpModel = holder
    if vpElement then pcall(function() vpElement:SetObject(holder, true) end) end
    aimCamera()
    refreshMarks()
    return true
end

--  แตะบนแผนที่แล้วได้พิกัดในโลกจริง
--
--  ViewportFrame ไม่มีตัวช่วยแปลงจุดบนจอเป็นลำแสงเหมือนกล้องหลัก ต้องคิดเอง
--  แปลงพิกัดที่แตะให้เป็นช่วง -1 ถึง 1 แล้วกางตามมุมมองของกล้อง
local function viewportRay(px, py)
    if not vpFrame then return nil end

    --  อ่านกล้องจากกรอบเอง ไม่ใช้ตัวที่เราส่งเข้าไปตอนสร้าง
    --  Fluent อาจสลับกล้องเป็นตัวของมันเอง ถ้ายึดตัวเก่าไว้ มุมที่คำนวณจะผิดหมด
    local cam = vpFrame.CurrentCamera or vpCamera
    if not cam then return nil end

    local pos  = vpFrame.AbsolutePosition
    local size = vpFrame.AbsoluteSize
    if size.X <= 0 or size.Y <= 0 then return nil end

    local nx = ((px - pos.X) / size.X) * 2 - 1
    local ny = 1 - ((py - pos.Y) / size.Y) * 2
    if nx < -1 or nx > 1 or ny < -1 or ny > 1 then return nil end

    local tanHalf = math.tan(math.rad(cam.FieldOfView) * 0.5)
    local aspect  = size.X / size.Y

    local dir = cam.CFrame:VectorToWorldSpace(
        Vector3.new(nx * tanHalf * aspect, ny * tanHalf, -1)).Unit

    return cam.CFrame.Position, dir
end

local function addPoint(px, py)
    if not loadLayout() then
        apMsg = "Cannot read the map name - you must be in a match"
        return
    end

    local origin, dir = viewportRay(px, py)
    if not origin then return end

    local hit = placeRay(origin, dir)
    if not hit then
        apMsg = "You cannot build there - only on the field"
        return
    end

    local p = hit.Position
    local key = tostring(apSlot)
    layout.slots[key] = layout.slots[key] or {}

    --  จุดซ้อนกันเกินไปคือการวางทับตัวเอง เซิร์ฟเวอร์ปฏิเสธอยู่แล้ว กันไว้ตั้งแต่ตอนจิ้ม
    for _, old in ipairs(layout.slots[key]) do
        if (Vector3.new(old[1], old[2], old[3]) - p).Magnitude < 3 then
            apMsg = "That spot overlaps another spot of this slot"
            return
        end
    end

    table.insert(layout.slots[key], { p.X, p.Y, p.Z })
    saveLayout()
    refreshMarks()
    apMsg = ("Slot %d: added spot %d  (%d spots in total)")
        :format(apSlot, #layout.slots[key], layoutTotal(layout))
end

-- ── ตัวเล่นจริง ──────────────────────────────────
--
--  ลำดับตายตัว: วางให้ครบทุกจุดก่อน แล้วค่อยอัพ
--  ถ้าปล่อยให้แย่งเงินกัน จะได้ทาวเวอร์ตัวเดียวเลเวลสูงลิ่วแต่สนามโล่ง
--
--  อัพแบบเวียนทีละขั้น ไม่ใช่ไล่อัพตัวเดียวจนตัน
--  เพราะขั้นแรกๆ ของทุกตัวคุ้มกว่าขั้นท้ายๆ ของตัวเดียวเสมอ
local apGen = 0

--  ตัวนับรอบการเล่น
--
--  ⚠ Rematch เล่นซ้ำแมพเดิมในเซิร์ฟเวอร์เดิม ไม่มีการย้ายที่ ไม่มีการโหลดใหม่
--  ตัวจับ "เข้าแมตช์ใหม่" ของทั้ง Play Map และ Play Pos ดูจากชื่อแมพเป็นหลัก
--  ชื่อแมพไม่เปลี่ยน ทั้งสองตัวจึงคิดว่ายังเป็นแมตช์เดิม
--  แล้วยึดสถานะเก่าไว้ทั้งชุด — idx ชี้เลยท้ายรายการอยู่ ก็รายงานว่า "เต็มวงแล้ว"
--  ทั้งที่เกมลบทาวเวอร์ทิ้งหมดแล้วและสนามโล่ง
--
--  ตัวนับนี้จะขยับทุกครั้งที่ขึ้นรอบใหม่ แล้วเอาไปผูกกับกุญแจของทั้งสองตัว
--  พอตัวเลขเปลี่ยน ทั้งคู่ก็ถือว่าเป็นแมตช์ใหม่และตั้งต้นใหม่เอง
local roundTag = 0

task.spawn(function()
    local lastWave, hadTowers = -1, false

    while ALIVE do
        task.wait(1)
        pcall(function()
            --  ⚠ ห้ามล้าง hadTowers ตรงนี้
            --  ตอน Rematch inGame() วูบเป็นเท็จชั่วขณะ
            --  ถ้าล้างความจำตรงนี้ ก็เท่ากับลบหลักฐานทิ้งพอดีตอนที่ต้องใช้ที่สุด
            --  พอกลับเข้ามาก็ไม่มีอะไรให้เทียบ สัญญาณจึงไม่เคยยิง
            if not inGame() then
                lastWave = -1
                return
            end

            local w = getWave() or 0
            local n = myTowerCount()

            --  สองสัญญาณนี้บอกว่าขึ้นรอบใหม่แน่นอน
            --    เวฟถอยหลัง        เช่น 20 กลับไป 0
            --    ทาวเวอร์หายเกลี้ยง ทั้งที่เมื่อกี้ยังมี
            --  ใช้ทั้งคู่เพราะบางจังหวะเวฟรีเซ็ตช้ากว่าการลบทาวเวอร์
            if (lastWave >= 1 and w < lastWave) or (hadTowers and n == 0) then
                roundTag = roundTag + 1
                resume = nil          -- มาโครต้องเริ่มใหม่ ไม่ใช่เล่นต่อจากที่ค้าง
            end

            lastWave  = w
            hadTowers = n > 0
        end)
    end
end)

