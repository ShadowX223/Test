--
--  ใช้สองที่: เดินไปโหวตแมพ กับ Walk Around ตอนวางทาวเวอร์
--  จึงต้องประกาศไว้เหนือทั้งสองส่วน
local function myHumanoid()
    local ch = LocalPlayer.Character
    if not ch then return nil, nil end
    return ch:FindFirstChildOfClass("Humanoid"), ch
end

--  เดินไปที่จุดหนึ่ง โดยหลบสิ่งกีดขวางและกระโดดข้ามได้
--
--  ของเดิมใช้ Humanoid:MoveTo อย่างเดียว ซึ่งเดินเป็นเส้นตรงล้วนๆ
--  เจอกำแพง โขดหิน หรือขอบทางเมื่อไหร่ก็ไปชนแล้วยืนดันอยู่ตรงนั้นจนหมดเวลา
--
--  PathfindingService ของ Roblox คำนวณเส้นทางอ้อมให้ได้ และบอกด้วยว่า
--  จุดไหนต้องกระโดด (waypoint.Action == Jump) ซึ่งเป็นสิ่งที่ MoveTo ทำเองไม่ได้เลย
--  AgentCanJump เปิดไว้ ไม่งั้นมันจะเลี่ยงทางที่ต้องกระโดดทั้งหมดแล้วบอกว่าไปไม่ได้
--
--  ยังมีตัวจับ "ติดอยู่กับที่" ซ้อนอีกชั้น เพราะเส้นทางที่คำนวณไว้ล่วงหน้า
--  ไม่รู้จักของที่ขยับได้ เช่นผู้เล่นคนอื่นหรือทาวเวอร์ที่เพิ่งวาง
--  ขยับไม่ถึงครึ่งสตัดใน 1.5 วิ = กระโดดหนึ่งที แล้วคำนวณเส้นทางใหม่
local firePrompt = execGlobal("fireproximityprompt")

local PathfindingService = game:GetService("PathfindingService")

local function walkStraight(hum, pos)
    hum:MoveTo(pos)
end

local function walkTo(where, timeout)
    local pos
    if typeof(where) == "Vector3" then
        pos = where
    elseif typeof(where) == "Instance" then
        if where:IsA("BasePart") then
            pos = where.Position
        elseif where:IsA("Attachment") then
            pos = where.WorldPosition
        elseif where:IsA("Model") then
            local ok, pv = pcall(function() return where:GetPivot().Position end)
            pos = ok and pv or nil
        end
    end
    if not pos then return false end

    local deadline = os.clock() + (timeout or 20)
    local lastPos, lastMoveAt

    while os.clock() < deadline do
        local hum, ch = myHumanoid()
        local root = ch and ch:FindFirstChild("HumanoidRootPart")
        if not (hum and root) then task.wait(0.5)
        else
            local here = root.Position
            if (here - pos).Magnitude <= 6 then return true, 0 end

            --  ตรวจว่าติดอยู่กับที่ไหม
            if lastPos and (here - lastPos).Magnitude < 0.5 then
                if lastMoveAt and os.clock() - lastMoveAt > 1.5 then
                    pcall(function()
                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                    end)
                    lastMoveAt = os.clock()
                end
            else
                lastPos, lastMoveAt = here, os.clock()
            end

            --  คำนวณเส้นทางใหม่ทุกครั้งที่วนรอบ
            --  ถ้าคำนวณไม่ได้ (เป้าอยู่กลางอากาศ หรือไม่มีทางไปถึง) ถอยไปเดินตรงแทน
            --  ดีกว่ายืนเฉยๆ เพราะบางครั้งเป้าอยู่ใกล้มากจนเดินตรงก็ถึง
            local path = PathfindingService:CreatePath({
                AgentRadius      = 2,
                AgentHeight      = 5,
                AgentCanJump     = true,
                AgentMaxSlope    = 45,
                WaypointSpacing  = 4,
            })

            local okPath = pcall(function() path:ComputeAsync(here, pos) end)
            local pts = (okPath and path.Status == Enum.PathStatus.Success)
                and path:GetWaypoints() or nil

            if not pts or #pts < 2 then
                walkStraight(hum, pos)
                task.wait(0.3)
            else
                --  เดินตามจุดที่คำนวณไว้ แต่ไม่เดินจนหมดเส้น
                --  คำนวณใหม่บ่อยๆ ทนต่อของที่ขยับได้มากกว่ายึดเส้นเดิมทั้งเส้น
                for i = 2, math.min(#pts, 6) do
                    if os.clock() >= deadline then break end
                    local wp = pts[i]

                    if wp.Action == Enum.PathWaypointAction.Jump then
                        pcall(function()
                            hum:ChangeState(Enum.HumanoidStateType.Jumping)
                        end)
                    end

                    hum:MoveTo(wp.Position)
                    local reached = hum.MoveToFinished:Wait()
                    if not reached then break end

                    local _, ch2 = myHumanoid()
                    local r2 = ch2 and ch2:FindFirstChild("HumanoidRootPart")
                    if r2 and (r2.Position - pos).Magnitude <= 6 then return true, 0 end
                end
            end
        end
    end

    local _, ch = myHumanoid()
    local root = ch and ch:FindFirstChild("HumanoidRootPart")
    return false, root and (root.Position - pos).Magnitude or -1
end


