    Default = {},
    Description = "Each lane you pick gets its own damage circle",
    DropdownOutsideWindow = true,
    Animated = true,
    Callback = function(v)
        posLanes = {}
        if type(v) == "table" then
            for k, on in pairs(v) do
                if on == true then posLanes[tostring(k)] = true
                elseif type(on) == "string" then posLanes[on] = true end
            end
        end
        if next(posLanes) == nil then posLanes = nil end

        posRoute = nil
        saveLayout()
        --  ขอบเขตกล้องอิงทางเดิน เปลี่ยนเลนแล้วต้องเล็งใหม่
        pcall(aimCamera)
        refreshMarks()
    end,
})

