--  นับแยกตามชนิด เช่น "Scout=6 Farm=8"
--  ถ้าการปฏิเสธมาจากลิมิตของทาวเวอร์ชนิดใดชนิดหนึ่ง ตัวเลขนี้จะฟ้องทันที
local function towerBreakdown()
    local f = towersFolder()
    if not f then return "-" end

    local by, total = {}, 0
    for _, m in ipairs(f:GetChildren()) do
        if isMine(m) then
            total = total + 1
            local n = tName(m) or "?"
            by[n] = (by[n] or 0) + 1
        end
    end

    local parts = {}
    for n, c in pairs(by) do table.insert(parts, ("%s=%d"):format(n, c)) end
    table.sort(parts)
    return ("%d towers (%s)"):format(total, table.concat(parts, " "))
end

local function countOfType(name)
    local f = towersFolder()
    if not (f and name) then return 0 end
    local n = 0
    for _, m in ipairs(f:GetChildren()) do
        if isMine(m) and tName(m) == name then n = n + 1 end
    end
    return n
end

local function myTowerCount()
    local f = towersFolder()
    if not f then return 0 end
    local n = 0
    for _, m in ipairs(f:GetChildren()) do
        if isMine(m) then n = n + 1 end
    end
    return n
end

--  หาทาวเวอร์ที่เพิ่งโผล่จากคำสั่งวางของเรา
--
--  exclude คือรายชื่อทาวเวอร์ที่มีอยู่ "ก่อน" ส่งคำสั่ง — จำเป็นมาก
--  ถ้าไม่กันไว้ แล้วผู้ใช้กดเล่นมาโครตอนที่ในสนามมีทาวเวอร์อยู่แล้ว
--  ตัวเก่าที่ยืนอยู่จุดเดียวกันจะถูกนับว่า "วางสำเร็จ" ทันที
--  ทั้งที่คำสั่งจริงถูกปฏิเสธ แล้วคำสั่งอัปเกรดที่ตามมาจะไปลงผิดตัว
--
--  เดิมบังคับให้ตำแหน่งตรงกันในรัศมี 1 สตัด ซึ่งเข้มเกินไปและเป็นบั๊ก:
--  ถ้าเซิร์ฟเวอร์วางให้จริงแต่ขยับตำแหน่งเล็กน้อย หรือ attribute มาช้ากว่าที่รอ
--  เราจะสรุปว่าพลาดแล้วยิงซ้ำ คราวนี้จุดนั้นมีของอยู่แล้วจึงถูกปฏิเสธจริง
--  สุดท้ายมาโครมองว่าวางไม่ขึ้น แล้วข้ามการอัปเกรดของทาวเวอร์ตัวนั้นทั้งหมด
--
--  คำสั่งวางหนึ่งครั้งสร้างทาวเวอร์ได้ตัวเดียว ดังนั้นทาวเวอร์ "ใหม่" ที่เป็น
--  ของเราและชนิดตรงกัน ย่อมเป็นผลจากคำสั่งนี้แน่นอน ไม่ต้องยึดตำแหน่งเป็นเงื่อนไข
--  ใช้ระยะเป็นแค่ตัวตัดสินเวลามีหลายตัวเข้าข่าย
local function findNewTower(before, pos, wantName)
    local f = towersFolder()
    if not f then return nil end

    local best, bestDist
    for _, m in ipairs(f:GetChildren()) do
        if isMine(m) and not modelRef[m] and not (before and before[m]) then
            if (not wantName) or tName(m) == wantName then
                local p = tPos(m)
                local d = (p and pos) and (p - pos).Magnitude or math.huge

                --  กันตัวที่อยู่คนละมุมแมพ เผื่อมีทาวเวอร์โผล่จากทางอื่น
                if d < 12 and (not bestDist or d < bestDist) then
                    best, bestDist = m, d
                end
            end
        end
    end
    return best
end

--  ตามหาทาวเวอร์ของ ref ที่ยังจับคู่ไม่ได้ โดยดูจากตำแหน่งที่อัดไว้
--
--  จำเป็นเพราะบางครั้งเซิร์ฟเวอร์วางให้จริงแต่เราสรุปว่าพลาด (เช่นตอบกลับแปลกๆ
--  หรือจังหวะไม่ลงตัว) ถ้าตัดการอัปเกรดทิ้งไปเลย ทาวเวอร์ตัวนั้นจะอยู่ระดับ 0
--  ทั้งเกม ซึ่งกระทบแรงกว่าการวางพลาดเองเสียอีก
--
--  รัศมี 3 สตัดและต้องเป็นทาวเวอร์ชนิดเดียวกัน — ตำแหน่งที่ส่งกับที่เซิร์ฟเวอร์
--  บันทึกต่างกันแค่ระดับทศนิยม ถ้ากว้างกว่านี้เสี่ยงไปคว้าทาวเวอร์ตัวข้างๆ
--  แล้วอัปเกรดผิดตัว ซึ่งแย่กว่าไม่อัปเกรดเลย
local function recoverRef(ref)
    local want = refPos[ref]
    if not want then return nil end

    local f = towersFolder()
    if not f then return nil end

    local best, bestDist
    for _, m in ipairs(f:GetChildren()) do
        if isMine(m) and not modelRef[m]
            and ((not want.name) or tName(m) == want.name) then
            local p = tPos(m)
            local d = p and (p - want.pos).Magnitude or math.huge
            if d <= 3 and (not bestDist or d < bestDist) then
                best, bestDist = m, d
            end
        end
    end

    if best then
        refModel[ref]  = best
        modelRef[best] = ref
        deadRef[ref]   = nil
    end
    return best
end

--  Data ของสกิลบางตัวไม่ว่าง — สกิลที่ต้องเล็งเป้า (มี AbilityIndicator)
--  จะแนบตำแหน่งหรือค่าอื่นมาด้วย เดิมตอนเล่นผมส่ง Data = {} ตายตัว
--  สกิลพวกนั้นจึงส่งไปแล้วเซิร์ฟเวอร์ไม่รู้จะทำอะไร กลายเป็นไม่ทำงาน
--
--  JSON เก็บ Vector3/CFrame ตรงๆ ไม่ได้ ต้องแปลงเป็นตารางแล้วแปลงกลับ
local function packValue(v, depth)
    depth = depth or 0
    if depth > 5 then return nil end

    local ty = typeof(v)
    if ty == "number" or ty == "string" or ty == "boolean" then
        return v
    elseif ty == "Vector3" then
        return { __t = "v3", v = { v.X, v.Y, v.Z } }
    elseif ty == "Vector2" then
        return { __t = "v2", v = { v.X, v.Y } }
    elseif ty == "CFrame" then
        return { __t = "cf", v = { v:GetComponents() } }
    elseif ty == "Color3" then
        return { __t = "c3", v = { v.R, v.G, v.B } }
    elseif ty == "table" then
        local out = {}
        for k, val in pairs(v) do
            if type(k) == "string" or type(k) == "number" then
                local packed = packValue(val, depth + 1)
                if packed ~= nil then out[tostring(k)] = packed end
            end
        end
        return out
    end

    --  Instance ชี้ไปที่ของในเกมรอบนั้น รอบใหม่ไม่มีทางหาตัวเดิมเจอ เก็บไม่ได้
    return nil
end

local function unpackValue(v)
    if type(v) ~= "table" then return v end

    local t = v.__t
    if t == "v3" then return Vector3.new(v.v[1], v.v[2], v.v[3])
    elseif t == "v2" then return Vector2.new(v.v[1], v.v[2])
    elseif t == "c3" then return Color3.new(v.v[1], v.v[2], v.v[3])
    elseif t == "cf" then return CFrame.new(table.unpack(v.v))
    end

    local out = {}
    for k, val in pairs(v) do
        --  JSON เปลี่ยนคีย์ตัวเลขเป็นข้อความ ต้องแปลงกลับ ไม่งั้นตารางลำดับจะเสีย
        out[tonumber(k) or k] = unpackValue(val)
    end
    return out
end

