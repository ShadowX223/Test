--  ช่องที่รู้จักแล้ว เอาไว้โชว์ให้เห็นว่าติดตรงไหน
local function knownSlotText()
    local got = {}
    for i = 1, 6 do
        if slotTower[i] then table.insert(got, tostring(i)) end
    end
    if #got == 0 then return "No slots identified yet" end
    if #got == 6 then return "All slots identified" end
    return ("Slots identified: %s"):format(table.concat(got, ", "))
end

--  ขายฟาร์มท้ายเกม
--
--  ฟาร์มมีค่าเฉพาะตอนยังมีเวฟให้เก็บเกี่ยว
--  พอใกล้จบ เงินที่จมอยู่ในฟาร์มมีประโยชน์กว่าถ้าเอามาอัพตัวตี
--  ขายแล้วเงินเข้าทันที ตัวอัพเกรดอัตโนมัติจะเอาไปใช้ต่อเอง
--
--  ขายทีละตัวแล้วเว้นจังหวะ ไม่ขายรวดเดียว
--  เพราะการขายรัวๆ ทำให้ตัวนับทาวเวอร์วูบ แล้วตัวจับ Rematch จะเข้าใจผิดว่าล้างสนาม
local soldWave = -1

task.spawn(function()
