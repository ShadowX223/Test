        macro.towers = names
        macro.slots  = {}
        for i, name in ipairs(names) do macro.slots[tostring(i)] = name end

        status = writeMacro(macro)
            and ("Saved %d tower(s) into the macro"):format(#names)
            or  "Save failed"
    end,
})

