--  ตั้งค่า element ของ UI แบบไม่ต้องรู้ว่าไลบรารีชื่อเมธอดว่าอะไร
--
--  Fluent ใช้ :SetValue() ส่วนไลบรารีอื่นใช้ :Set() แล้วแต่ตัว
--  เครื่องยนต์ไม่ควรต้องรู้เรื่องนี้ ห่อไว้ที่เดียวแล้วเปลี่ยน UI ทีหลังได้โดยไม่ต้องแก้ทั้งไฟล์
local function uiSet(el, v)
    if type(el) ~= "table" then return end
    pcall(function()
        if el.SetValue then el:SetValue(v)
        elseif el.Set then el:Set(v) end
    end)
end

