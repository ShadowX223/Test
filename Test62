--  เควส — รหัสเควสหน้าตาแบบ  daily:TowerSpotlight:3cbf...00
--      Network.Quests["RF:RequestState"]:InvokeServer()   → สถานะทั้งก้อน
--      Network.Quests["RF:ClaimQuest"]:InvokeServer(รหัส) → true เมื่อรับได้จริง
--
--  ไม่เดารูปร่างของสถานะ แต่กวาดหารหัสจากในนั้นแล้วลองรับทีละอัน
--  รหัสมาจากเซิร์ฟเวอร์เองทั้งหมด ไม่ได้แต่งขึ้น
--  อันที่ยังไม่เสร็จเซิร์ฟเวอร์ตอบ false พร้อมเหตุผล ไม่มีผลข้างเคียง
local QUEST_ID = "^%w+:[%w_]+:%x+$"

local function collectQuestIds(v, out, seen, depth)
    out, seen, depth = out or {}, seen or {}, depth or 0
    if depth > 6 or type(v) ~= "table" or seen[v] then return out end
    seen[v] = true

    for k, sub in pairs(v) do
        if type(k) == "string" and k:match(QUEST_ID) then out[k] = true end
        if type(sub) == "string" and sub:match(QUEST_ID) then out[sub] = true end
        if type(sub) == "table" then collectQuestIds(sub, out, seen, depth + 1) end
    end
    return out
end

local function claimQuests()
    local ok, state = netCall("Quests", "RF:RequestState")
    if not (ok and type(state) == "table") then return 0 end

    local ids = {}
    for id in pairs(collectQuestIds(state)) do table.insert(ids, id) end
    table.sort(ids)

    local got = 0
    for _, id in ipairs(ids) do
        local ok2, res = netCall("Quests", "RF:ClaimQuest", id)
        if ok2 and res == true then got = got + 1 end
        task.wait(0.2)
    end
    return got
end

--  ความสำเร็จ — ส่งชื่อไปตรงๆ
--      Network.Achievements["RF:Claim"]:InvokeServer("Recruit")
--  รายชื่อดึงจาก Content.Achievements ซึ่งเป็นรายการของเกมเอง ไม่ได้พิมพ์เอง
--
--  มีห้าสิบกว่าชื่อ ยิงทุกรอบจะถี่เกินไป จึงแยกรอบของตัวเองไว้ทุก 15 นาที
--  และตัวที่รับสำเร็จแล้วจะไม่ยิงซ้ำอีก
local achNames  = nil
local achClaimed = {}
local achNextAt  = 0

local function achievementNames()
    if achNames then return achNames end

    local content = ReplicatedStorage:FindFirstChild("Content")
    local folder  = content and content:FindFirstChild("Achievements")
    if not folder then return nil end

    achNames = {}
    for _, m in ipairs(folder:GetDescendants()) do
        if m:IsA("ModuleScript") then table.insert(achNames, m.Name) end
    end
    table.sort(achNames)
    return achNames
end

local function claimAchievements()
    local names = achievementNames()
    if not names then return 0 end

    local got = 0
    for _, name in ipairs(names) do
        if not achClaimed[name] then
            local ok, res = netCall("Achievements", "RF:Claim", name)
            if ok and res == true then
                achClaimed[name] = true
                got = got + 1
            end
            task.wait(0.2)
        end
    end
    return got
end

local function claimPass(quiet)
    local picked = {}
    for k in pairs(OPT.claim or {}) do table.insert(picked, k) end
    table.sort(picked)

    if #picked == 0 then return "Auto Claim: nothing selected to claim" end

    local done = {}
    local function note(label, got)
        if got > 0 then table.insert(done, ("%s %d"):format(label, got)) end
    end

    for _, k in ipairs(picked) do
        if k == "Playtime" then
            note("Playtime", claimPlaytime())

        elseif k == "Daily Spin" then
            note("Spin", claimSpin())

        elseif k == "Daily Reward" then
            note("Daily", claimDailyReward())

        elseif k == "Quests" then
            note("Quests", claimQuests())

        elseif k == "Achievements" then
            --  กดปุ่มเองไม่ต้องรอรอบ กดแล้วต้องได้ไล่ทันที
            if (not quiet) or os.clock() >= achNextAt then
                achNextAt = os.clock() + 900
                note("Achievements", claimAchievements())
            end
        end
    end

    return "Auto Claim: " .. (#done > 0 and table.concat(done, " · ") or "nothing to claim yet")
end

task.spawn(function()
    local nextAt = 0
    while ALIVE do
        task.wait(5)
        if OPT.autoClaim and os.clock() >= nextAt then
            nextAt = os.clock() + (OPT.claimEvery * 60)
            pcall(claimPass, true)
        end
    end
end)

-- ── ต่อกลับเมื่อหลุด ─────────────────────────────
--
--  ตัวนี้ไม่ได้ใช้คำสั่งของเกมเลย และไม่ได้เดาโปรโตคอลอะไรทั้งนั้น
--
--  ตอนหลุดจริง เซิร์ฟเวอร์ตัดเราไปแล้ว ยิง remote ไปก็ไม่มีใครรับ
--  หมวด Network.Rejoin ที่เจอตอนดัมป์เป็นระบบชวนกลับเข้าห้องในเกม คนละเรื่องกัน
--
--  จังหวะที่ยังทำอะไรได้คือตอนกล่อง "Disconnected" ขึ้นบนจอ
--  ตอนนั้นไคลเอนต์ยังไม่ตาย สคริปต์ยังวิ่งอยู่ สั่งย้ายตัวเองกลับเข้าเกมได้
--  จึงเฝ้าข้อความ error ของ Roblox แล้วสั่งเข้าใหม่ทันทีที่เห็น
--
--  ⚠ ไม่ต่อกลับถ้าโดนแบนหรือโดนเตะ
--    วนเข้าใหม่ตอนโดนแบนคือการเดินเข้าไปให้ระบบจับซ้ำๆ ยิ่งหนักกว่าเดิม
task.spawn(function()
    local GuiService      = game:GetService("GuiService")
    local TeleportService = game:GetService("TeleportService")

    --  ข้อความที่แปลว่า "อย่ากลับเข้ามาอีก"
    local NO_RETRY = {
        "banned", "ban ", "moderation", "kicked", "kick",
        "terminated", "suspended", "not authorized", "cannot join",
    }

    local tried = false

    local function shouldSkip(msg)
        local low = tostring(msg or ""):lower()
        for _, word in ipairs(NO_RETRY) do
            if low:find(word, 1, true) then return true end
        end
        return false
    end

    local function rejoinNow(msg)
        if not (OPT.autoRejoin and ALIVE) or tried then return end
        if shouldSkip(msg) then
            status = "Kicked or banned - will not reconnect"
            return
        end

        tried = true       -- กันสั่งซ้ำ สัญญาณเด้งหลายรอบตอนหลุด
        status = "Disconnected - reconnecting"

        --  ลองกลับเซิร์ฟเวอร์เดิมก่อน ถ้าไม่ได้ค่อยเข้าเซิร์ฟเวอร์ไหนก็ได้
        --  เซิร์ฟเวอร์เดิมมักจะตายไปแล้ว แต่ถ้ายังอยู่จะได้ของที่ค้างไว้กลับมาด้วย
        local ok = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
        end)
        if not ok then
            pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
        end

        --  เผื่อสองทางบนไม่ติด ลองซ้ำเป็นระยะจนกว่าจะไปได้จริง
        task.delay(6, function()
            tried = false
            if OPT.autoRejoin and ALIVE then
                pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
            end
        end)
    end

    pcall(function()
        GuiService.ErrorMessageChanged:Connect(function()
            local msg = GuiService:GetErrorMessage()
            if msg and msg ~= "" then rejoinNow(msg) end
        end)
    end)

    --  ย้ายเซิร์ฟเวอร์แล้วไปไม่ถึง ก็คือหลุดเหมือนกัน
    pcall(function()
        TeleportService.TeleportInitFailed:Connect(function(_, result, msg)
            rejoinNow(msg or tostring(result))
        end)
    end)
end)

