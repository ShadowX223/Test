    end
end)

local function posPlayLoop()
    posGen = posGen + 1
    local myGen = posGen

    task.spawn(function()
        local spots, taken, idx = {}, {}, 1
        local fspots, fidx      = {}, 1     -- ชุดของวงฟาร์ม
        local forMatch = nil
        local placed = 0
        local slotUsed = {}      -- ช่องไหนวางไปแล้วกี่ตัว ใช้เวียนให้ทั่วถึง
        local farmMaxed = false  -- ฟาร์มเต็มลิมิตแล้ว เลิกรอ ปล่อยให้ตัวอื่นใช้เงิน

        while posPlay and posGen == myGen and ALIVE do
            if not inGame() then
                forMatch = nil
                task.wait(2)

            else
                local route = currentRoute()
                if not route then
                    posMsg = "Cannot read the lane on this map (no Map.Paths)"
                    task.wait(4)

                else
                    --  ⚠ ตัวตัดสินสุดท้าย เชื่อสนามจริงเสมอ
                    --
                    --  สัญญาณอื่นพลาดได้หมด (เวฟรีเซ็ตช้า inGame วูบ ชื่อแมพไม่เปลี่ยน)
                    --  แต่สิ่งที่โกหกไม่ได้คือ "เราจดว่าวางไป 44 ตัว แต่ในสนามมีศูนย์"
                    --  แบบนั้นมีทางเดียวคือเกมล้างสนามไปแล้ว ต้องตั้งต้นใหม่ทันที
                    if placed > 0 and myTowerCount() == 0 then
                        forMatch = nil

                    elseif placed > 0 and myTowerCount() < placed then
                        --  ทาวเวอร์หายไปบางส่วน = มีคนขายทิ้ง
                        --  (Auto sell farm ขายให้ หรือผู้เล่นขายเอง หรือเผลอกด)
                        --
                        --  ที่ว่างที่เกิดขึ้นควรได้ทาวเวอร์ตัวใหม่ลงแทน ไม่ใช่ปล่อยโล่ง
                        --  ไม่ตั้งต้นใหม่ทั้งชุดเพราะตัวที่ยังอยู่ก็อยู่ดีของมัน
                        --  แค่ล้างรายการที่จองไว้แล้วสร้างใหม่จากสนามจริง
                        --  จุดที่ว่างจะกลับมาเป็นที่ว่างเอง แล้ววนไปวางตั้งแต่ต้นแถว
                        taken = {}
                        local tf = towersFolder()
                        for _, m in ipairs(tf and tf:GetChildren() or {}) do
                            local p = tPos(m)
                            if p then table.insert(taken, p) end
                        end

                        idx, fidx = 1, 1
                        placed = myTowerCount()
                        posMsg = ("Space freed - refilling (%d towers)"):format(placed)
                    end

                    --  เข้าแมตช์ใหม่ หรือผู้ใช้ขยับวง ก็คำนวณที่วางใหม่
                    local laneKey = {}
                    for _, r in ipairs(selectedRoutes()) do table.insert(laneKey, r.name) end

                    local key = ("%s|%s|%.0f|%.0f|%s|%.0f|%.0f|%d")
                        :format(tostring(getMapName()), table.concat(laneKey, ","),
                                posAlong, posRadius,
                                tostring(posFarmOn), posFarmAlong, posFarmRadius,
                                roundTag)

                    if forMatch ~= key then
                        forMatch = key
                        --  รวมจุดของทุกเลน แล้วสลับกันทีละจุด
                        --  ถ้าต่อท้ายกันเฉยๆ เลนแรกจะกินทาวเวอร์จนหมดก่อน
                        --  เลนที่สองได้ของเหลือหรือไม่ได้เลย ซึ่งแปลว่าแพ้ทางนั้น
                        do
                            local per = {}
                            for _, c in ipairs(damageCircles()) do
                                table.insert(per, ringSpots(c.mid, c.radius))
                            end

                            spots = {}
                            local more, k = true, 1
                            while more do
                                more = false
                                for _, list in ipairs(per) do
                                    if list[k] then
                                        table.insert(spots, list[k])
                                        more = true
                                    end
                                end
                                k = k + 1
                            end
                        end

                        taken, idx, placed = {}, 1, 0
                        fspots, fidx = ringSpots(farmCenter(), posFarmRadius), 1
                        slotUsed = {}
                        farmMaxed = false

                        --  ทาวเวอร์ที่มีอยู่แล้วนับเป็นที่ถูกจองไว้
                        local f = towersFolder()
                        for _, m in ipairs(f and f:GetChildren() or {}) do
                            local p = tPos(m)
                            if p then table.insert(taken, p) end
                        end

                        posMsg = ("Circle at %d%%, radius %d - found %d buildable spots")
                            :format(posAlong, posRadius, #spots)
                    end

                    --  ⚠ ต้องถามใหม่ทุกรอบจนกว่าจะรู้ครบ
                    --
                    --  ของเดิมถามครั้งเดียวตอนเข้าแมตช์ ถ้าตอนนั้นเกมยังไม่พร้อมตอบ
                    --  ก็จะไม่รู้จักช่องไหนเลยตลอดทั้งแมตช์ แล้วนั่งรอเฉยๆ
                    --  จนกว่าผู้เล่นจะวางเอง (ตอนนั้นตัวดักถึงได้ชื่อมา)
                    --  นั่นคืออาการ "ต้องวางเองหนึ่งครั้งก่อนถึงจะวางตาม"
                    --  ตัวเรียนรู้เบื้องหลังทำหน้าที่นี้อยู่แล้ว
                    --  เรียกซ้ำตรงนี้ทุกรอบคือสาเหตุที่วางช้าจนแทบไม่ขยับ
                    local ready, live = slotsReady()
                    local known = 0
                    for _, i in ipairs(live) do
                        if slotTower[i] then known = known + 1 end
                    end

                    if known == 0 then
                        posMsg = "No slots identified yet - press 1-6 once"
                        task.wait(0.5)

                    elseif #spots == 0 then
                        --  ⚠ ศูนย์จุดไม่ใช่ "เต็ม"
                        --  เพิ่งเข้าด่าน พื้นสนามยังโหลดไม่เสร็จ ยิงลำแสงจึงไม่โดนอะไร
                        --  รายงานว่าเต็มตั้งแต่วินาทีแรกคือเข้าใจผิดคนละเรื่อง
                        --  ล้างกุญแจให้คำนวณใหม่ เดี๋ยวพื้นโหลดเสร็จก็เจอเอง
                        forMatch = nil
                        posMsg = "Waiting for the field to load"
                        task.wait(1)

                    elseif idx > #spots
                        and ((not posFarmOn) or fidx > #fspots) then
                        --  เต็มวงแล้วก็ยังต้องเฝ้า
                        --  ทาวเวอร์หายไปเยอะกว่าครึ่ง = โดนล้างสนามหรือโดนทำลาย
                        --  ต้องกลับไปวางใหม่ ไม่ใช่นอนรายงานว่าเต็มอยู่อย่างนั้น
                        if placed > 0 and myTowerCount() < math.floor(placed * 0.5) then
                            forMatch = nil
                        end

                        posMsg = ("Circle is full - placed %d"):format(placed)
                        --  วางครบแล้วก็อัพต่อได้เลย
                        if OPT.autoUpgrade then
                            local done, maxed = apUpgradeRound()
                            if maxed then
                                posMsg = ("Circle full with %d - everything fully upgraded"):format(placed)
                                task.wait(3)
                            else
                                task.wait(done > 0 and 0.05 or 0.5)
                            end
                        else
                            task.wait(2)
                        end

                    else
                        --  เวียนช่อง 1-6 ให้ทั่วถึง ไม่ใช่เทช่องเดียวจนหมดวง
                        --
                        --  ⚠ จุดที่วางไม่ได้ต้องข้ามทิ้ง
                        --
                        --  ของเดิมเลื่อนไปจุดถัดไปเฉพาะตอนวางสำเร็จ
                        --  จุดแรกที่เซิร์ฟเวอร์ปฏิเสธ (ติดขอบทาง พื้นที่ต้องห้าม)
                        --  จึงกลายเป็นกำแพง ลองซ้ำกับทั้งหกช่องแล้ววนกลับมาลองใหม่ไม่รู้จบ
                        --  ไม่มีวันไปถึงจุดที่สอง ทั้งที่มีที่ว่างอีกห้าสิบกว่าจุด
                        --
                        --  คราวนี้แยกให้ออกว่าล้มเหลวเพราะอะไร
                        --    เงินไม่พอ  → รอ อย่าข้าม เดี๋ยวเงินก็มา
                        --    วางไม่ได้  → ข้ามจุดนี้ทิ้ง รอไปก็เท่านั้น
                        local did, noMoney, tries = false, false, 0
                        local atLimit = false

                        --  วงฟาร์มมาก่อน ตามหลักของ Focus farm
                        --  ฟาร์มยิ่งลงเร็วยิ่งคืนทุนเร็ว ตัวตีตามมาทีหลังยังทัน
                        if posFarmOn and farmCenter() and farmPlaceOK() then
                            while fidx <= #fspots and not spotFree(fspots[fidx].pos, taken) do
                                fidx = fidx + 1
                            end

                            --  ⚠ วงฟาร์มไม่มีที่ว่างแล้ว = ห้ามกั้นตัวอื่นต่อ
                            --
                            --  วงฟ้าไม่รับฟาร์ม การกั้นก็ไม่รับตัวอื่น
                            --  ถ้าวงเขียวเต็มด้วย รายการช่องที่ใช้ได้จะว่างเปล่าทุกรอบ
                            --  แล้วสคริปต์จะนั่งรอเงินไปตลอดกาลโดยไม่วางอะไรเลยสักตัว
                            if fidx > #fspots then farmMaxed = true end

                            if fidx <= #fspots then
                                local cashF = getCash()
                                local fTried, fSoft = 0, false

                                for _, slot in ipairs(live) do
                                    local info = slotTower[slot]
                                    if info and isFarm(info.name) then
                                        local si = slotInfo(slot)
                                        local c  = si and si.cost or 0
                                        local cd = si and si.cooldown or 0

                                        if cd > 0 then
                                            fSoft = true                 -- คูลดาวน์ รอได้
                                        elseif cashF and c > cashF then
                                            fSoft = true                 -- เงินไม่พอ รอได้
                                        else
                                            fTried = fTried + 1
                                            local okF2, whyF2 = apPlaceOne(slot, fspots[fidx].pos)

                                            if okF2 then
                                                slotUsed[slot] = (slotUsed[slot] or 0) + 1
                                                table.insert(taken, fspots[fidx].pos)
                                                fidx = fidx + 1
                                                placed = placed + 1
                                                did = true
                                                posMsg = ("Placed %d (farm circle)"):format(placed)
                                                break

                                            elseif whyF2 == "money" or whyF2 == "wait" then
                                                fSoft = true

                                            elseif whyF2 == "limit" then
                                                --  ฟาร์มเต็มลิมิต รอไปก็ไม่ได้อะไร ปลดกั้น
                                                farmMaxed = true
                                                fSoft = true
                                                break
                                            end
                                        end
                                    end
                                end

                                --  ⚠ จุดที่วางไม่ได้ต้องข้ามทิ้ง
                                --
                                --  ผมแก้เรื่องนี้ไปแล้วในวงฟ้าและใน Play Map
                                --  แต่ลืมใส่ในบล็อกวงฟาร์มที่เขียนทีหลัง
                                --  จุดแรกที่เซิร์ฟเวอร์ปฏิเสธจึงกลายเป็นกำแพงถาวร
                                --  ลองซ้ำจุดเดิมไม่รู้จบ ทั้งที่มีที่ว่างอีกเป็นร้อยจุด
                                --  และเพราะการกั้นไม่ยอมให้ตัวอื่นวาง ทั้งระบบเลยหยุดนิ่ง
                                if (not did) and fTried > 0 and not fSoft then
                                    fidx = fidx + 1
                                    posMsg = ("Farm spot unusable - skipped (placed %d)")
                                        :format(placed)
                                end
                            end
                        end

                        --  หาจุดว่างจุดถัดไปก่อน
                        while idx <= #spots and not spotFree(spots[idx].pos, taken) do
                            idx = idx + 1
                        end

                        if idx <= #spots then
                            local pos = spots[idx].pos

                            --  คัดเฉพาะช่องที่ "พร้อมจริง" ก่อนลงมือ
                            --
                            --  ⚠ ของเดิมลองทุกช่องแล้วตั้งธง noMoney ถ้าช่องไหนก็ได้บอกว่าเงินไม่พอ
                            --  มีทาวเวอร์ราคา 700 อยู่ในแถบ พอเงิน 500 ธงนั้นก็ขึ้นทุกรอบ
                            --  แล้วมันไปบังความจริงว่าช่อง 125 ที่ซื้อไหวล้มเหลวเพราะ "ตำแหน่ง"
                            --  ผลคือไม่เคยข้ามจุดเสีย ติดอยู่จุดเดิมตลอดกาล
                            --
                            --  คราวนี้ดูทีละช่องว่าซื้อไหวไหมและพ้นคูลดาวน์หรือยัง
                            --  แล้วลองเฉพาะช่องที่ผ่านทั้งสองด่าน
                            local cash  = getCash()
                            local ready = {}

                            --  เปิดวงฟาร์มไว้ = ฟาร์มไปลงวงของมันเอง ห้ามมาแย่งที่วงหลัก
                            --  วงหลักเหลือไว้ให้ตัวทำดาเมจกับซัพพอร์ตล้วนๆ
                            local farmSeparate = posFarmOn and farmCenter() ~= nil

                            --  Focus farm: กันเงินไว้ให้ฟาร์มก่อน
                            --
                            --  ⚠ นี่คือสาเหตุที่เปิด Focus farm แล้วฟาร์มไม่เคยลงสนาม
                            --  ฟาร์มแพงกว่าตัวอื่น พอเงินยังไม่ถึงราคาฟาร์ม
                            --  ตัวถูกกว่าก็ถูกวางไปก่อนทุกครั้ง เงินเลยไม่มีวันสะสมถึงฟาร์ม
                            --  เรียงฟาร์มไว้หน้าแถวอย่างเดียวไม่พอ ต้องกันเงินด้วย
                            --  ⚠ กันเงินอย่างเดียวยังไม่พอ ต้องกั้นขาดไปเลย
                            --
                            --  ที่ผ่านมาฟาร์มไม่เคยลงสนามเพราะวงจรนี้
                            --    ฟาร์มติดคูลดาวน์ → ไม่กันเงิน → ตัวถูกใช้เงินหมด
                            --    คูลดาวน์ฟาร์มหมด → ไม่มีเงินเหลือแล้ว → วนแบบนี้ทั้งเกม
                            --
                            --  กติกาใหม่ตรงไปตรงมา: เงินถึงราคาฟาร์มเมื่อไหร่ ทำแต่ฟาร์ม
                            --  ฟาร์มติดคูลดาวน์อยู่ก็รอ ไม่เอาเงินไปใช้อย่างอื่น
                            --  เพราะรอไม่กี่วินาที แต่ถ้าใช้ไปแล้วต้องรอเก็บใหม่ทั้งก้อน
                            local farmCost, farmOnly = 0, false
                            if OPT.focusFarm then
                                for _, slot in ipairs(live) do
                                    local ti = slotTower[slot]
                                    if ti and isFarm(ti.name) then
                                        local si = slotInfo(slot)
                                        local c  = si and si.cost or 0
                                        if c > 0 and (farmCost == 0 or c < farmCost) then
                                            farmCost = c
                                        end
                                    end
                                end
                                --  ⚠ ห้ามผูกกับ "เงินถึงราคาฟาร์มแล้ว"
                                --
                                --  นั่นคือบั๊กที่ทำให้ฟาร์มไม่เคยได้ลงสนาม
                                --  เงินยังไม่ถึงราคาฟาร์ม → ตัวถูกวางได้อิสระ → เงินหมด
                                --  → ไม่มีวันไต่ถึงราคาฟาร์ม → วนแบบนี้ทั้งเกม
                                --
                                --  ครบเงื่อนไขเมื่อไหร่ก็กั้นเลย แล้วรอเก็บเงิน
                                --  ยกเว้นฟาร์มเต็มลิมิตแล้ว รอไปก็ไม่ได้อะไร
                                local okF, whyF = farmFirstOK()
                                farmOnly = okF and farmCost > 0 and not farmMaxed

                                farmWhy = okF and (farmMaxed and "farm limit reached" or "on")
                                                or whyF
                                if farmCost == 0 then farmWhy = "no farm in your loadout" end
                                --  บอกตัวอัพเกรดว่าอย่าเพิ่งใช้เงินก้อนนี้
                                farmNeedCash = farmOnly and farmCost or 0

                                if farmOnly and cash and cash < farmCost then
                                    posMsg = ("Focus farm - saving for a farm ($%d/$%d)")
                                        :format(cash, farmCost)
                                end
                            end
                            local farmHold = 0

                            for _, slot in ipairs(live) do
                                if slotTower[slot] then
                                    local isF = isFarm(slotTower[slot].name)
                                    --  โหมดฟาร์มก่อน: รอบนี้รับเฉพาะฟาร์ม
                                    --  ถึงเวฟขายฟาร์มแล้วก็ไม่รับฟาร์มเลย ขายแล้ววางใหม่คือวนเปล่า
                                    if not (farmSeparate and isF)
                                        and not (farmOnly and not isF)
                                        and not (isF and not farmPlaceOK()) then
                                        local info = slotInfo(slot)
                                        local cost = info and info.cost or 0
                                        local cd   = info and info.cooldown or 0
                                        --  ตัวที่ไม่ใช่ฟาร์มต้องเหลือเงินไว้ให้ฟาร์มด้วย
                                        local need = cost + ((isF or farmHold == 0) and 0 or farmHold)
                                        if cd <= 0 and ((not cash) or need <= cash) then
                                            table.insert(ready, {
                                                slot = slot,
                                                cost = cost,
                                                used = slotUsed[slot] or 0,
                                            })
                                        end
                                    end
                                end
                            end

                            --  ใช้ช่องที่วางไปน้อยที่สุดก่อน เพื่อให้ทั่วถึงตามที่ตั้งใจไว้
                            --  เท่ากันก็เอาตัวถูกกว่า จะได้ลงสนามเร็วและเหลือเงินอัพ
                            --  Focus farm: ฟาร์มมาก่อนเสมอ ไม่ว่าจะวางไปแล้วกี่ตัว
                            --  ฟาร์มยิ่งลงเร็วยิ่งคืนทุนเร็ว ตัวตีค่อยตามมาทีหลังยังทัน
                            table.sort(ready, function(a, b)
                                if OPT.focusFarm then
                                    local fa = isFarm(slotTower[a.slot] and slotTower[a.slot].name)
                                    local fb = isFarm(slotTower[b.slot] and slotTower[b.slot].name)
                                    if fa ~= fb then return fa end
                                end
                                if a.used ~= b.used then return a.used < b.used end
                                return a.cost < b.cost
                            end)

                            if #ready == 0 then
                                --  ไม่มีช่องไหนพร้อมเลย = รอจริงๆ ไม่ใช่ความผิดของจุดนี้
                                noMoney = true
                                if farmOnly then
                                    posMsg = ("Focus farm - waiting for the farm cooldown (placed %d)")
                                        :format(placed)
                                end
                                posMsg = ("Waiting on cash/cooldown - placed %d (%d spots left)")
                                    :format(placed, math.max(#spots - idx + 1, 0))
                            else
                                for _, e in ipairs(ready) do
                                    tries = tries + 1
                                    local ok, why = apPlaceOne(e.slot, pos)

                                    if ok then
                                        slotUsed[e.slot] = (slotUsed[e.slot] or 0) + 1
                                        table.insert(taken, pos)
                                        idx = idx + 1
                                        placed = placed + 1
                                        did = true
                                        posMsg = ("Placed %d (%d spots left)")
                                            :format(placed, math.max(#spots - idx + 1, 0))
                                        break
                                    elseif why == "money" or why == "wait" then
                                        --  สถานะเปลี่ยนไประหว่างทาง ไม่นับเป็นความผิดของจุด
                                        noMoney = true
                                    elseif why == "limit" then
                                        --  ฟาร์มเต็มลิมิตแล้ว เลิกกั้น ปล่อยให้ตัวอื่นใช้เงินต่อ
                                        if isFarm(slotTower[e.slot] and slotTower[e.slot].name) then
                                            farmMaxed = true
                                        end
                                        --  ชนลิมิตแล้ว ย้ายจุดก็ไม่ช่วย ลองช่องอื่นก็ไม่ช่วย
                                        --  หยุดวางไปเลย เงินที่เหลือเอาไปอัพคุ้มกว่า
                                        atLimit = true
                                        noMoney = true
                                        break
                                    end
                                end

                                --  ลองครบทุกช่องที่ซื้อไหวแล้วยังไม่ติด และไม่ใช่เพราะเงิน
                                --  แปลว่าจุดนี้วางไม่ได้จริง ข้ามไปเลย
                                if atLimit then
                                    --  ชนลิมิตแล้ว จุดยังดีอยู่ อย่าข้าม
                                    --  แค่หยุดวางรอบนี้ เดี๋ยวขายทาวเวอร์ทีก็วางต่อได้
                                    posMsg = ("Tower limit reached - placed %d, upgrading only")
                                        :format(placed)
                                elseif (not did) and tries > 0 and not noMoney then
                                    idx = idx + 1
                                    posMsg = ("Skipped an unusable spot - placed %d"):format(placed)
                                end
                            end
                        end

                        --  อัพคู่ไปด้วย เงินยังไปที่การวางก่อนอยู่ดีเพราะทำก่อนในรอบเดียวกัน
                        if OPT.autoUpgrade then
                            local up = apUpgradeRound()
                            if up > 0 then
                                posMsg = ("Placed %d - upgraded %d"):format(placed, up)
                            end
                        end

                        --  วางได้แล้วลุยต่อในรอบเดียวกันเลย ไม่ต้องรอรอบหน้า
                        --  นาฬิกาถอยหลังก่อนขึ้นเวฟสั้นมาก รอบละหนึ่งตัวไม่ทันกิน
                        --  ตันเมื่อไหร่ค่อยหยุด (เงินหมด คูลดาวน์ หรือหมดที่ว่าง)
                        if did then
                            for _ = 1, 12 do
                                if not (posPlay and posGen == myGen and inGame()) then break end
                                if idx > #spots then break end

                                while idx <= #spots and not spotFree(spots[idx].pos, taken) do
                                    idx = idx + 1
                                end
                                if idx > #spots then break end

                                local cash2 = getCash()
                                local pick = nil

                                --  ⚠ ต้องกันฟาร์มตรงนี้ด้วย
                                --  ผมกันไว้แค่ในรอบเลือกช่องรอบแรก แต่ลืมลูปนี้
                                --  มันเลยหยิบฟาร์มมาวางลงวงฟ้าจนหมด วงเขียวไม่ได้ใช้เลย
                                local sepF = posFarmOn and farmCenter() ~= nil

                                --  กันเงินให้ฟาร์มเหมือนรอบแรก
                                --  ไม่งั้นลูปนี้จะเทเงินให้ตัวถูกจนหมดในรอบเดียว
                                local hold2, farmOnly2 = 0, false
                                if OPT.focusFarm then
                                    local fc = 0
                                    for _, slot in ipairs(live) do
                                        local ti = slotTower[slot]
                                        if ti and isFarm(ti.name) then
                                            local si = slotInfo(slot)
                                            local c  = si and si.cost or 0
                                            if c > 0 and (fc == 0 or c < fc) then fc = c end
                                        end
                                    end
                                    farmOnly2 = fc > 0 and not farmMaxed and (farmFirstOK())
                                end

                                for _, slot in ipairs(live) do
                                    if slotTower[slot]
                                        and not (sepF and isFarm(slotTower[slot].name))
                                        and not (isFarm(slotTower[slot].name) and not farmPlaceOK()) then
                                        local inf = slotInfo(slot)
                                        local c   = inf and inf.cost or 0
                                        local cd  = inf and inf.cooldown or 0
                                        local isF2 = isFarm(slotTower[slot].name)
                                        local need2 = c + ((isF2 or hold2 == 0) and 0 or hold2)
                                        --  เงินถึงราคาฟาร์มแล้วก็รับเฉพาะฟาร์ม
                                        if cd <= 0 and not (farmOnly2 and not isF2)
                                            and ((not cash2) or need2 <= cash2) then
                                            local u  = slotUsed[slot] or 0
                                            local fm = OPT.focusFarm
                                                and isFarm(slotTower[slot] and slotTower[slot].name)

                                            local better = false
                                            if not pick then
                                                better = true
                                            elseif fm ~= pick.farm then
                                                better = fm            -- ฟาร์มชนะเสมอ
                                            elseif u ~= pick.used then
                                                better = u < pick.used
                                            else
                                                better = c < pick.cost
                                            end

                                            if better then
                                                pick = { slot = slot, cost = c, used = u, farm = fm }
                                            end
                                        end
                                    end
                                end
                                if not pick then break end

                                local ok2, why2 = apPlaceOne(pick.slot, spots[idx].pos)
                                if ok2 then
                                    slotUsed[pick.slot] = (slotUsed[pick.slot] or 0) + 1
                                    table.insert(taken, spots[idx].pos)
                                    idx = idx + 1
                                    placed = placed + 1
                                    posMsg = ("Placed %d (%d spots left)")
                                        :format(placed, math.max(#spots - idx + 1, 0))
                                else
                                    if why2 == "limit" then atLimit = true end
                                    break
                                end
                            end
                        end

                        task.wait(did and 0.02 or 0.2)
                    end
                end
            end
        end
    end)
end

-- ── กดพร้อม / โหวตข้ามเวฟให้เอง ────────────────────
--
--  ทั้งสองอย่างใช้คำสั่งเดียวกัน ต่างกันแค่จังหวะ
--      RF("Voting", "Skip")   ← ไม่มีอาร์กิวเมนต์คือ "พร้อมเริ่ม" ตอนเวฟ 0
--      RF("Voting", "Skip")   ← ยิงตอนกำลังเล่นคือ "ขอข้ามเวฟ"
--  ดักของจริงมาแล้วทั้งคู่ ไม่ได้เดา
--
--  ⚠ ทำงานเฉพาะตอนอยู่ในด่านจริง
--    ห้องเลือกแมพก็มีปุ่มพร้อมเหมือนกัน แต่คนละระบบ (LobbyVoting)
--    ตัว Auto Vote map ดูแลส่วนนั้นอยู่แล้ว มายุ่งตรงนี้จะชนกัน
--
--  ส่งซ้ำไม่ได้ กดสองครั้งเท่ากับยกเลิกโหวตของตัวเอง
--  จึงส่งเมื่อ "รอบโหวตเพิ่งเปิด" เท่านั้น ดูจากตัวนับที่กลับไปเป็นศูนย์
task.spawn(function()
    local lastSend, lastWave = 0, -1

    while ALIVE do
        task.wait(0.5)

        pcall(function()
            if not inGame() then lastWave = -1 return end

            local w = getWave() or 0
            local want = (w <= 0 and OPT.autoReady) or (w >= 1 and OPT.autoSkip)
            if not want then return end

            --  เวฟเปลี่ยน = รอบโหวตใหม่ ส่งได้อีกครั้ง
            if w ~= lastWave then
                lastWave = w
                lastSend = 0
            end

            --  เว้นระยะกันส่งรัว การส่งซ้ำในรอบเดียวคือการยกเลิกโหวตตัวเอง
            if os.clock() - lastSend < 4 then return end

            local c = voteCount()
            if c ~= nil and c > 0 then return end   -- โหวตไปแล้ว ไม่ต้องส่งซ้ำ

            lastSend = os.clock()
            pcall(cmdSkip)
        end)
    end
end)

autoVoteLoop = function()
    voteGen = voteGen + 1
    local myGen = voteGen

    task.spawn(function()

        --  ทำไปแล้วในรอบนี้หรือยัง
        --
        --  เปิดค้างไว้เพื่อ AFK แปลว่าลูปจะวนอยู่ตลอดเวลา ต้องแยกให้ออกว่า
        --  "ยังไม่ได้ทำ" กับ "ทำไปแล้วและกำลังอยู่ในด่าน" ไม่งั้นมันจะโหวตซ้ำ
        --  และกด Ready ซ้ำไปเรื่อยๆ ทั้งที่เข้าด่านเรียบร้อยแล้ว
        --
        --  ล้างธงเมื่อกลับมาที่ห้องเลือกด่านรอบใหม่ — จบเกมแล้วมันจะทำให้เองอีกครั้ง
        --  ไม่ต้องปิดสวิตช์แล้วเปิดใหม่ ซึ่งเป็นสิ่งที่ AFK ทำไม่ได้อยู่แล้ว
        local votedThisRound = false
        local pickedMap = nil        -- แมพที่สุ่มได้ในรอบนี้

        while autoVote and voteGen == myGen do
            if inGame() then
                votedThisRound, pickedMap = false, nil
                task.wait(2)

            elseif not inLobby() then
                votedThisRound, pickedMap = false, nil
                task.wait(2)

            elseif votedThisRound then
                --  โหวตและกด Ready ไปแล้วในรอบนี้ รอเข้าด่านอย่างเดียว
                --  กดซ้ำไม่ได้ทำให้เริ่มเร็วขึ้น เพราะยังต้องรอผู้เล่นคนอื่นอยู่ดี
                task.wait(2)

            else
                --  โหมดสุ่ม: ไม่สนช่อง Select Map เลย เอาอะไรก็ได้ที่อยู่บนกระดาน
                --
                --  สุ่มครั้งเดียวต่อรอบแล้วจำไว้
                --  สุ่มใหม่ทุกครั้งที่ลูปวนจะกลายเป็นเปลี่ยนใจไปเรื่อยๆ
                --  แล้วโหวตไม่ติดสักแมพ เพราะยังไม่ทันเดินไปถึงก็เปลี่ยนเป้าแล้ว
                local target = wantMap

                if voteRandom then
                    if not pickedMap then
                        pickedMap = randomBoardMap()
                        if pickedMap then
                            status = ("Auto Vote: randomly picked %s"):format(pickedMap)
                        end
                    end
                    target = pickedMap
                end

                if not target or target == "" then
                    status = voteRandom
                        and "Auto Vote: no map on the boards yet"
                        or  "Auto Vote: pick a map in Select Map first"
                    task.wait(2)
                else

                local board = findMapBoard(target)

                --  ยังไม่มีแมพนี้บนกระดาน — บังคับด้วย VIP
                --
                --  ไม่ต้องเดินไปแท่นแล้วเปิดหน้าต่างเลือกอีกต่อไป
                --  หน้าต่างนั้นทำอย่างเดียวคือยิงคำสั่งนี้ เรียกตรงๆ จบเร็วกว่าและไม่มีทางพลาดจังหวะ
                --  ไม่มี VIP = บังคับแมพไม่ได้เลย ไม่ต้องเสียเวลายิงคำสั่งที่โดนปฏิเสธแน่นอน
                --  ตรวจตรงนี้แทนที่จะตรวจตอนกดสวิตช์ เพราะผู้ใช้เปลี่ยนแมพได้ตลอดเวลา
                --  และมาโครก็ตั้งแมพให้เองด้วย ซึ่งเกิดหลังกดสวิตช์ไปแล้ว
                if not board and hasVIP then
                    status = ("Auto Vote: forcing the map to %s"):format(target)
                    local ok, err = pcall(cmdOverrideMap, target)

                    local until_ = os.clock() + 8
                    while autoVote and os.clock() < until_ do
                        board = findMapBoard(target)
                        if board then break end
                        task.wait(0.3)
                    end
                end

                if not board then
                    --  บอกด้วยว่าตอนนี้กระดานทั้งสี่เป็นแมพอะไรบ้าง
                    --  ถ้าชื่อในช่องเลือกสะกดไม่ตรงกับบนกระดาน จะเห็นทันทีตรงนี้
                    local names = {}
                    local lb = lobbyFolder()
                    local bs = lb and lb:FindFirstChild("Boards")
                    for _, b in ipairs(bs and bs:GetChildren() or {}) do
                        table.insert(names, ("%s=%s"):format(b.Name, tostring(boardMapTitle(b))))
                    end

                    status = hasVIP
                        and ("Auto Vote: could not force %s - the board did not change"):format(target)
                        or  ("Auto Vote: %s is not on the board and you have no VIP to force it"):format(target)

                    --  ไม่มีด่านที่ต้องการและบังคับไม่ได้ → ออกไปหาเซิร์ฟเวอร์ใหม่
                    --
                    --  สำหรับคนไม่มี VIP นี่เป็นทางเดียวที่จะได้เล่นด่านที่ต้องการ
                    --  ยืนรอในเซิร์ฟเวอร์ที่ไม่มีด่านนั้นก็ไม่มีวันได้เล่น
                    --  ปิดไว้เป็นค่าเริ่มต้น เพราะการออกจากเซิร์ฟเวอร์เองอาจไม่ใช่สิ่งที่ทุกคนต้องการ
                    if leaveNoMap then
                        local okL, how = leaveToMainLobby()
                        task.wait(8)
                    else
                        task.wait(5)
                    end

                else
                    local prompt, att = boardVotePrompt(board)
                    local pos = att and (att:IsA("Attachment") and att.WorldPosition or att.Position)
                    local before = boardVoteCount(board) or 0


                    --  ยิงคำสั่งโหวตตรงๆ ก่อน โดยไม่ต้องเดินไปไหน
                    --
                    --  คำสั่งพกตำแหน่งแท่นไปเองอยู่แล้ว (อ่านจาก Attachment ของกระดานนั้น)
                    --  จึงไม่จำเป็นต้องพาตัวละครไปยืนตรงนั้นให้เสียเวลา
                    --  ถ้าเซิร์ฟเวอร์ตรวจระยะจริง ตัวนับจะไม่ขึ้น แล้วค่อยเดินไปลองใหม่
                    --  ให้ของจริงเป็นคนตอบว่าต้องเดินไหม ดีกว่าเดินไว้ก่อนทุกครั้งเผื่อจำเป็น
                    status = ("Auto Vote: voting %s at %s"):format(target, board.Name)
                    if pos then pcall(cmdVoteMap, target, pos) end
                    task.wait(1.5)

                    --  ไม่ขึ้น = อาจต้องยืนใกล้จริง เดินไปแล้วลองอีกรอบ
                    --  การเดินตรงนี้ไม่ขึ้นกับสวิตช์ Walk Around — คนละเรื่องกัน
                    --  อันนั้นเป็นภาพประกอบตอนวางทาวเวอร์ ส่วนอันนี้คือทางสำรองที่จำเป็น
                    --  ถ้าไม่เดินแล้วโหวตไม่ติด วงจร AFK จะค้างอยู่ตรงนี้ตลอดไป
                    if (boardVoteCount(board) or 0) <= before and pos then
                        status = ("Auto Vote: walking over to vote at %s"):format(board.Name)
                        walkTo(pos, 20)

                        if firePrompt and prompt then pcall(firePrompt, prompt) end
                        pcall(cmdVoteMap, target, pos)
                        task.wait(1.5)
                    end

                    --  กด Ready แล้วรอโหลดแมพ
                    status = ("Auto Vote: voted %s - pressing Ready"):format(target)
                    local okR, errR = pcall(cmdLobbyReady)

                    --  ทำครบแล้ว ปักธงไว้ รอบนี้ไม่ต้องทำอะไรอีก
                    votedThisRound = true
                end
                end     -- ปิด if target
            end
        end
    end)
end
