local function placeCostOf(name)
    local d = towerDefaults(name)
    if type(d) ~= "table" then return nil end
    return tonumber(d.Cost) or tonumber(d.Price) or nil
end

--  ตารางเทียบ รหัสรูป → ชื่อทาวเวอร์
--
--  รูปแม่นกว่าราคามาก เพราะราคาซ้ำกันได้
--  (Assassin / Brawler / Elf Camp ราคา 300 เท่ากันทั้งสามตัว) แต่รูปไม่ซ้ำ
--
--  ไม่ฝังที่อยู่ของรูปไว้ เพราะยังไม่รู้ว่าเกมเก็บไว้ตรงไหน
--  กวาดหาสตริงที่ขึ้นต้นด้วย rbxassetid ในกิ่งของทาวเวอร์แต่ละตัวเอา
--  เจอที่ไหนก็ใช้ที่นั่น ถ้าไม่เจอเลยก็ถอยไปใช้ราคาเหมือนเดิม
local iconMap = nil

local function buildIconMap()
    if iconMap then return iconMap end
    iconMap = {}

    local content = ReplicatedStorage:FindFirstChild("Content")
    local folder  = content and content:FindFirstChild("Tower")
    if not folder then return iconMap end

    for _, tower in ipairs(folder:GetChildren()) do
        pcall(function()
            local found = {}

            --  attribute ก่อน เพราะเบาที่สุด
            for _, k in ipairs({ "Icon", "Image", "Thumbnail" }) do
                local v = tower:GetAttribute(k)
                if type(v) == "string" and v:find("rbxassetid", 1, true) then
                    table.insert(found, v)
                end
            end

            for _, d in ipairs(tower:GetDescendants()) do
                if d:IsA("ImageLabel") or d:IsA("ImageButton") then
                    if type(d.Image) == "string" and d.Image ~= "" then
                        table.insert(found, d.Image)
                    end
                elseif d:IsA("StringValue") and d.Value:find("rbxassetid", 1, true) then
                    table.insert(found, d.Value)
                end
                for _, k in ipairs({ "Icon", "Image", "Thumbnail" }) do
                    local v = d:GetAttribute(k)
                    if type(v) == "string" and v:find("rbxassetid", 1, true) then
                        table.insert(found, v)
                    end
                end
            end

            for _, id in ipairs(found) do
                --  รหัสที่ทาวเวอร์สองตัวใช้ร่วมกัน (เช่นกรอบพื้นหลัง) ใช้ระบุตัวไม่ได้
                --  ทำเครื่องหมายว่าซ้ำ แล้วข้ามไปเลย
                if iconMap[id] == nil then
                    iconMap[id] = tower.Name
                elseif iconMap[id] ~= tower.Name then
                    iconMap[id] = false
                end
            end
        end)
    end

    return iconMap
end

--  ให้เกมบอกชื่อทาวเวอร์เอง โดยกดปุ่มบนแถบล่างจอ "ของเกมจริงๆ"
--
--  ต่างจากที่เคยทำพลาดไปตอนแรก
--  ตอนนั้นผมยิงคำสั่ง Hotbar Click ตรงไปเซิร์ฟเวอร์ ซึ่งข้ามหน้าจอของเกมไป
--  โค้ดฝั่งเกมจึงไม่รู้ว่ามีการกด และไม่ยิง SelectTower ตอบ
--
--  คราวนี้ไปกดปุ่มบนหน้าจอของเกมโดยตรง โค้ดของเกมจะทำงานตามปกติทุกอย่าง
--  รวมถึงยิง SelectTower ออกมา ซึ่งตัวดักของเราเก็บชื่อไว้ให้เอง
--  แม่นที่สุดเพราะเป็นชื่อที่เกมบอกเอง ไม่ใช่เราอนุมาน
local function pokeSlotButton(slot)
    local fire = execGlobal("firesignal")
    if not fire then return false end

    local gui    = LocalPlayer:FindFirstChild("PlayerGui")
    local hb     = gui and gui:FindFirstChild("ReactUniversalHotbar")
    local frame  = hb and hb:FindFirstChild("Frame")
    local troops = frame and frame:FindFirstChild("troops")
    local s      = troops and troops:FindFirstChild(tostring(slot))
    local btn    = s and s:FindFirstChild("Button", true)
    if not (btn and btn:IsA("GuiButton")) then return false end

    local hit = false
    for _, sig in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down" }) do
        pcall(function()
            fire(btn[sig])
            hit = true
        end)
    end
    return hit
end

--  รหัสรูปบนช่อง hotbar ช่องนี้
local function slotIcon(slot)
    local gui    = LocalPlayer:FindFirstChild("PlayerGui")
    local hb     = gui and gui:FindFirstChild("ReactUniversalHotbar")
    local frame  = hb and hb:FindFirstChild("Frame")
    local troops = frame and frame:FindFirstChild("troops")
    local s      = troops and troops:FindFirstChild(tostring(slot))
    if not s then return nil end

    local img = s:FindFirstChild("ImageIcon", true)
    return (img and img:IsA("ImageLabel") and img.Image ~= "") and img.Image or nil
end

--  อ่านโหลดเอาต์จากตารางที่เกมใช้เอง  ← แม่นที่สุด ไม่มีการอนุมานเลย
--
--  เจอจากโมดูล Hotbar ของเกม (ReplicatedStorage.Client.Modules.Hotbar)
--      local Cache = require(ReplicatedStorage.Client.Modules.Cache)
--      Cache("Equipped.Troops")    → [เลขช่อง] = ชื่อทาวเวอร์
--      Cache("Inventory.Troops")   → [ชื่อ]     = { Skin = ..., GoldenPerks = ... }
--
--  ก่อนหน้านี้ผมพยายามเดาจากรูปบ้างราคาบ้าง แล้วก็พลาดกับช่องที่ราคาซ้ำกัน
--  ทั้งที่เกมมีตารางตรงๆ วางอยู่แล้ว
--
--  Get() คืน Promise ต้องรอผลผ่าน andThen ไม่ใช่อ่านค่ากลับมาทันที
--  หาโมดูล Cache แบบไม่ฝังที่อยู่
--  ที่อยู่ที่เห็นในโมดูล Hotbar คือ Client.Modules.Cache
--  แต่ถ้าเกมย้ายที่ ก็ยังหาเจอด้วยการกวาดชื่อ
local cacheFn = nil

local function findCache()
    if cacheFn then return cacheFn end

    local ok = pcall(function()
        local client = ReplicatedStorage:FindFirstChild("Client")
        if not client then return end

        local direct = client:FindFirstChild("Modules")
        direct = direct and direct:FindFirstChild("Cache")
        if direct and direct:IsA("ModuleScript") then
            local m = require(direct)
            if type(m) == "function" then cacheFn = m return end
        end

        for _, d in ipairs(client:GetDescendants()) do
            if d:IsA("ModuleScript") and d.Name == "Cache" then
                local okr, m = pcall(require, d)
                if okr and type(m) == "function" then cacheFn = m return end
            end
        end
    end)
    return ok and cacheFn or nil
end

--  ดึงค่าจากช่องเก็บของเกม
--
--  Get() คืน Promise ซึ่งแต่ละรุ่นเรียกไม่เหมือนกัน
--  ลองทุกท่าที่รู้จัก อันไหนได้ก่อนใช้อันนั้น
local function cacheGet(key, timeout)
    local Cache = findCache()
    if not Cache then return nil end

    local box = nil
    local okBox = pcall(function() box = Cache(key) end)
    if not (okBox and box) then return nil end

    --  ท่าที่หนึ่ง: อ่านค่าที่ค้างอยู่ตรงๆ ไม่ต้องรอ
    local direct = nil
    pcall(function()
        if type(box.Value) == "table" then direct = box.Value end
    end)
    if direct then return direct end

    local out, done = nil, false

    --  ท่าที่สอง: await คืนค่าทันที
    pcall(function()
        local p = box:Get()
        if type(p) == "table" and type(p.await) == "function" then
            local okA, v = p:await()
            if okA and type(v) == "table" then out, done = v, true end
        elseif type(p) == "table" and type(p.andThen) == "function" then
            p:andThen(function(v) out, done = v, true end)
        elseif type(p) == "table" then
            out, done = p, true      -- คืนตารางมาเลย ไม่ใช่ Promise
        end
    end)

    local until_ = os.clock() + (timeout or 0.6)
    while os.clock() < until_ and not done do task.wait(0.05) end
    return out
end

local function readEquipped()
    return cacheGet("Equipped.Troops"), cacheGet("Inventory.Troops")
end

--  แถบล่างจอมีกี่ช่องจริงๆ
--
--  ⚠ ห้ามฝังเลข 6 ไว้
--  ผู้เล่นใส่ทาวเวอร์แค่ 4 ตัว ช่อง 5 กับ 6 จึงไม่มีวันรู้จักได้
--  โค้ดเดิมรอให้ครบหกช่อง เลยเรียกตัวถามซ้ำทุกรอบไม่มีวันหยุด
--  แต่ละครั้งกินหลายวินาที (อ่าน Cache + กดปุ่มถาม) จนวางแทบไม่ได้เลย
--  บางโหมดมีถึง 6 ช่อง บางโหมดน้อยกว่า จึงต้องนับจากของจริง
local function hotbarSlots()
    local out = {}
    for i = 1, 6 do
        if slotInfo(i) then table.insert(out, i) end
    end
    if #out == 0 then out = { 1, 2, 3, 4, 5, 6 } end
    return out
end

--  รู้จักครบเท่าที่มีจริงหรือยัง
local function slotsReady()
    local live = hotbarSlots()
    for _, i in ipairs(live) do
        if not slotTower[i] then return false, live end
    end
    return true, live
end

local lastLearn = 0

local function learnSlots()
    lastLearn = os.clock()
    local live = hotbarSlots()

    --  ของที่จำไว้จากรอบก่อน
    local lay = loadLayout()
    if lay and type(lay.towers) == "table" then
        for k, v in pairs(lay.towers) do
            local i = tonumber(k)
            if i and not slotTower[i] and type(v) == "table" and v.name then
                slotTower[i] = { name = v.name, skin = v.skin or "Default" }
            end
        end
    end

    --  ถามเกมตรงๆ ก่อนเลย ได้ครบก็จบตรงนี้ ไม่ต้องเดาอะไรต่อ
    do
        local eq, inv = readEquipped()
        if type(eq) == "table" then
            for k, name in pairs(eq) do
                --  คีย์อาจเป็น 1 หรือ "1" หรือ "Slot1" ดึงเลขออกมาให้หมด
                local i = tonumber(k) or tonumber(tostring(k):match("%d+") or "")
                if i and i >= 1 and i <= 6 and type(name) == "string" and name ~= "" then
                    local skin = "Default"
                    if type(inv) == "table" and type(inv[name]) == "table"
                        and type(inv[name].Skin) == "string" then
                        skin = inv[name].Skin
                    end
                    slotTower[i] = { name = name, skin = skin }
                end
            end
        end
    end

    --  รายชื่อทาวเวอร์ที่จะเอามาเทียบราคา
    --
    --  เดิมใช้เฉพาะตัวที่เห็นตอนใส่ในล็อบบี้ ซึ่งว่างเปล่าถ้าผู้เล่นไม่ได้ไปแตะ
    --  นั่นคือเหตุผลที่ Auto Play ไม่เคยรู้จักช่องไหนเลย
    --
    --  คราวนี้เอาทาวเวอร์ทั้งหมดใน Content.Tower มาเทียบ
    --  ราคาบนช่องคือ Cost เช่น "$125"  ส่วนในโมดูลคือ Price = 125  ตรงกันพอดี
    --  ตัวที่เคยเห็นตอนใส่จะถูกจัดให้อยู่หน้าแถว เพราะมั่นใจกว่า
    local pool = {}
    for name in pairs(liveEquip) do table.insert(pool, name) end

    do
        local content = ReplicatedStorage:FindFirstChild("Content")
        local folder  = content and content:FindFirstChild("Tower")
        for _, t in ipairs(folder and folder:GetChildren() or {}) do
            if not liveEquip[t.Name] then table.insert(pool, t.Name) end
        end
    end

    if #pool > 0 then
        for slot = 1, 6 do
            if not slotTower[slot] then
                --  ลองจากรูปก่อน แม่นกว่าราคา
                local icon = slotIcon(slot)
                local byIcon = icon and buildIconMap()[icon]
                if type(byIcon) == "string" then
                    slotTower[slot] = { name = byIcon, skin = liveEquip[byIcon] or "Default" }
                end
            end

            if not slotTower[slot] then
                local info = slotInfo(slot)
                local want = info and info.cost
                if want and want > 0 then
                    --  ราคาซ้ำกันมีจริง เช่น Assassin / Brawler / Elf Camp ราคา 300 เท่ากัน
                    --  ถ้าในกลุ่มที่ราคาตรงมีตัวที่เคยเห็นตอนใส่อยู่ ให้ตัวนั้นชนะ
                    --  ไม่มีตัวไหนโดดเด่นค่อยยอมแพ้ ให้ผู้เล่นกดเลือกเอง
                    local match = {}
                    for _, name in ipairs(pool) do
                        if placeCostOf(name) == want then table.insert(match, name) end
                    end

                    local hit = nil
                    if #match == 1 then
                        hit = match[1]
                    elseif #match > 1 then
                        for _, name in ipairs(match) do
                            if liveEquip[name] then hit = name break end
                        end
                    end

                    if hit then
                        slotTower[slot] = { name = hit, skin = liveEquip[hit] or "Default" }
                    end
                end
            end
        end
    end

    --  ยังขาดอยู่ก็ให้เกมบอกเอง
    --
    --  ทำท้ายสุดเพราะมันสลับช่องที่เลือกอยู่จริงๆ ในเกม
    --  ถ้าไปกดตอนกำลังวางอยู่ ทาวเวอร์ที่กำลังจะวางจะเปลี่ยนตัวกลางคัน
    --  และเฉพาะช่องที่มีทาวเวอร์อยู่จริงเท่านั้น กดช่องว่างเสียเวลาเปล่า
    for _, slot in ipairs(live) do
        if not slotTower[slot] then
            if pokeSlotButton(slot) then
                local until_ = os.clock() + 0.6
                while os.clock() < until_ and not slotTower[slot] do
                    task.wait(0.05)
                end
            end
        end
    end

    --  เก็บลงไฟล์ของแมพ รอบหน้าไม่ต้องหาใหม่
    if lay then
        lay.towers = {}
        for i = 1, 6 do
            if slotTower[i] then lay.towers[tostring(i)] = slotTower[i] end
        end
        saveLayout()
    end

    local n, missing = 0, {}
    for i = 1, 6 do
        if slotTower[i] then n = n + 1
        elseif layoutCount(lay, i) > 0 then table.insert(missing, tostring(i)) end
    end

    --  บอกเฉพาะช่องที่มีจุดตั้งไว้แต่ยังไม่รู้ชื่อ ช่องที่ไม่ได้ใช้ก็ไม่ต้องสน
    if #missing > 0 then
        apMsg = ("Slot %s is still unknown - press %s on your keyboard once and wait")
            :format(table.concat(missing, ", "), table.concat(missing, ", "))
    end

    return n, #missing
end

--  วางหนึ่งจุด คืน true เมื่อวางติดจริง
local function apPlaceOne(slot, pos)
    local info = slotTower[slot]
    if not info then return false, "unknown tower in this slot" end

    --  ⚠ สามเหตุผลนี้ต้องแยกให้ขาด ไม่งั้นพังทั้งระบบ
    --      money  เงินไม่พอ        → รอ เดี๋ยวก็มา
    --      wait   ติดคูลดาวน์      → รอ เดี๋ยวก็หมด
    --      อื่นๆ  วางตรงนี้ไม่ได้   → ข้ามจุดนี้ทิ้ง
    --
    --  ของเดิมไม่รู้จัก "wait" เลย
    --  TDS มีคูลดาวน์ต่อทาวเวอร์หลังวางแต่ละครั้ง วางรัวไม่ได้
    --  พอวางไม่ติดเพราะคูลดาวน์ ผมกลับตีความว่าจุดนั้นวางไม่ได้ แล้วข้ามจุดดีๆ ทิ้ง
    --  ต้องรอให้คูลดาวน์หมดตอนขึ้นเวฟใหม่ถึงจะวางได้อีก
    --  ตรงกับอาการที่เจอเป๊ะ — วางเป็นชุดตอนเปลี่ยนเวฟ แล้วเงียบไปทั้งเวฟ
    local info2 = slotInfo(slot)

    if info2 and (info2.cooldown or 0) > 0 then
        return false, "wait"
    end

    --  ไม่ตัดสินเรื่องเงินเองแล้ว
    --
    --  การอ่านเงินกับราคาจากหน้าจอพลาดได้ และถ้าพลาดฝั่งต่ำ
    --  เราจะบล็อกตัวเองไว้ตลอดกาลโดยไม่เคยลองยิงสักครั้ง
    --  ปล่อยให้เซิร์ฟเวอร์ตัดสิน มันรู้ดีกว่าและตอบกลับเร็วอยู่แล้ว
    --  ใช้ราคาที่อ่านได้เป็นแค่ตัวกรองหยาบๆ เผื่อเงินห่างชั้นจริงๆ
    local cost = info2 and info2.cost or nil
    local cash = getCash()
    if cost and cash and cash < cost * 0.9 then return false, "money" end

    local before = {}
    local f = towersFolder()
    for _, m in ipairs(f and f:GetChildren() or {}) do before[m] = true end

    pcall(cmdSelectSlot, slot)
    task.wait(0.03)
    pcall(cmdStream, info.name, info.skin)
    task.wait(0.03)

    local sent, reply = pcall(cmdPlace, CFrame.new(), pos, info.name)
    if not sent then return false, tostring(reply) end

    --  ดูผลจากสนามจริง ไม่ใช่จากคำตอบของคำสั่ง
    --  เซิร์ฟเวอร์ตอบว่ารับคำสั่งแล้วไม่ได้แปลว่าทาวเวอร์โผล่จริง
    --
    --  ⚠ แต่ห้ามรอนาน
    --  ของเดิมรอ 2 วินาทีทุกครั้งที่วางไม่ติด ลองหกช่องก็ 12 วินาทีต่อหนึ่งจุด
    --  ผ่านไปสามเวฟยังวางไม่ได้กี่ตัว — นั่นคือสาเหตุที่ช้าจนน่าตกใจ
    --
    --  ถ้าเซิร์ฟเวอร์ตอบกลับมาเป็นข้อความ แปลว่าปฏิเสธพร้อมบอกเหตุผลแล้ว
    --  ไม่ต้องรอดูอะไรอีก รู้ผลได้ทันที
    if type(reply) == "string" and reply ~= "" then
        --  แยกคำปฏิเสธเรื่องเงินออกจากคำปฏิเสธเรื่องตำแหน่ง
        --  ข้อความจริงที่เคยเจอ: "You need $118 more"
        local low = reply:lower()
        if low:find("need", 1, true) or low:find("more", 1, true)
            or low:find("afford", 1, true) or low:find("cash", 1, true) then
            return false, "money"
        end
        if low:find("wait", 1, true) or low:find("cooldown", 1, true) then
            return false, "wait"
        end
        --  ชนลิมิตแล้ว ไม่ว่าจะลิมิตต่อชนิดหรือลิมิตรวมของสนาม
        --  ต่างจาก "วางตรงนี้ไม่ได้" ตรงที่ย้ายไปจุดอื่นก็ไม่ช่วย ต้องหยุดวางทั้งหมด
        if low:find("limit", 1, true) or low:find("only place", 1, true)
            or low:find("maximum", 1, true) or low:find("max ", 1, true) then
            return false, "limit"
        end
        return false, reply
    end

    local until_ = os.clock() + 0.4
    while os.clock() < until_ do
        if findNewTower(before, pos, info.name) then return true end
        task.wait(0.03)
    end
    return false, tostring(reply)
end

--  ทาวเวอร์ของเราในสนามตอนนี้ เรียงตามช่องที่ตั้งไว้
--  ตัวนี้เป็นฟาร์มไหม
--
--  ดูจากชื่อ ไม่ฝังรายชื่อไว้ เกมมีฟาร์มหลายแบบและเพิ่มได้ตลอด
--  (Farm, Golden Farm, Military Farm ฯลฯ ล้วนมีคำว่า farm)
local function isFarm(name)
    return type(name) == "string" and name:lower():find("farm", 1, true) ~= nil
end

--  ตอนนี้ทุ่มเงินให้ฟาร์มได้ไหม
--
--  ⚠ ฟาร์มล้วนคือแพ้แน่นอน
--  ฟาร์มไม่ยิงอะไรเลย และค่าอัพก็ไม่ถูก กว่าจะคืนทุนบ้านแตกไปแล้ว
--  Focus farm จึงต้องมีเบรก ไม่ใช่ทุ่มให้ฟาร์มตลอดทั้งเกม
--
--  เบรกสามชั้น พอชั้นไหนแตะก็เลิกทุ่ม กลับไปแบ่งเงินตามปกติ
--    1. ต้องมีตัวยิงขั้นต่ำก่อน   เวฟแรกๆ ไม่มีอะไรยิงเลยคือตายตั้งแต่ยังไม่ได้เริ่ม
--    2. เลยเวฟที่กำหนดแล้วเลิก   ช่วงท้ายเกมฟาร์มไม่มีเวลาคืนทุนแล้ว
--    3. บ้านเริ่มโดนตี           เสียเลือดแล้วแปลว่ากำลังยิงไม่ทัน ต้องเสริมทันที
--  ตอนนี้ยังควรวางฟาร์มเพิ่มไหม
--
--  ⚠ เปิด Auto sell farm ไว้แล้วถึงเวฟขาย ต้องเลิกวางฟาร์มด้วย
--  ไม่งั้นจะกลายเป็นวงจรไม่รู้จบ — ตัวขายขายทิ้ง ตัววางเห็นที่ว่างก็วางใหม่
--  ตัวขายเห็นฟาร์มก็ขายอีก วนแบบนี้ทั้งเวฟ เสียเงินค่าวางไปเปล่าๆ ทุกรอบ
--
--  ถึงเวฟขายแล้วคือช่วงที่ฟาร์มไม่มีเวลาคืนทุนอีกต่อไป การวางเพิ่มจึงไม่มีเหตุผลอยู่แล้ว
local function farmPlaceOK()
    if OPT.sellFarm and (getWave() or 0) >= (OPT.sellFarmWave or 25) then
        return false
    end
    return true
end

local function farmFirstOK()
    if not farmPlaceOK() then return false, "selling farms now" end
    if not OPT.focusFarm then return false, "off" end

    local w = getWave() or 0
    if w > (OPT.farmUntilWave or 12) then
        return false, ("past wave %d"):format(OPT.farmUntilWave or 12)
    end

    --  ⚠ เดิมเขียนว่า "เลือดหายแม้แต่หน่วยเดียวก็หยุด" ซึ่งเข้มเกินไปมาก
    --  เวฟแรกๆ หลุดหนึ่งตัวเป็นเรื่องปกติ พอเลือดหายปุ๊บ Focus farm ก็ตายถาวร
    --  ทั้งเกมจากนั้นจะไม่แตะฟาร์มอีกเลย ทั้งที่ยังปลอดภัยดี
    --  ใช้เกณฑ์ว่า "เริ่มอันตรายจริง" แทน คือเหลือไม่ถึงครึ่ง
    local hp, mx = getHealth()
    if mx > 0 and hp < mx * 0.5 then
        return false, "base under 50%"
    end

    local guns = 0
    local f = towersFolder()
    for _, m in ipairs(f and f:GetChildren() or {}) do
        if isMine(m) and not isFarm(tName(m)) then guns = guns + 1 end
    end

    local need = OPT.farmMinDef or 3
    if guns < need then
        return false, ("%d/%d guns"):format(guns, need)
    end
    return true, "on"
end

local function apMyTowers()
    local out = {}
    local f = towersFolder()
    for _, m in ipairs(f and f:GetChildren() or {}) do
        if isMine(m) then table.insert(out, m) end
    end
    return out
end

--  อัพหนึ่งรอบ — ไล่ทุกตัวที่ยังอยู่ขั้นต่ำสุดในสนาม
--  คืนจำนวนที่อัพได้ ถ้าได้ 0 แปลว่าตันหรือเงินไม่พอ
local function apUpgradeRound()
    local towers = apMyTowers()
    if #towers == 0 then return 0 end

    --  Focus farm: ถ้ายังมีฟาร์มที่อัพต่อได้ ให้ทุ่มเงินไปที่ฟาร์มก่อนทั้งหมด
    --
    --  ฟาร์มคือตัวสร้างรายได้ ยิ่งอัพเร็วยิ่งได้เงินก้อนใหญ่เร็ว
    --  เอาเงินไปอัพตัวตีก่อนตอนต้นเกมคือการแลกรายได้ทั้งเกมกับพลังชั่วคราว
    --  พอฟาร์มตันแล้วค่อยปล่อยให้ตัวอื่นได้เงินตามปกติ
    --  ⚠ แต่ห้ามบล็อกสนิท
    --
    --  ของเดิมพอมีฟาร์มที่อัพต่อได้ ก็ตัดตัวอื่นออกหมดทันที
    --  ถ้าขั้นถัดไปของฟาร์มราคา 5000 แล้วมีเงิน 3000 เงินก้อนนั้นจะนอนเฉยๆ
    --  ทั้งที่เอาไปอัพตัวตีได้สองตัว เสียเปล่าไปทั้งเวฟ
    --
    --  แต่ปล่อยให้ใช้หมดทุกครั้งก็ไม่ได้ จะไม่มีวันเก็บครบสำหรับขั้นแพงๆ ของฟาร์ม
    --  ทางสายกลางคือ "กันเงินไว้ให้ฟาร์มก่อน ส่วนที่เกินค่อยใช้"
    local reserve = 0
    if (farmFirstOK()) then
        local farms, cheapest = {}, nil
        for _, m in ipairs(towers) do
            if isFarm(tName(m)) then
                local c = upgradeCost(m)
                if c then
                    table.insert(farms, m)
                    if (not cheapest) or c < cheapest then cheapest = c end
                end
            end
        end

        if #farms > 0 then
            local cash = getCash() or 0

            --  เงินพอสำหรับขั้นถัดไปของฟาร์มแล้ว → ทุ่มให้ฟาร์มรอบนี้
            --  ยังไม่พอ → ปล่อยให้ตัวอื่นใช้ส่วนที่เกินจากที่กันไว้
            if (not cheapest) or cash >= cheapest then
                --  เงินถึงขั้นถัดไปของฟาร์มแล้ว ทุ่มให้ฟาร์มรอบนี้
                towers = farms
            else
                --  ⚠ เงินไม่ถึงฟาร์ม = ปล่อยให้ตัวอื่นใช้ได้เต็มที่ ไม่กันไว้
                --
                --  ของเดิมกันเงินไว้เท่าราคาฟาร์ม ซึ่งฟังดูดีแต่ใช้จริงแล้วแย่กว่า
                --  มีเงิน 100 ฟาร์มขั้นถัดไป 500 → กันไว้ 500 → ไม่เหลืออะไรให้ใครเลย
                --  ทั้งที่ Scout อัพได้ด้วย 50 เงินก้อนนั้นเลยนอนเฉยๆ ทั้งเวฟ
                --
                --  เก็บเงินรอฟาร์มไม่มีประโยชน์ เพราะรายได้ไหลเข้าตลอดเวลาอยู่แล้ว
                --  เดี๋ยวก็ถึง 500 เอง แต่ 50 ที่ไม่ได้ใช้คือเสียเปล่าถาวร
                reserve = 0
            end
        end
    end

    --  หาขั้นต่ำสุดที่ยังมีอยู่ แล้วอัพเฉพาะตัวที่อยู่ขั้นนั้น
    --  วิธีนี้ทำให้ทุกตัวไล่ขึ้นพร้อมกัน ไม่มีตัวไหนโดนทิ้งไว้ข้างหลัง
    --  หาขั้นต่ำสุดที่ยังอยู่ในสนาม
    --
    --  ⚠ ห้ามพึ่งตารางราคาอย่างเดียว
    --  ถ้าอ่านตารางไม่ได้ (โมดูลเปลี่ยนโครง หรือทาวเวอร์ตัวนั้นไม่มีข้อมูล)
    --  upgradeCost จะคืน nil ทุกตัว แล้วโค้ดเดิมจะสรุปว่า "ตันหมดแล้ว" ทั้งที่เพิ่งวางเสร็จ
    --  นั่นคือสาเหตุที่อัพเกรดเงียบสนิท
    --
    --  คราวนี้แยกสองกรณี: รู้ราคา กับ ไม่รู้ราคา
    --  ไม่รู้ราคาก็ยิงไปเลย เซิร์ฟเวอร์ปฏิเสธเองถ้าเงินไม่พอหรือตันแล้ว
    local low, known = nil, false
    for _, m in ipairs(towers) do
        local lv = tLevel(m)
        if upgradeCost(m) then
            known = true
            if not low or lv < low then low = lv end
        end
    end

    if not known then
        --  ไม่มีข้อมูลราคาสักตัว ใช้ขั้นต่ำสุดจากที่เห็นในสนามแทน
        for _, m in ipairs(towers) do
            local lv = tLevel(m)
            if not low or lv < low then low = lv end
        end
    end
    if not low then return 0, true end

    local done, tried = 0, 0
    local sent = {}
    for _, m in ipairs(towers) do
        --  ต้องรับทั้งสองโหมด ของเดิมเช็คแต่ autoPlay
        --  พอ Play Pos เรียกมา เงื่อนไขเป็นเท็จตั้งแต่ตัวแรก แล้วออกจากลูปทันที
        --  ผลคืออัพเกรดไม่ทำงานเลยเวลาใช้ Play Pos
        if not ((autoPlay or posPlay) and ALIVE) then break end

        if tLevel(m) == low then
            local cost = upgradeCost(m, a.path)
            --  รู้ราคาก็รอให้เงินพอ ไม่รู้ก็ลองยิงดู
            --  ตัวที่ไม่ใช่ฟาร์มต้องเหลือเงินกันไว้ให้ฟาร์มด้วย
            local need = cost or 0
            if reserve > 0 and not isFarm(tName(m)) then need = need + reserve end

            --  กำลังเก็บเงินซื้อฟาร์มอยู่ อย่าไปใช้ก้อนนั้น
            --  ฟาร์มยังไม่ลงสนามคือยังไม่มีรายได้ ซึ่งสำคัญกว่าอัพตัวยิงหนึ่งขั้น
            if farmNeedCash > 0 and not isFarm(tName(m)) then
                need = need + farmNeedCash
            end

            if (not cost) or (getCash() or 0) >= need then
                tried = tried + 1
                local before = tLevel(m)
                local ok = pcall(cmdUpgrade, m)

                --  ⚠ ห้ามหน่วงตรงนี้
                --
                --  ของเดิมรอ 0.35 วินาทีต่อทาวเวอร์หนึ่งตัวเพื่อดูว่าระดับขยับไหม
                --  มีทาวเวอร์ 15 ตัวก็เสียไป 5 วินาทีต่อหนึ่งขั้น ห้าขั้นก็ 25 วินาที
                --  ระหว่างนั้นเงินกองอยู่เฉยๆ พอเวฟท้ายมาก็อัพไม่ทัน
                --
                --  ยิงรวดทั้งแถวก่อน แล้วค่อยไปนับผลทีเดียวตอนท้าย
                --  เซิร์ฟเวอร์รับคำสั่งพร้อมกันได้อยู่แล้ว ไม่ต้องรอทีละตัว
                if ok then table.insert(sent, { m = m, was = before }) end
            end
        end
    end

    --  รอครั้งเดียวให้เซิร์ฟเวอร์ตอบทั้งชุด แล้วนับผลรวดเดียว
    if #sent > 0 then
        task.wait(0.25)
        for _, e in ipairs(sent) do
            if tLevel(e.m) > e.was then done = done + 1 end
        end
    end

    --  ลองแล้วไม่ขยับสักตัว แถมทุกตัวอ่านราคาไม่ได้ = ตันจริง
    if tried > 0 and done == 0 and known then
        local anyLeft = false
        for _, m in ipairs(towers) do
            if upgradeCost(m) then anyLeft = true break end
        end
        if not anyLeft then return 0, true end
    end

    return done, false
end

local function autoPlayLoop()
    apGen = apGen + 1
    local myGen = apGen

    task.spawn(function()
        local forMatch = nil      -- ชุดงานนี้ของแมตช์ไหน
        local left     = {}       -- จุดที่ยังวางไม่ได้
        local placed, total = 0, 0

        while autoPlay and apGen == myGen and ALIVE do
            if not inGame() then
                forMatch = nil
                farmNeedCash = 0
                task.wait(2)

            else
                local lay = loadLayout()
                --  ผูกตัวนับรอบไว้ด้วย ไม่งั้น Rematch จะถือว่ายังเป็นแมตช์เดิม
                --  แล้วยึดสถานะเก่าไว้ทั้งชุด จนรายงานว่า "วางครบแล้ว" ทั้งที่สนามโล่ง
                local key = ("%s|%d"):format(tostring(lay and lay.map), roundTag)

                if layoutTotal(lay) == 0 then
                    status = "Auto Play: no spots set for this map"
                    task.wait(4)

                else
                    --  จดว่าวางไปแล้วแต่สนามโล่ง = เกมล้างสนาม ต้องตั้งต้นใหม่
                    if placed > 0 and myTowerCount() == 0 then
                        forMatch = nil
                    end

                    --  เข้าแมตช์ใหม่ ตั้งชุดงานใหม่
                    if forMatch ~= key then
                        forMatch = key
                        left, placed = {}, 0
                        total = layoutTotal(lay)

                        for slot = 1, 6 do
                            --  ช่องที่ยังไม่รู้ชื่อ ข้ามไปก่อน ไม่ใช่ค้างรอทั้งชุด
                            if slotTower[slot] then
                                for _, pt in ipairs(lay.slots[tostring(slot)] or {}) do
                                    table.insert(left, { slot = slot,
                                        pos = Vector3.new(pt[1], pt[2], pt[3]) })
                                end
                            end
                        end
                    end

                    --  ── วางก่อนเสมอ แต่รอบเดียวจบ ไม่ยึดคิวไว้ ──
                    --
                    --  ⚠ ของเดิมวนวางอยู่ในนี้จนกว่าจะครบ เพดาน 10 นาที
                    --  จุดไหนวางไม่ได้ถาวร (เต็มลิมิต ที่ถูกยึด) ลูปก็จมอยู่ตรงนั้นทั้ง 10 นาที
                    --  แล้วอัพเกรดไม่มีวันได้เริ่ม — นั่นคือสาเหตุที่ Auto Upgrade เงียบ
                    --
                    --  คราวนี้ผ่านรอบเดียวแล้วปล่อยให้ไปทำอย่างอื่นต่อ
                    --  เงินยังไปที่การวางก่อนอยู่ดี เพราะทำก่อนในทุกรอบ
                    if #left > 0 then
                        for i = #left, 1, -1 do
                            if not (autoPlay and apGen == myGen and inGame()) then break end
                            local job = left[i]
                            local ok, why = apPlaceOne(job.slot, job.pos)

                            if ok then
                                table.remove(left, i)
                                placed = placed + 1
                                status = ("Auto Play: placed %d/%d"):format(placed, total)
                                task.wait(0.2)

                            elseif why ~= "money" and why ~= "wait" then
                                --  จุดที่เซิร์ฟเวอร์ไม่รับ ลองซ้ำสามรอบแล้วเลิก
                                --  ไม่งั้นจะวนลองจุดที่ไม่มีวันสำเร็จไปเรื่อยๆ
                                --  แล้วเบียดเวลาของจุดอื่นที่ยังวางได้อยู่
                                job.fail = (job.fail or 0) + 1
                                if job.fail >= 3 then
                                    table.remove(left, i)
                                    status = ("Auto Play: skipped an unusable spot - %d/%d")
                                        :format(placed, total)
                                end
                            end
                        end
                    end

                    --  ── แล้วค่อยอัพ ──
                    if OPT.autoUpgrade then
                        local done, maxed = apUpgradeRound()

                        if maxed and #left == 0 then
                            status = "Auto Play: everything is fully upgraded"
                            task.wait(5)
                        elseif done > 0 then
                            status = ("Auto Play: placed %d/%d - upgraded %d")
                                :format(placed, total, done)
                            --  อัพติดแล้วรีบวนต่อทันที เงินมักมาเป็นก้อนตอนจบเวฟ
                            task.wait(0.05)
                        else
                            task.wait(0.5)      -- รอเงิน
                        end

                    elseif #left == 0 then
                        status = ("Auto Play: all %d/%d placed"):format(placed, total)
                        task.wait(2)
                    else
                        task.wait(1.5)
                    end
                end
            end
        end
    end)
end

-- ── ตัวเล่นของ Play Pos ────────────────────────────
--
--  หาที่วางในวงเอง ไม่ต้องจิ้มทีละจุด
--
--  จัดเป็นตาราง ไม่ใช่สุ่ม
--  สุ่มแล้วจะได้จุดกระจุกบ้างโหว่บ้าง และวางได้จริงน้อยกว่าที่ควรเป็น
--  ตารางห่างเท่าๆ กันลงได้แน่นกว่าและคาดเดาได้
--
--  เรียงจากใกล้กลางวงออกไป เพราะกลางวงคือจุดที่ใกล้ทางเดินที่สุด
--  ทาวเวอร์ตัวแรกๆ ที่วางได้ควรอยู่ตรงที่ดีที่สุด เผื่อเงินหมดก่อนวางครบ
local function ringSpots(mid, radius)
    mid    = mid or circleCenter()
    radius = radius or posRadius
    if not mid then return {} end

    local out = {}
    local step = posGap
    local n = math.ceil(radius / step)

    for gx = -n, n do
        for gz = -n, n do
            local off = Vector2.new(gx * step, gz * step)
            if off.Magnitude <= radius then
                local probe = mid + Vector3.new(off.X, 0, off.Y)
                --  ยิงลำแสงลงหาพื้นจริง ไม่ใช้ระดับความสูงของจุดกลางวง
                --  พื้นสนามไม่ได้ราบเสมอไป บางแมพมีเนินและที่ยกระดับ
                local hit = placeRay(probe + Vector3.new(0, 60, 0), Vector3.new(0, -1, 0))
                if hit then
                    table.insert(out, { pos = hit.Position, d = off.Magnitude })
                end
            end
        end
    end

    table.sort(out, function(a, b) return a.d < b.d end)
    return out
end

--  จุดนี้ว่างพอจะวางไหม
--
--  เทียบกับทาวเวอร์ที่มีอยู่จริงในสนาม ไม่ใช่แค่ที่เราเพิ่งวางไป
--  เพราะผู้เล่นอาจวางเองไว้ก่อน หรือมีของค้างจากรอบก่อน
local function spotFree(pos, taken)
    for _, p in ipairs(taken) do
        if (p - pos).Magnitude < posGap then return false end
    end

    local f = towersFolder()
    for _, m in ipairs(f and f:GetChildren() or {}) do
        local p = tPos(m)
        if p and (p - pos).Magnitude < posGap then return false end
    end
    return true
end

--  ⚠ ถามชื่อทาวเวอร์ประจำช่องไว้ล่วงหน้าเสมอ
