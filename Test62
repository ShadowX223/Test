--  ลำดับของ GetDescendants ไม่ได้เรียงตามที่ตาเห็น ป้ายแรกที่เจอกลายเป็นเลขเลเวล
--  หรือ "+52 XP" ก็ได้ พอไม่เจอคำว่า TRIUMPH ก็เลยตอบว่าแพ้ทุกครั้ง
--  (ตัวมันเองยังทำงานถูกในหน้าที่เดิมคือ "จบเกมหรือยัง" จึงไม่ไปแตะ)
--
--  ต้องกวาดป้ายทั้งหมดแล้วหาคำที่บอกผลจริงๆ
--  คืน nil เมื่อไม่เจอทั้งสองแบบ จะได้ไม่เดาว่าแพ้
local function matchWon()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    local rw  = gui and gui:FindFirstChild("ReactGameNewRewards")
    local fr  = rw and rw:FindFirstChild("Frame")
    local go  = fr and fr:FindFirstChild("gameOver")
    if not go then return nil end

    for _, d in ipairs(go:GetDescendants()) do
        if d:IsA("TextLabel") and type(d.Text) == "string" and d.Text ~= "" then
            local t = d.Text:upper()
            if t:find("TRIUMPH") or t:find("VICTORY") then return true end
            if t:find("DEFEAT") or t:find("GAME OVER") then return false end
        end
    end
    return nil
end

local function sendWebhook()
    local rewards, why = matchRewards()
    local won = matchWon()

    local lines, anyRare = {}, false
    for _, r in ipairs(rewards or {}) do
        table.insert(lines, r.text)
        if r.rare then anyRare = true end
    end
    --  รายงานผลการอ่านทุกครั้ง ไม่ใช่เฉพาะตอนพัง
    --  ตอนสำเร็จก็ต้องรู้ว่าอ่านได้กี่รายการจากทั้งหมดกี่สถานะ
    --  จะได้เห็นทันทีถ้าวันหนึ่งมันเริ่มอ่านได้ไม่ครบ
    if #lines == 0 then table.insert(lines, "could not read rewards") end

    --  ข้อความที่ส่งเป็นภาษาอังกฤษล้วน ต่างจาก UI ที่แปลตามภาษาผู้เล่น
    --  เพราะห้อง Discord มีคนหลายชาติอ่าน และชื่อของในเกมก็เป็นอังกฤษอยู่แล้ว
    local lv  = playerLevel()
    local who = spoiler(("%s%s"):format(
        lv and ("[%d] "):format(lv) or "", LocalPlayer.Name))

    local result = ("%s - %s\n- Time: %s\n- Reward:\n%s"):format(
        getMapName(),
        won == true and "Victory" or won == false and "Defeat" or "Finished",
        fmtDuration(matchStartAt and (os.clock() - matchStartAt) or 0),
        table.concat(lines, "\n"))

    --  แท็กเฉพาะตอนได้ของดรอป เงินกับ EXP ไม่แท็ก
    local content = (anyRare and webhookUser ~= "")
        and ("<@%s>"):format(webhookUser) or nil


    return postJSON({
        username = "Tower Defense Simulator",
        content  = content,
        embeds   = { {
            title  = "Tower Defense Simulator",
            color  = won == true and 5763719 or won == false and 15548997 or 10070709,
            fields = {
                { name = "Name",   value = who,    inline = false },
                { name = "Result", value = result, inline = false },
            },
            footer    = { text = DISCORD_INVITE },
            timestamp = DateTime.now():ToIsoDate(),
        } },
        allowed_mentions = { parse = {}, users = content and { webhookUser } or {} },
    })
end

