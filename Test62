local waveLabel = nil
local lastWaveText = nil       -- ข้อความดิบบนแถบ เอาไว้ตรวจว่าอ่านถูกไหม

--  เส้นทางตายตัว Frame.wave.value ที่เคยเขียนไว้หาไม่เจอเลยสักครั้ง
--  (log จริงขึ้น raw=nil ทุกบรรทัด) React ซ้อนกล่องลึกกว่านั้นและเปลี่ยนได้ทุกอัปเดต
--  จึงต้องค้นแบบไล่ลูกหลานแทนการเดินตามชื่อทีละชั้น
local function findWaveLabel()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    local top = gui and gui:FindFirstChild("ReactGameTopGameDisplay")
    if not top then return nil end

    --  เส้นทางจริงจากซอร์สของคอมโพเนนต์ Wave: Frame > wave > container > value
    --  ที่ผมเคยเขียนไว้ขาด container ไปหนึ่งชั้น เลยหาไม่เจอสักครั้ง
    local f = top:FindFirstChild("Frame")
    local w = f and f:FindFirstChild("wave")
    local c = w and w:FindFirstChild("container")
    local v = c and c:FindFirstChild("value")
    if v and v:IsA("TextLabel") then return v end

    --  สำรอง 1: ค้นลึก เผื่อเกมขยับชั้นในอัปเดตหน้า
    local box = top:FindFirstChild("wave", true)
    v = box and box:FindFirstChild("value", true)
    if v and v:IsA("TextLabel") then return v end

    --  ทางสำรอง: เกาะป้ายที่เขียนว่า "Wave:" แล้วหยิบตัวเลขในกล่องเดียวกัน
    --  ต้องเกาะป้ายนี้ ไม่ใช่จับรูปแบบ "%d / %d" ลอยๆ เพราะเลือดก็หน้าตาเหมือนกัน
    for _, d in ipairs(top:GetDescendants()) do
        if d:IsA("TextLabel") and (d.Text or ""):lower():find("^wave") then
            local p = d.Parent
            if p then
                for _, s in ipairs(p:GetDescendants()) do
                    if s:IsA("TextLabel") and s ~= d and s.Text:match("%d") then
                        return s
                    end
                end
            end
        end
    end
    return nil
end

local lastWaveNum = nil        -- เลขที่อ่านได้ล่าสุด ใช้ตอนป้ายอ่านไม่ได้ชั่วคราว

local function getWave()
    if not (waveLabel and waveLabel.Parent) then
        waveLabel = findWaveLabel()
    end

    if waveLabel then
        lastWaveText = waveLabel.Text
        local n = tonumber(lastWaveText:match("%d+"))
        if n then
            lastWaveNum = n
            return n
        end
    else
        lastWaveText = nil
    end

    --  ป้ายอ่านเป็นตัวเลขไม่ได้ชั่วคราว ซอร์สของเกมเขียนไว้ว่ามีสามกรณี:
    --    "∞" เมื่อเวฟเป็น -1 หรือเกิน 90000
    --    "--" เมื่อยังไม่รู้จำนวนเวฟ
    --    เวฟซ่อน จะเปลี่ยน value เป็น Frame ที่มี "???" ไม่ใช่ TextLabel ด้วยซ้ำ
    --  คืนค่าล่าสุดที่อ่านได้ ดีกว่าคืน 0 ซึ่งจะทำให้ประตูเวฟเปิดหมดทุกคำสั่ง
    if lastWaveNum then return lastWaveNum end

    local s = gameState()
    local w = s and s:FindFirstChild("Wave")
    return (w and w.Value) or 0
end

--  เวฟสุดท้ายของแมพนี้คือเวฟที่เท่าไหร่
--
--  ป้ายเขียนว่า "19 / 20" ตัวหลังคือจำนวนเวฟทั้งหมด อ่านตรงนั้นได้เลย
--  จำค่าไว้ด้วยเพราะช่วงก่อนเริ่มเกมป้ายเป็น "--" ซึ่งไม่มีเลขให้อ่าน
--  โหมดไม่รู้จบ (∞) จะไม่มีตัวหลัง ก็คืน nil ไป ตัวเรียกต้องรับมือเอง
local lastWaveMax = nil

local function getWaveMax()
    if lastWaveText then
        local mx = tonumber(tostring(lastWaveText):match("/%s*(%d+)"))
        if mx and mx > 0 then lastWaveMax = mx end
    end
    return lastWaveMax
end

local function getHealth()
    local s = gameState()
    local h = s and s:FindFirstChild("Health")
    local c = h and h:FindFirstChild("Current")
    local m = h and h:FindFirstChild("Max")
    return (c and c.Value) or 0, (m and m.Value) or 0
end

--  ตอนนี้อยู่แมพอะไร
--
--  อ่านสองที่ เพราะสองที่นี้มาถึงไม่พร้อมกันตอนแมพเพิ่งโหลด
--    State.Map                     ค่าที่มาโครใช้เก็บตอนอัด
--    workspace:GetAttribute("Map") ตัวที่โมดูล ClientMapController ของเกมใช้เอง
--  อ่านได้อันไหนก่อนก็เอาอันนั้น ดีกว่าคืน "?" แล้วปล่อยให้ด่านผิดหลุดผ่าน
local function getMapName()
    local s = gameState()
    local m = s and s:FindFirstChild("Map")
    local v = m and m.Value
    if type(v) == "string" and v ~= "" then return v end

    local a = workspace:GetAttribute("Map")
    if type(a) == "string" and a ~= "" then return a end

    return "?"
end

local function getDifficulty()
    local s = gameState()
    local d = s and s:FindFirstChild("Difficulty")
    return (d and d.Value) or "?"
end

--  เงินในเกมไม่ได้อยู่ที่ LocalPlayer.Cash — ตรงนั้นอ่านได้ 0 ตลอด
--  ทั้งที่บนจอโชว์ $612 ตัวเลขบน hotbar เป็นที่เดียวที่เชื่อได้ตอนนี้
--  จึงต้องอ่านจากข้อความ ซึ่งเป็นจุดเปราะจุดเดียวของสคริปต์นี้
--  ถ้าเกมแก้ UI ตรงนี้ "รอเงินพอ" จะไม่ทำงาน แต่ส่วนอื่นยังรอด
--  เพราะทุกคำสั่งมีการยืนยันผลหลังส่งอยู่แล้ว
local cashLabel = nil

local function getCash()
    if cashLabel and cashLabel.Parent then
        return tonumber((cashLabel.Text:gsub("[^%d]", "")))
    end
    cashLabel = nil

    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    local hb  = gui and gui:FindFirstChild("ReactUniversalHotbar")
    if not hb then return nil end

    for _, d in ipairs(hb:GetDescendants()) do
        if d:IsA("TextLabel") and d.Name == "amount"
            and d.Parent and d.Parent.Name == "cash" then
            cashLabel = d
            return tonumber((d.Text:gsub("[^%d]", "")))
        end
    end
    return nil
end

--  ราคาของทาวเวอร์ในแต่ละช่อง hotbar
--  ใช้เทียบว่าโหลดเอาต์ตอนนี้เหมือนตอนอัดหรือเปล่า — ถ้าช่อง 2 เคยเป็น
--  Scout ($250) แล้วตอนนี้กลายเป็นของราคาอื่น มาโครจะวางผิดตัวทั้งชุด
local function hotbarCosts()
    local gui    = LocalPlayer:FindFirstChild("PlayerGui")
    local hb     = gui and gui:FindFirstChild("ReactUniversalHotbar")
    local frame  = hb and hb:FindFirstChild("Frame")
    local troops = frame and frame:FindFirstChild("troops")
    if not troops then return nil end

    local out, n = {}, 0
    for _, slot in ipairs(troops:GetChildren()) do
        local idx     = tonumber(slot.Name)
        local content = slot:FindFirstChild("content")
        local cost    = content and content:FindFirstChild("Cost")
        if idx and cost and cost:IsA("TextLabel") then
            out[tostring(idx)] = tonumber((cost.Text:gsub("[^%d]", ""))) or 0
            n = n + 1
        end
    end
    return n > 0 and out or nil
end

--  ราคาปัจจุบันกับคูลดาวน์ของช่อง hotbar หนึ่งช่อง
--
--  ราคาที่อัดไว้กับราคาตอนเล่นไม่จำเป็นต้องเท่ากัน — บัฟส่วนลด, State.PriceScale
--  และโหมดพิเศษทำให้เปลี่ยนได้ ราคาสดจากช่องจึงแม่นกว่าเสมอ
--
--  Timeleft คือคูลดาวน์วางทาวเวอร์ ถ้ายังไม่ถึง 0 ยิงไปก็โดนปฏิเสธแน่นอน
--  อันนี้แหละคือสาเหตุใหญ่ที่ "วางไม่สำเร็จ" — ไม่ใช่เงินไม่พอ
local function slotInfo(slot)
    if not slot then return nil end
    local gui    = LocalPlayer:FindFirstChild("PlayerGui")
    local hb     = gui and gui:FindFirstChild("ReactUniversalHotbar")
    local frame  = hb and hb:FindFirstChild("Frame")
    local troops = frame and frame:FindFirstChild("troops")
    local s      = troops and troops:FindFirstChild(tostring(slot))
    local c      = s and s:FindFirstChild("content")
    if not c then return nil end

    local cost = c:FindFirstChild("Cost")
    local left = c:FindFirstChild("Timeleft")
    return {
        cost     = cost and tonumber((cost.Text:gsub("[^%d]", ""))) or nil,
        cooldown = left and tonumber((left.Text:gsub("[^%d]", ""))) or 0,
    }
end

--  อ่านข้อมูลทาวเวอร์จากโมดูลของเกมเอง
--
--  โครงสร้าง: Content.Tower.<ชื่อ>.Stats  →  .Stats.Default.Defaults
--    Limit      จำนวนสูงสุดที่วางได้
--    Abilities  รายการสกิล { Name, Level, Debounce, Price? }
--                 Level    ต้องอัปเกรดถึงระดับนี้ก่อนถึงจะมีสกิล
--                 Debounce คูลดาวน์ระหว่างการใช้ของทาวเวอร์ตัวเดียวกัน
--                 Price    มี = สกิลที่ต้องจ่ายเงิน (เช่น Support Caravan 2000฿)
--
--  อ่านจากที่นี่ได้ = ไม่ต้องพึ่งมาโคร ไม่ต้องลองผิดลองถูก และไม่ฝังตัวเลขไว้ในโค้ด
local statsCache = {}

local function towerDefaults(kind)
    if kind == nil or kind == "" then return nil end
    if statsCache[kind] ~= nil then return statsCache[kind] or nil end

    local ok, out = pcall(function()
        local content = ReplicatedStorage:FindFirstChild("Content")
        local folder  = content and content:FindFirstChild("Tower")
        local tower   = folder and folder:FindFirstChild(kind)
        local mod     = tower and tower:FindFirstChild("Stats")
        if not (mod and mod:IsA("ModuleScript")) then return nil end

        local def = require(mod)
        if type(def) ~= "table" then return nil end
        local d = def.Stats and def.Stats.Default
        return d and d.Defaults or nil
    end)

    statsCache[kind] = (ok and type(out) == "table") and out or false
    return statsCache[kind] or nil
end

--  ตารางราคาอัปเกรดของทาวเวอร์ชนิดนี้
--
--  โครงสร้างที่ยืนยันแล้วจาก Debug TDS Range Price:
--    Content.Tower.<ชื่อ>.Stats  →  .Stats.Default.Upgrades[n].Cost
--  ช่องที่ n คือราคาของการอัปจาก "ระดับ n-1 ไป n" (ตรวจกับ DJ Booth ครบ 5 ขั้น)
--
--  ทาวเวอร์ที่ติด Golden ใช้คนละตาราง — Scout ธรรมดา 50/375/1350/2200
--  แต่ Scout Golden เป็น 150/600/2400/3600 ต่างกันเกินสามเท่าในบางขั้น
--  ถ้าหยิบผิดตาราง มาโครจะรอเงินผิดยอดทุกครั้งที่อัปตัวนั้น
local upgradeCache = {}

local function upgradeCosts(kind, golden)
    if kind == nil or kind == "" then return nil end
    local key = kind .. (golden and "|G" or "|D")
    if upgradeCache[key] ~= nil then return upgradeCache[key] or nil end

    local ok, out = pcall(function()
        local content = ReplicatedStorage:FindFirstChild("Content")
        local folder  = content and content:FindFirstChild("Tower")
        local tower   = folder and folder:FindFirstChild(kind)
        local mod     = tower and tower:FindFirstChild("Stats")
        if not (mod and mod:IsA("ModuleScript")) then return nil end

        local def = require(mod)
        local all = type(def) == "table" and def.Stats
        if type(all) ~= "table" then return nil end

        --  ไม่มีตาราง Golden ก็ถอยไปใช้ Default ทาวเวอร์ส่วนใหญ่มีตารางเดียว
        local variant = (golden and all.Golden) or all.Default
        local ups = variant and variant.Upgrades
        if type(ups) ~= "table" then return nil end

        --  ⚠ ขั้นที่แยกสายไม่มี .Cost ตรงๆ
        --
        --  จาก Stats ของ Pursuit (ทาวเวอร์แยกสายตัวจริง)
        --      Upgrades[4] = { Title = "...", Cost = 9500 }        ขั้นปกติ
        --      Upgrades[5] = { [1] = {Cost=47500}, [2] = {Cost=13500} }   ขั้นแยกสาย
        --
        --  ของเดิมอ่าน Upgrades[5].Cost ได้ nil แล้วสรุปว่าตันแล้ว
        --  ทั้งมาโครและ Auto Upgrade จึงหยุดอัปที่ขั้นก่อนแยกสายเสมอ
        --  ทาวเวอร์แยกสายไม่มีวันได้ขึ้นขั้นสุดท้ายเลย
        --
        --  ขั้นแยกสายเก็บเป็นตารางย่อย ดัชนีคือหมายเลขสาย ตรงกับ Path ที่ส่งให้เซิร์ฟเวอร์
        local costs = {}
        for i, u in ipairs(ups) do
            if type(u) ~= "table" then
                costs[i] = nil

            elseif u.Cost ~= nil then
                costs[i] = tonumber(u.Cost)

            elseif type(u[1]) == "table" then
                local byPath = {}
                for p, opt in ipairs(u) do
                    byPath[p] = tonumber(type(opt) == "table" and opt.Cost) or nil
                end
                if next(byPath) then costs[i] = byPath end
            end
        end
        return next(costs) and costs or nil
    end)

    upgradeCache[key] = (ok and type(out) == "table") and out or false
    return upgradeCache[key] or nil
end

--  สกิลของชนิดนี้ที่ "ไม่เสียเงิน" เรียงตามระดับที่ต้องการ
--  สกิลที่มี Price คือของที่ต้องจ่าย ไม่ใช่บัฟ วนกดแล้วเผาเงินรอบละหลายพัน
local function freeAbilities(kind)
    local d = towerDefaults(kind)
    local list = d and d.Abilities
    if type(list) ~= "table" then return {} end

    local out = {}
    for _, ab in ipairs(list) do
        if type(ab) == "table" and ab.Name and ab.Price == nil then
            table.insert(out, {
                name  = tostring(ab.Name),
                level = tonumber(ab.Level) or 0,
            })
        end
    end
    table.sort(out, function(x, y) return x.level < y.level end)
    return out
end

--  มีบอสอยู่ในสนามไหม
--
--  ทำแบบเดียวกับ hook useBosses ของเกม: ดู ClientAtoms.enemyReplicators
--  แล้วกรองตัวที่มี Modifiers:Get("Boss") — เป็นแหล่งเดียวกับที่แถบเลือดบอสใช้
--  จึงตรงกับสิ่งที่ผู้เล่นเห็นบนจอเป๊ะ ไม่ใช่การเดาจากชื่อศัตรูหรือเวลา
--
--  ห่อ pcall ทุกชั้นเพราะถ้าเกมอัปเดตแล้วโครงสร้างเปลี่ยน ต้องไม่ลากมาโครล้มไปด้วย
--  แค่ถอยไปใช้การนับวินาทีแทน ซึ่งยังพอใช้ได้
local clientAtoms = nil

--  พิกัดของบอสทุกตัวในสนาม
--
--  ตัวศัตรูแต่ละตัวมีคีย์ .Model ที่เป็นโมเดลจริงในโลก (ยืนยันจาก Debug TDS Range Price)
--  อ่าน GetPivot() ของโมเดลนั้นได้พิกัดที่ตรงกับสิ่งที่ตาเห็น
--  ตารางของศัตรูไม่มีคีย์พิกัดตรงๆ ให้อ่าน ต้องผ่านโมเดลทางเดียว
local function bossPositions()
    if clientAtoms == nil then
        local ok, mod = pcall(function()
            return require(ReplicatedStorage.Shared.Modules.ClientAtoms)
        end)
        clientAtoms = (ok and type(mod) == "table") and mod or false
    end
    if not clientAtoms then return {} end

    local ok, out = pcall(function()
        local atom = clientAtoms.enemyReplicators
        local reps = (type(atom) == "function") and atom() or atom
        if type(reps) ~= "table" then return {} end

        local found = {}
        for _, e in pairs(reps) do
            local mods = type(e) == "table" and e.Modifiers
            if mods and type(mods.Get) == "function" and mods:Get("Boss") then
                local mdl = e.Model
                if typeof(mdl) == "Instance" and mdl.Parent then
                    local okP, p = pcall(function()
                        return mdl:IsA("Model") and mdl:GetPivot().Position or mdl.Position
                    end)
                    if okP and typeof(p) == "Vector3" then
                        table.insert(found, p)
                    end
                end
            end
        end
        return found
    end)
    return (ok and type(out) == "table") and out or {}
end

local function bossOnField()
    if clientAtoms == nil then
        local ok, mod = pcall(function()
            return require(ReplicatedStorage.Shared.Modules.ClientAtoms)
        end)
        clientAtoms = (ok and type(mod) == "table") and mod or false
    end
    if not clientAtoms then return false end

    local ok, found = pcall(function()
        local atom = clientAtoms.enemyReplicators
        local reps = (type(atom) == "function") and atom() or atom
        if type(reps) ~= "table" then return false end

        for _, e in pairs(reps) do
            local mods = type(e) == "table" and e.Modifiers
            if mods and type(mods.Get) == "function" and mods:Get("Boss") then
                return true
            end
        end
        return false
    end)
    return ok and found or false
end

--  เมนูโหวตข้ามเวฟขึ้นหรือยัง
--
--  ซอร์สของคอมโพเนนต์ VoteWave เขียนป้ายนับโหวตไว้ว่า "%d/%d Required"
--  จึงใช้คำนี้เป็นตัวชี้ว่าเมนูโผล่แล้ว ไม่ต้องเดาจากเวลาหรือสถานะอื่น
--
--  จำเป็นเพราะการยิงโหวตตอนเมนูยังไม่ขึ้นคือยิงทิ้งเปล่า เซิร์ฟเวอร์ไม่รับ
--  ซึ่งเป็นสาเหตุที่โหวตของมาโครไม่ติดทั้งที่คำสั่งเหมือนกับตอนกดมือทุกตัวอักษร
--  เช็ค .Visible อย่างเดียวไม่พอ — VoteWave ไม่ได้ซ่อนเมนูด้วยการตั้ง Visible=false
--  แต่ใช้ spring เลื่อนตำแหน่งออกนอกจอ (Position.X เป็น scale 2) แล้วให้กล่องแม่
--  ที่ ClipsDescendants=true ตัดทิ้ง ป้ายจึงมี Visible=true ตลอดเวลา
--  ต้องดูตำแหน่งจริงบนจอเทียบกับขนาดวิวพอร์ตถึงจะรู้ว่าเมนูโผล่จริงหรือยัง
local function onScreen(d)
    local cam = workspace.CurrentCamera
    if not cam then return false end

    local vp   = cam.ViewportSize
    local pos  = d.AbsolutePosition
    local size = d.AbsoluteSize
    if size.X <= 0 or size.Y <= 0 then return false end

    return pos.X + size.X > 0 and pos.X < vp.X
       and pos.Y + size.Y > 0 and pos.Y < vp.Y
end

local function shown(d)
    local node = d
    while node do
        if node:IsA("ScreenGui") then return node.Enabled end
        if node:IsA("GuiObject") and not node.Visible then return false end
        node = node.Parent
    end
    return false
end

--  อ่านป้ายนับโหวต "0/1 Required" คืนเป็น (โหวตแล้ว, ที่ต้องการ)
--  คืน nil ถ้าเมนูไม่ได้อยู่บนจอ
--
--  ตัวเลขนี้คือตัวยืนยันที่ถูกต้องว่าโหวตของเราติดหรือไม่
--  ที่ผมเคยใช้ "เลขเวฟขยับ" นั้นผิด เพราะการข้ามช่วงนับถอยหลังทำให้ศัตรูออกเร็วขึ้น
--  แต่เลขเวฟยังเท่าเดิม จะขึ้นก็ต่อเมื่อเคลียร์เวฟนั้นเสร็จแล้ว
local function voteCount()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return nil end

    --  ดูเฉพาะ ScreenGui ที่ชื่อมีคำว่า vote ไม่กวาดทั้ง PlayerGui
    --  เพราะที่นี่มี ScreenGui เป็นร้อยตัว การกวาดหมดทุกรอบกินแรงเกินจำเป็น
    for _, g in ipairs(gui:GetChildren()) do
        if g:IsA("ScreenGui") and g.Name:lower():find("vote") then
            for _, d in ipairs(g:GetDescendants()) do
                if d:IsA("TextLabel") and (d.Text or ""):find("Required")
                    and shown(d) and onScreen(d) then
                    local now, need = d.Text:match("(%d+)%s*/%s*(%d+)")
                    return tonumber(now) or 0, tonumber(need) or 0
                end
            end
        end
    end
    return nil
end

local function voteMenuOpen()
    return voteCount() ~= nil
end

--  สำรวจเมนูโหวตทุกตัวบนจอ ใช้ตอนสืบหาปัญหาเท่านั้น
--  กวาดทั้ง PlayerGui ซึ่งหนัก จึงเรียกเฉพาะตอนเขียนบันทึก ไม่ได้เรียกทุกเฟรม
local function voteDump()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return "no PlayerGui" end

    local out = {}
    for _, g in ipairs(gui:GetChildren()) do
        if g:IsA("ScreenGui") then
            for _, d in ipairs(g:GetDescendants()) do
                if d:IsA("TextLabel") and (d.Text or ""):find("Required") then
                    --  ป้ายหัวข้อในกล่องเดียวกัน เช่น "Skip Wave?"
                    local title = ""
                    if d.Parent then
                        for _, s in ipairs(d.Parent:GetChildren()) do
                            if s:IsA("TextLabel") and s ~= d and (s.Text or "") ~= "" then
                                title = s.Text
                                break
                            end
                        end
                    end
                    table.insert(out, ("%s = %q | title %q | shown=%s onScreen=%s")
                        :format(d:GetFullName(), d.Text, title,
                                tostring(shown(d)), tostring(onScreen(d))))
                end
            end
        end
    end

    if #out == 0 then return "no Required label found" end
    return table.concat(out, "\n        ")
end

