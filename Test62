--  หากรอบจริงเพื่อดักการแตะ
--
--  ตัวที่ AddViewport คืนมาไม่ได้ให้กรอบมาด้วย จึงต้องไปหาเอง
--  หาจากกล้อง เพราะกล้องตัวนี้เราสร้างเอง ไม่มีทางซ้ำกับของใคร
--  หากรอบแผนที่
--
--  หาสามชั้น ไล่จากแม่นที่สุดไปหาหลวมที่สุด
--  เพราะ Fluent อาจสลับกล้องเป็นตัวของมันเอง แล้ววิธีแรกจะหาไม่เจอ
local function findVpFrame()
    local roots = {}
    if gethui then table.insert(roots, gethui()) end
    table.insert(roots, LocalPlayer:FindFirstChild("PlayerGui"))
    table.insert(roots, game:GetService("CoreGui"))

    --  ⚠ ห้ามมีตัวสำรองแบบ "เอาตัวไหนก็ได้"
    --
    --  ในเกมมี ViewportFrame ตัวอื่นอยู่ด้วย และตัวหนึ่งกินพื้นที่ 1920x951 เกือบเต็มจอ
    --  ตัวสำรองเดิมไปคว้าตัวนั้นมา พิกัดเลยผิดทั้งหมดโดยไม่มีอะไรเตือน
    --  ยอมหาไม่เจอแล้วบอกผู้ใช้ ดีกว่าหาเจอผิดตัวแล้วทำงานเพี้ยนเงียบๆ
    for _, root in ipairs(roots) do
        if root then
            pcall(function()
                for _, d in ipairs(root:GetDescendants()) do
                    if d:IsA("ViewportFrame") then
                        --  ยืนยันตัวตนสองทาง ผ่านทางใดทางหนึ่งถึงจะรับ
                        if d.CurrentCamera == vpCamera then vpFrame = d return end
                        if d:FindFirstChild("ShadowXMapView", true) then vpFrame = d return end
                    end
                end
            end)
            if vpFrame then return vpFrame end
        end
    end

    return nil
end

--  ดักการแตะผ่าน UserInputService ไม่ใช่ผ่านตัวกรอบ
--
--  เดิมผูกกับ vpFrame.InputBegan แล้วไม่เคยยิงเลย
--  เพราะ Fluent มีตัวรับอินพุตของมันเองวางทับอยู่ อินพุตเลยไม่ตกมาถึงกรอบ
--  ดักที่ระดับบนสุดแล้วเช็คเองว่านิ้วลงในกรอบไหม จึงไม่มีใครมาแย่งได้
local lastTap = 0

--  วัดของจริงมาแล้ว เลิกเดา
--
--      input.Position   = (1300, 473)
--      GetMouse()       = (1300, 473)   ← ตรงกัน
--      GetMouseLocation = (1300, 531)   ← มากกว่าอยู่ 58 คือความสูงแถบบน
--      ScreenGui ของ Fluent: IgnoreGuiInset = false
--
--  สรุป: input.Position อยู่ในระบบพิกัดเดียวกับ AbsolutePosition อยู่แล้ว
--  ตอนแรกผมหักแถบบนออก ทั้งที่ไม่ต้องหัก เครื่องหมายกลับด้าน จุดเลยเหลื่อมขึ้นไป
--
--  ที่ต้องบวกคือกรณี IgnoreGuiInset = true เท่านั้น
--  เพราะตอนนั้น AbsolutePosition วัดจากขอบจอจริง แต่ input ยังวัดจากใต้แถบ
--  กรอบนี้ "เห็นอยู่จริง" หรือเปล่า
--
--  เช็ค .Visible ของตัวมันเองอย่างเดียวไม่พอ
--  ตอนย่อหน้าต่างเก็บ Fluent ซ่อนที่กล่องแม่ ไม่ได้ซ่อนที่กรอบ
--  กรอบจึงยังบอกว่า Visible = true ทั้งที่ตาไม่เห็นอะไรเลย
--  ผลคือกดตรงที่หน้าต่างเคยอยู่แล้วจุดยังเพิ่ม ทั้งที่ปิดไปแล้ว
--
--  ต้องไล่ขึ้นไปถึง ScreenGui แล้วดูให้ครบทุกชั้น
local function frameShown()
    if not (vpFrame and vpFrame.Parent) then return false end
    if vpFrame.AbsoluteSize.X <= 0 or vpFrame.AbsoluteSize.Y <= 0 then return false end

    local node, guard = vpFrame, 0
    while node and guard < 30 do
        if node:IsA("ScreenGui") then return node.Enabled end
        if node:IsA("GuiObject") then
            if not node.Visible then return false end
            --  จางจนมองไม่เห็นก็ถือว่าไม่ได้แสดงอยู่
            if node:IsA("Frame") and node.BackgroundTransparency >= 1
                and #node:GetChildren() == 0 then return false end
        end
        node = node.Parent
        guard = guard + 1
    end
    return false
end

local function tapInside(px, py)
    if not frameShown() then return false end

    local pos  = vpFrame.AbsolutePosition
    local size = vpFrame.AbsoluteSize
    if size.X <= 0 or size.Y <= 0 then return false end

    local x, y = px, py

    local node = vpFrame
    while node do
        if node:IsA("ScreenGui") then
            if node.IgnoreGuiInset then
                local inset = game:GetService("GuiService"):GetGuiInset()
                x, y = px + inset.X, py + inset.Y
            end
            break
        end
        node = node.Parent
    end

    local inside = x >= pos.X and x <= pos.X + size.X
               and y >= pos.Y and y <= pos.Y + size.Y
    return inside, x, y
end

task.spawn(function()
    for _ = 1, 60 do
