    local lastCount = -1
    while ALIVE do
        task.wait(2)
        pcall(function()
            local names = routeNames()
            --  รายการว่างทำให้ Fluent สร้างช่องไม่ได้ ข้ามไปเงียบๆ
            --  ตอนอยู่ล็อบบี้เลือกแมพยังไม่มีเลนให้อ่าน เป็นเรื่องปกติ ไม่ใช่ข้อผิดพลาด
            if #names > 0 and #names ~= lastCount then
                lastCount = #names
                RouteDropdown:SetValues(names)
            end
        end)
    end
end)

