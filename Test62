                --
                --  ตัววางหยุดไปตอนชนลิมิต และจะไม่ลองใหม่เองเพราะไม่มีอะไรบอกว่าสถานะเปลี่ยน
                --  ขยับตัวนับรอบก็เท่ากับบอกว่า "ตั้งต้นใหม่" ซึ่งจะไปคิดที่วางใหม่ทั้งชุด
                --  จุดที่มีทาวเวอร์อยู่แล้วจะถูกข้ามเองอยู่แล้วด้วย spotFree
                roundTag = roundTag + 1
