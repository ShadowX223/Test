-- ── โหมดประหยัดเครื่อง ───────────────────────────
--
--  จำของเดิมไว้ทุกชิ้นที่ไปแตะ ปิดสวิตช์แล้วคืนค่าได้จริง ไม่ต้องรีเกม
--  ไม่ลบอะไรทิ้งเลยด้วยเหตุผลเดียวกัน ลบแล้วคืนไม่ได้
local perfSaved   = {}     -- [instance] = { prop = ค่าเดิม }
local perfConn    = nil
local perfLight   = nil

local function perfRemember(inst, prop)
    local ok, cur = pcall(function() return inst[prop] end)
    if not ok then return false end
    perfSaved[inst] = perfSaved[inst] or {}
    if perfSaved[inst][prop] == nil then perfSaved[inst][prop] = cur end
    return true
end

local function perfSet(inst, prop, value)
    if perfRemember(inst, prop) then
        pcall(function() inst[prop] = value end)
    end
end

--  ของหนักเครื่องแบ่งเป็นสองพวก: ตัวที่ปิดได้ด้วย Enabled กับพวกรูปภาพ
local PERF_ENABLED = {
    ParticleEmitter = true, Trail = true, Beam = true, Smoke = true,
    Fire = true, Sparkles = true, Explosion = true, Highlight = true,
}
local PERF_IMAGE = { Decal = true, Texture = true }

local function perfStrip(d)
    local cls = d.ClassName
    if PERF_ENABLED[cls] then
        perfSet(d, "Enabled", false)
    elseif PERF_IMAGE[cls] then
        perfSet(d, "Transparency", 1)
    elseif cls == "MeshPart" or cls == "Part" or cls == "UnionOperation" then
        perfSet(d, "Material", Enum.Material.SmoothPlastic)
        perfSet(d, "CastShadow", false)
        if cls == "MeshPart" then
            perfSet(d, "RenderFidelity", Enum.RenderFidelity.Performance)
        end
    end
end

local function perfApply(on)
    if on then
        --  แสงกับน้ำ สองตัวนี้กินเครื่องมากที่สุดและแตะได้ปลอดภัย
        perfLight = perfLight or game:GetService("Lighting")
        perfSet(perfLight, "GlobalShadows", false)
        perfSet(perfLight, "FogEnd", 1e6)
        perfSet(perfLight, "Brightness", 1)

        local terrain = workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            perfSet(terrain, "WaterWaveSize", 0)
            perfSet(terrain, "WaterWaveSpeed", 0)
            perfSet(terrain, "WaterReflectance", 0)
            perfSet(terrain, "WaterTransparency", 0)
        end

        --  ลดคุณภาพภาพรวมของไคลเอนต์ ถ้า executer ไม่ให้แตะก็ข้ามไป
        pcall(function()
            local s = UserSettings():GetService("UserGameSettings")
            perfSet(s, "SavedQualityLevel", Enum.SavedQualitySetting.QualityLevel1)
        end)

        --  กวาดของที่มีอยู่ตอนนี้ พักเป็นระยะกันเกมค้าง แมพหนึ่งมีเป็นหมื่นชิ้น
        task.spawn(function()
            local n = 0
            for _, d in ipairs(workspace:GetDescendants()) do
                if not OPT.perfMode then return end
                pcall(perfStrip, d)
                n = n + 1
                if n % 400 == 0 then task.wait() end
            end
        end)

        --  ของที่โหลดมาทีหลังต้องโดนด้วย ไม่งั้นเปลี่ยนด่านแล้วกลับมาอืดเหมือนเดิม
        if not perfConn then
            perfConn = workspace.DescendantAdded:Connect(function(d)
                if OPT.perfMode then task.defer(function() pcall(perfStrip, d) end) end
            end)
        end

    else
        if perfConn then perfConn:Disconnect() perfConn = nil end
        for inst, props in pairs(perfSaved) do
            for prop, val in pairs(props) do
                pcall(function() inst[prop] = val end)
            end
        end
        perfSaved = {}
    end
end

