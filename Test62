--  หยิบฟังก์ชันพิเศษของ executer
--
--  ⚠ ห้ามใช้ rawget(getfenv(), ชื่อ) เด็ดขาด
--
--  rawget ข้าม __index ทิ้ง แต่ฟังก์ชันของ executer เกือบทั้งหมด "สืบทอด" มา
--  ไม่ได้วางเป็นคีย์ตรงๆ ใน environment ของสคริปต์ ผลคือ rawget คืน nil เสมอ
--  ทั้งที่ executer มีฟังก์ชันนั้นอยู่จริง
--
--  นี่คือสาเหตุที่ก่อนหน้านี้ขึ้นว่า "executer ไม่มี fireproximityprompt"
--  และที่ Webhook เงียบสนิท — มันหาตัวส่ง HTTP ไม่เจอทั้งที่มี
--  อ่านแบบตัวแปร global ธรรมดาผ่าน pcall ก็พอ ไม่เจอจริงๆ ค่อยคืน nil
local function execGlobal(name)
    local ok, v = pcall(function()
        local g = (rawget(getfenv(), "getgenv") or getgenv)
        if g then
            local e = g()
            if e and e[name] ~= nil then return e[name] end
        end
        return getfenv()[name]
    end)
    if ok and v ~= nil then return v end

    ok, v = pcall(function() return _G[name] end)
    return (ok and v ~= nil) and v or nil
end

